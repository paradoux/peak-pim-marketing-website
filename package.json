{
  "name": "peak-pim-marketing-website",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "astro dev",
    "generate:og-images": "node scripts/generate-og-images.mjs",
    "build": "node scripts/i18n-status.mjs --check && rm -rf dist && astro build",
    "check:crawlers": "node tests/crawler-contract.mjs",
    "check:design-system": "node tests/design-system-contract.mjs",
    "check:i18n": "node scripts/i18n-status.mjs --check && node tests/i18n-contract.mjs",
    "deploy": "npm run build && wrangler pages deploy dist --project-name peak-pim-marketing-website",
    "preview": "astro preview",
    "test:visual": "playwright test tests/visual",
    "i18n:sync": "node scripts/i18n-status.mjs --sync",
    "i18n:translate": "node scripts/generate-fr-translations.mjs",
    "i18n:translate-fr": "node scripts/generate-fr-translations.mjs --locale fr",
    "astro": "astro"
  },
  "dependencies": {
    "astro": "^7.0.5",
    "parse5": "^8.0.1"
  },
  "devDependencies": {
    "@playwright/test": "^1.61.1",
    "wrangler": "^4.106.0"
  }
}
