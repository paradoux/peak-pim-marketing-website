---
import LandingPageLayout from "../../../src/layouts/LandingPageLayout.astro";
import OnePagerHeader from "../../../src/components/OnePagerHeader.astro";
import PartnerBrand from "../../../src/components/ui/PartnerBrand.astro";
import PeakIcon from "../../../src/components/ui/PeakIcon.astro";
import Hero from "../../../src/components/sections/Hero.astro";
import ProblemGrid from "../../../src/components/sections/ProblemGrid.astro";
import CardGrid from "../../../src/components/sections/CardGrid.astro";
import FeatureSteps from "../../../src/components/sections/FeatureSteps.astro";
import FeatureGrid from "../../../src/components/sections/FeatureGrid.astro";
import PartnerContact from "../../../src/components/sections/PartnerContact.astro";
import ProductsVariantsHeroVisual from "../../../src/components/visuals/ProductsVariantsHeroVisual.astro";
import ProductsVariantsCardVisual from "../../../src/components/visuals/ProductsVariantsCardVisual.astro";
import AiAssistantCardVisual from "../../../src/components/visuals/AiAssistantCardVisual.astro";
import { assets } from "../../../src/data/assets";
import { ctaLabels } from "../../../src/data/cta-copy";
import type { PartnerBrief } from "../data/partners";

type Props = { brief: PartnerBrief };
const { brief } = Astro.props;
const sections = [
  { label: "Problem", href: "#problem" },
  { label: "Solution", href: "#solution" },
  { label: "Implementation", href: "#implementation" },
  { label: "Partnership", href: "#partnership" },
  { label: "Contact", href: "#contact" },
];
---

<LandingPageLayout
  title={`${brief.slug ? `Peak PIM × ${brief.name}` : "Peak PIM for Shopify Agencies"} | Agency partnership`}
  description={brief.description}
  canonicalPath={brief.slug ? `/${brief.slug}` : "/"}
  partnerPage noindex
  ogImage={assets.marketing.featureOg["/shopify-product-management"]}
>
  <OnePagerHeader slot="header" links={sections} />
  <Fragment slot="footer" />
  <Hero
    id="hero" layout="split" title={brief.title} description={brief.description}
    primaryCta={{ label: ctaLabels.talkToUs, href: "#contact" }}
    secondaryCta={{ label: ctaLabels.seeHowItWorks, href: "#implementation" }}
    trustLine="Agency partnership · Built around your client projects"
  >
    <PartnerBrand slot="brand" name={brief.name} logo={brief.logo} />
    <div inert><ProductsVariantsHeroVisual /></div>
  </Hero>

  <ProblemGrid
    id="problem" tagline="The problem"
    title="A great storefront needs a catalog that keeps up"
    description="Your client’s launch is only the beginning. The product work behind it often stays scattered, repetitive, and hard to hand over."
    items={[
      { icon: "file", title: "Product data everywhere", description: "Descriptions in spreadsheets, images in folders, details in Shopify. Teams spend their time finding information before they can improve it." },
      { icon: "store", title: "The same update, again", description: "Regional stores, B2B and B2C catalogs, and new collections multiply the edits. A simple change becomes another round of copying and checking." },
      { icon: "clock", title: "Too much work after launch", description: "Missing content, inconsistent fields, and unclear workflows turn everyday catalog updates into another request for the agency." },
    ]}
  />

  <CardGrid id="solution" tagline="The solution: Peak PIM"
    title="One Shopify-native workspace for the whole catalog"
    description="Give your clients a dedicated place to manage, enrich, and publish product information. Shopify stays their commerce platform; Peak becomes their catalog workspace."
    cards={[
      { tagline: "Centralize", title: "One catalog. Every store.", description: "Manage products, variants, collections, media, metafields, and metaobjects together. Share information across stores while keeping the differences each store needs." },
      { tagline: "Enrich", title: "Better content, less repetition", description: "Bulk edit product data, manage translations, and use AI to prepare content changes. Review the drafts before they reach the storefront." },
      { tagline: "Publish", title: "Control what goes live", description: "Prepare and review changes in Peak, then publish them to the right Shopify stores. Give the merchant a repeatable workflow they can own." },
    ]}
  >
    <div slot="visual-1" class="max-width-full" inert><ProductsVariantsCardVisual mode="canonical" /></div>
    <div slot="visual-2" class="max-width-full" inert><AiAssistantCardVisual mode="approval" /></div>
    <div slot="visual-3" class="max-width-full" inert><ProductsVariantsCardVisual mode="publish" /></div>
  </CardGrid>

  <FeatureSteps id="implementation" tagline="How you implement Peak"
    title="A practical setup you can deliver to your client"
    description="Peak is intuitive to use. Your agency adds value by getting the catalog, the workflow, and the team ready for everyday operations."
    steps={[
      { title: "01. Scope the catalog", description: "Review the client’s stores, product data, languages, and existing tools. Agree what needs cleaning up, who owns each field, and what a successful handover looks like." },
      { title: "02. Connect and configure", description: "Connect Shopify, organize the product information, and set up the relevant fields, store differences, and team permissions. Bring us in to scope any custom integration." },
      { title: "03. Validate and hand over", description: "Review a representative set of products, test the publishing workflow, and train the client’s team. Deliver a setup they can run confidently after launch." },
    ]}
  >
    <PeakIcon slot="visual-1" name="search" />
    <PeakIcon slot="visual-2" name="grid" />
    <PeakIcon slot="visual-3" name="review" />
  </FeatureSteps>

  <FeatureGrid id="partnership" tagline="What we offer your agency"
    title="A partnership that grows with your client work"
    description="Recurring revenue, valuable implementation work, and visibility for your agency. Plus a direct line to Théau and the Peak team for client questions, project scoping, and product feedback."
    features={[
      { icon: "clock", title: "Revenue share on monthly plans", description: "Earn a share of the monthly Peak PIM plan on deals you bring in. The percentage depends on the deal and is agreed together." },
      { icon: "review", title: "A best-in-class tool for your clients", description: "Offer a PIM built for Shopify: structured product data, bulk editing, AI-assisted enrichment, and publishing across stores in one workspace." },
      { icon: "grid", title: "A setup service you can invoice", description: "Peak is intuitive. You don’t need to be a specialist PIM agency to offer a paid setup. Charge for the catalog preparation, configuration, training, and handover you deliver to your client." },
      { icon: "publish", title: "Visibility as an implementation partner", description: "We can feature your agency on our partners page and show merchants that your team can implement Peak PIM. Agree the listing and positioning with us as part of the partnership." },
    ]}
    cta={{ label: ctaLabels.talkToUs, href: "#contact" }}
  />
  <PartnerContact />
</LandingPageLayout>
