---
type Props = {
  ariaLabel: string;
  section: string;
  status?: string;
  actionLabel?: string;
};

const { ariaLabel, section, status, actionLabel } = Astro.props;
---

<div class="w-embed peak-product-visual-embed">
  <div class="peak-product-window" role="img" aria-label={ariaLabel}>
    <div class="peak-product-window__topbar">
      <span class="peak-product-window__brand"><i aria-hidden="true"></i><strong>Peak</strong></span>
      <span class="peak-product-window__section">{section}</span>
      <span class="peak-product-window__spacer"></span>
      {status && <span class="peak-product-window__status">{status}</span>}
      {actionLabel && <span class="peak-product-window__action">{actionLabel}</span>}
    </div>
    <div class="peak-product-window__body"><slot /></div>
  </div>
</div>

<style is:global>
  .peak-product-visual-embed {
    width: 100%;
  }

  .peak-product-window {
    width: 100%;
    overflow: hidden;
    border: 1px solid #dadada;
    border-radius: 12px;
    background: #fff;
    box-shadow: 0 24px 60px rgba(0, 0, 0, 0.1);
    color: #191919;
    font-family: Inter, Arial, sans-serif;
    text-align: left;
  }

  .peak-product-window__topbar {
    display: flex;
    min-height: 54px;
    align-items: center;
    gap: 16px;
    padding: 0 18px;
    background: #191919;
    color: #aaa;
    font-size: 11px;
  }

  .peak-product-window__brand {
    display: inline-flex;
    align-items: center;
    gap: 7px;
    color: #fff;
  }

  .peak-product-window__brand i {
    position: relative;
    display: block;
    width: 18px;
    height: 18px;
    border-radius: 3px;
    background: #fff;
  }

  .peak-product-window__brand i::before,
  .peak-product-window__brand i::after {
    position: absolute;
    content: "";
    width: 0;
    height: 0;
    border-style: solid;
  }

  .peak-product-window__brand i::before {
    top: 4px;
    left: 4px;
    border-width: 0 5px 9px;
    border-color: transparent transparent #191919;
    transform: rotate(10deg);
  }

  .peak-product-window__brand i::after {
    right: 3px;
    bottom: 3px;
    border-width: 0 3px 6px;
    border-color: transparent transparent #777;
    transform: rotate(-15deg);
  }

  .peak-product-window__brand strong {
    font-size: 12px;
  }

  .peak-product-window__spacer {
    flex: 1;
  }

  .peak-product-window__status {
    color: #8ed1a2;
    font-size: 9px;
  }

  .peak-product-window__status::before {
    display: inline-block;
    width: 6px;
    height: 6px;
    margin-right: 5px;
    border-radius: 50%;
    background: #53a86d;
    content: "";
  }

  .peak-product-window__action {
    padding: 8px 11px;
    border-radius: 5px;
    background: #2845d6;
    color: #fff;
    font-size: 9px;
    font-weight: 700;
  }

  .peak-product-window__body {
    min-height: 0;
  }

  @media (max-width: 767px) {
    .peak-product-window__topbar {
      min-height: 48px;
      gap: 10px;
      padding: 0 13px;
    }

    .peak-product-window__section,
    .peak-product-window__status {
      display: none;
    }
  }
</style>
