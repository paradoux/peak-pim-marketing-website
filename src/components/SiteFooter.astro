---
import { comparisonNavigationLinks, exploreNavigationLinks, featureNavigationGroups } from "../data/site-navigation";
import { ctaExceptions } from "../data/cta-copy";
import { getSharedFooterHtml } from "../lib/page-source";
import { getLocaleAlternates, localeMetadata, localizeInternalHref, publicPath, type Locale } from "../i18n/config";
import { localizeSharedMarkup, translateSharedCopy } from "../i18n/shared-copy";

type Props = { locale?: Locale; currentPath?: string };
const { locale = "en", currentPath = Astro.url.pathname } = Astro.props;
const tr = (value: string) => translateSharedCopy(locale, value);
const localizedHref = (href: string) => localizeInternalHref(href, locale);

function escapeHtml(value: string) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

function extractDivElement(html: string, startIndex: number) {
  if (startIndex < 0 || !html.startsWith("<div", startIndex)) return "";

  const tagPattern = /<div\b[^>]*>|<\/div>/g;
  tagPattern.lastIndex = startIndex;
  let depth = 0;
  let match: RegExpExecArray | null;

  while ((match = tagPattern.exec(html))) {
    depth += match[0].startsWith("</") ? -1 : 1;
    if (depth === 0) return html.slice(startIndex, tagPattern.lastIndex);
  }

  return "";
}

const originalFooterHtml = getSharedFooterHtml()
  .replace(
    '<a href="#" target="_blank" class="footer1_link">Help Center</a>',
    '<a href="https://help.peak-pim.com/en/" target="_blank" rel="noopener" class="footer1_link">Help Center</a>',
  )
  .replace(
    '<a href="/pricing" class="footer1_link">Pricing</a>',
    '<a href="/pricing/" class="footer1_link">Pricing</a>',
  );
const menuStart = originalFooterHtml.indexOf('<div class="w-layout-grid footer1_menu-wrapper">');
const featureColumnStart = originalFooterHtml.indexOf('<div class="footer1_link-column">', menuStart);
const peakHeading = '<div class="text-weight-semibold">⛰️ Peak</div>';
const compareHeading = '<div class="text-weight-semibold">🔍 Compare</div>';
const connectHeading = '<div class="text-weight-semibold">🤙 Connect</div>';
const peakHeadingIndex = originalFooterHtml.indexOf(peakHeading, featureColumnStart);
const peakColumnStart = originalFooterHtml.lastIndexOf('<div class="footer1_link-column">', peakHeadingIndex);
const compareHeadingIndex = originalFooterHtml.indexOf(compareHeading, peakColumnStart);
const compareColumnStart = originalFooterHtml.lastIndexOf('<div class="footer1_link-column">', compareHeadingIndex);
const connectHeadingIndex = originalFooterHtml.indexOf(connectHeading, compareColumnStart);
const connectColumnStart = originalFooterHtml.lastIndexOf('<div class="footer1_link-column">', connectHeadingIndex);

if (
  menuStart === -1 ||
  featureColumnStart === -1 ||
  peakHeadingIndex === -1 ||
  peakColumnStart === -1 ||
  compareHeadingIndex === -1 ||
  compareColumnStart === -1 ||
  connectHeadingIndex === -1 ||
  connectColumnStart === -1
) {
  throw new Error("The original footer columns could not be restored.");
}

const featureColumnHtml = `
  <div class="footer1_link-column site-footer__features-column">
    <div class="margin-bottom margin-small"><div class="text-weight-semibold site-footer__column-heading"><span class="site-footer__heading-marker" aria-hidden="true"></span>${escapeHtml(tr("Features"))}</div></div>
    <div class="site-footer__feature-categories">
      ${featureNavigationGroups.filter((group) => group.label !== "Solutions").map((group) => `
        <div class="site-footer__feature-category${group.label === "Operate" ? " is-dense" : ""}">
          <div class="site-footer__feature-category-title">${escapeHtml(tr(group.label))}</div>
          <div class="footer1_link-list">
            ${group.links.map((link) => link.comingSoon
              ? `<span class="footer1_link site-footer__coming-soon" aria-disabled="true"><span>${escapeHtml(tr(link.label))}</span><span class="feature-status-badge">${escapeHtml(tr("Coming soon"))}</span></span>`
              : link.badge
                ? `<a href="${escapeHtml(localizedHref(link.href))}" class="footer1_link site-footer__feature-link"><span>${escapeHtml(tr(link.label))}</span><span class="feature-status-badge">${escapeHtml(tr(link.badge))}</span></a>`
                : `<a href="${escapeHtml(localizedHref(link.href))}" class="footer1_link"><span>${escapeHtml(tr(link.label))}</span></a>`
            ).join("")}
          </div>
        </div>
      `).join("")}
    </div>
  </div>`;

const headingMarker = '<span class="site-footer__heading-marker" aria-hidden="true"></span>';
const solutionsGroup = featureNavigationGroups.find((group) => group.label === "Solutions");
const buildVsBuyLink = comparisonNavigationLinks.find((link) => link.href === "/build-vs-buy-pim/");
const reviewsLink = exploreNavigationLinks.find((link) => link.href === "https://apps.shopify.com/peak-pim/reviews");
const maeliUseCaseLink = exploreNavigationLinks.find((link) => link.href === "/customers/maeli-paris/");
const liveDemoLink = exploreNavigationLinks.find((link) => link.href === "https://app.peak-pim.com/demo");
const helpCenterLink = exploreNavigationLinks.find((link) => link.href === "https://help.peak-pim.com/en/");
const productUpdatesLink = exploreNavigationLinks.find((link) => link.href === "https://www.linkedin.com/company/peak-pim/posts/");
const apiDocumentationLink = exploreNavigationLinks.find((link) => link.href === "https://developers.peak-pim.com/");
const originalConnectColumnHtml = extractDivElement(originalFooterHtml, connectColumnStart);
const socialListStart = originalConnectColumnHtml.indexOf('<div class="footer1_link-list">');
const originalSocialListHtml = extractDivElement(originalConnectColumnHtml, socialListStart);
const leftWrapperStart = originalFooterHtml.indexOf('<div class="footer1_left-wrapper">');
const originalLeftWrapperHtml = extractDivElement(originalFooterHtml, leftWrapperStart);

if (
  !solutionsGroup ||
  !buildVsBuyLink ||
  !reviewsLink ||
  !maeliUseCaseLink ||
  !liveDemoLink ||
  !helpCenterLink ||
  !productUpdatesLink ||
  !apiDocumentationLink ||
  !originalConnectColumnHtml ||
  !originalSocialListHtml ||
  !originalLeftWrapperHtml
) {
  throw new Error("The footer is missing a required shared-navigation group or link.");
}

const socialListHtml = originalSocialListHtml
  .replace('class="footer1_link-list"', 'class="footer1_link-list site-footer__social-links site-footer__bottom-social-links"')
  .replaceAll('target="_blank"', 'target="_blank" rel="noopener"');
const logoCtaHtml = `<div class="site-footer__logo-cta"><a href="${escapeHtml(liveDemoLink.href)}" target="_blank" rel="noopener" class="button is-secondary w-button">${escapeHtml(tr(ctaExceptions.liveDemo))}</a></div>`;
const localeAlternates = getLocaleAlternates(currentPath);
const languageMenuLabel = localeMetadata[locale].languageMenuLabel;
const languageSwitcherHtml = localeAlternates.length > 1 ? `
  <details class="site-footer-language" data-i18n-skip>
    <summary class="site-footer-language__trigger" aria-label="${languageMenuLabel}">
      <span aria-hidden="true">${localeMetadata[locale].flag}</span>
      <span>${localeMetadata[locale].label}</span>
      <svg class="site-footer-language__chevron" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 6 5 5 5-5" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"/></svg>
    </summary>
    <div class="site-footer-language__menu" aria-label="${languageMenuLabel}">
      ${localeAlternates.map((alternate) => {
        const optionLocale = alternate.locale;
        const optionContent = `<span aria-hidden="true">${localeMetadata[optionLocale].flag}</span><span>${localeMetadata[optionLocale].label}</span>${optionLocale === locale ? '<svg class="site-footer-language__check" viewBox="0 0 16 16" aria-hidden="true"><path d="m3 8 3 3 7-7" fill="none" stroke="currentColor" stroke-linecap="round" stroke-linejoin="round" stroke-width="1.75"/></svg>' : ""}`;
        return optionLocale === locale
          ? `<span class="site-footer-language__option is-active" aria-current="page">${optionContent}</span>`
          : `<a class="site-footer-language__option" href="${publicPath(alternate.path)}" hreflang="${alternate.hreflang}" lang="${alternate.hreflang}">${optionContent}</a>`;
      }).join("")}
    </div>
  </details>` : "";
const leftWrapperHtml = originalLeftWrapperHtml.slice(0, -6) + logoCtaHtml + "</div>";
const footerPrefixHtml = originalFooterHtml
  .slice(0, featureColumnStart)
  .replace(originalLeftWrapperHtml, leftWrapperHtml);
const originalFooterSuffixHtml = originalFooterHtml.slice(connectColumnStart + originalConnectColumnHtml.length);
const footerSuffixHtml = originalFooterSuffixHtml.replace(
  '<div class="footer1_credit-text">© 2026 Peak PIM. All rights reserved.</div><div class="w-layout-grid footer1_legal-list">',
  `<div class="footer1_credit-text">© 2026 Peak PIM. All rights reserved.</div>${socialListHtml}${languageSwitcherHtml}<div class="w-layout-grid footer1_legal-list">`,
);

if (footerSuffixHtml === originalFooterSuffixHtml) {
  throw new Error("The social links could not be moved into the footer bottom bar.");
}

const solutionsColumnHtml = `
  <div class="footer1_link-column site-footer__solutions-column">
    <div class="margin-bottom margin-xsmall"><div class="text-weight-semibold site-footer__column-heading">${headingMarker}${escapeHtml(tr("Solutions"))}</div></div>
    <div class="footer1_link-list">
      ${solutionsGroup.links.map((link) => `<a href="${escapeHtml(localizedHref(link.href))}" class="footer1_link">${escapeHtml(tr(link.label))}</a>`).join("")}
    </div>
  </div>`;
const peakColumnHtml = originalFooterHtml
  .slice(peakColumnStart, compareColumnStart)
  .replace('<div class="footer1_link-column">', '<div class="footer1_link-column site-footer__peak-column">')
  .replace(peakHeading, `<div class="text-weight-semibold site-footer__column-heading">${headingMarker}Peak</div>`)
  .replace(
    '<a href="/pricing/" class="footer1_link">Pricing</a>',
    `<a href="/pricing/" class="footer1_link">Pricing</a><a href="${escapeHtml(reviewsLink.href)}" target="_blank" rel="noopener" class="footer1_link">${escapeHtml(reviewsLink.label)}</a><a href="${escapeHtml(maeliUseCaseLink.href)}" class="footer1_link">${escapeHtml(maeliUseCaseLink.label)}</a>`,
  )
  .replace('<a href="https://help.peak-pim.com/en/" target="_blank" rel="noopener" class="footer1_link">Help Center</a>', "")
  .replace('<a href="https://www.linkedin.com/company/peak-pim/posts/" target="_blank" class="footer1_link">Product Updates</a>', "");
const compareColumnHtml = originalFooterHtml
  .slice(compareColumnStart, connectColumnStart)
  .replace(compareHeading, `<div class="text-weight-semibold site-footer__column-heading">${headingMarker}Compare</div>`)
  .replace(
    '<a href="/shopify-pim-alternatives" class="footer1_link">PIM alternatives</a>',
    `<a href="/shopify-pim-alternatives" class="footer1_link">PIM alternatives</a><a href="${escapeHtml(buildVsBuyLink.href)}" class="footer1_link">${escapeHtml(buildVsBuyLink.label)}</a>`,
  );
const resourcesColumnHtml = `
  <div class="footer1_link-column site-footer__resources-column">
    <div class="margin-bottom margin-xsmall"><div class="text-weight-semibold site-footer__column-heading">${headingMarker}Resources</div></div>
    <div class="footer1_link-list">
      <a href="${escapeHtml(liveDemoLink.href)}" target="_blank" rel="noopener" class="footer1_link">${escapeHtml(liveDemoLink.label)}</a>
      <a href="${escapeHtml(helpCenterLink.href)}" target="_blank" rel="noopener" class="footer1_link">${escapeHtml(helpCenterLink.label)}</a>
      <a href="${escapeHtml(productUpdatesLink.href)}" target="_blank" rel="noopener" class="footer1_link">${escapeHtml(productUpdatesLink.label)}</a>
      <a href="${escapeHtml(apiDocumentationLink.href)}" target="_blank" rel="noopener" class="footer1_link">${escapeHtml(apiDocumentationLink.label)}</a>
    </div>
  </div>`;
const footerHtml = footerPrefixHtml
  + featureColumnHtml
  + solutionsColumnHtml
  + compareColumnHtml
  + peakColumnHtml
  + resourcesColumnHtml
  + footerSuffixHtml;
const localizedFooterHtml = localizeSharedMarkup(locale, footerHtml)
  .replaceAll('href="/shopify-pim-translations"', `href="${localizedHref("/shopify-pim-translations")}"`);
---

<div class="site-footer" set:html={localizedFooterHtml} />
