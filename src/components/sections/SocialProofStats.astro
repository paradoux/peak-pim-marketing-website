---
import { getSharedLogoCaseStudy } from "../../lib/page-source";

type Stat = {
  value: string;
  label: string;
  context?: string;
};

type Logo = {
  src: string;
  alt: string;
  href: string;
};

type Props = {
  tagline?: string;
  title: string;
  stats: Stat[];
  logos: Logo[];
};

const { tagline, title, stats, logos } = Astro.props;
---

<section class="section_stats26 peak-social-proof-stats color-scheme-1">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="peak-social-proof-stats__component">
          <div class="peak-social-proof-stats__summary">
            <div>
              {tagline && <div class="margin-bottom margin-xsmall"><div class="text-style-tagline">{tagline}</div></div>}
              <h2 class="heading-style-h4">{title}</h2>
            </div>
            <div class="peak-social-proof-stats__numbers">
              {stats.map((stat) => (
                <article class="peak-social-proof-stats__stat">
                  <div class="peak-social-proof-stats__value">{stat.value}</div>
                  <h3 class="text-size-small-2">{stat.label}</h3>
                  {stat.context && <p class="text-size-small-2">{stat.context}</p>}
                </article>
              ))}
            </div>
          </div>

          <div class="peak-social-proof-stats__logos" aria-label="Selected Peak PIM customers">
            {logos.map((logo) => {
              const caseStudy = getSharedLogoCaseStudy(logo.href);
              const external = !logo.href.startsWith("/");
              return (
                <div class:list={["peak-social-proof-stats__logo-wrapper", "logo2_wrapper", { "logo2_wrapper--case-study": caseStudy }]}>
                  <a
                    href={logo.href}
                    target={external ? "_blank" : undefined}
                    rel={external ? "nofollow noopener" : undefined}
                    aria-label={caseStudy ? `Read ${logo.alt} case study` : `Visit ${logo.alt} website`}
                    class:list={["peak-social-proof-stats__logo-link", { "logo2_link--case-study": caseStudy }]}
                  >
                    <img src={logo.src} alt={logo.alt} loading="lazy" class:list={["peak-social-proof-stats__logo", caseStudy && `logo2_logo--${caseStudy.slug}`]} />
                    {caseStudy && <span class="logo2_case-study-badge">Case study</span>}
                  </a>
                  {caseStudy && <Fragment set:html={caseStudy.html} />}
                </div>
              );
            })}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .peak-social-proof-stats__summary {
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 2.1fr);
    gap: clamp(2rem, 5vw, 4rem);
    align-items: center;
  }

  .peak-social-proof-stats__numbers {
    display: grid;
    grid-template-columns: repeat(3, minmax(0, 1fr));
    gap: clamp(1rem, 3vw, 2.5rem);
  }

  .peak-social-proof-stats__stat {
    min-width: 0;
  }

  .peak-social-proof-stats__value {
    margin-bottom: 0.55rem;
    color: var(--color-ink);
    font-family: var(--font-family--heading, "Space Grotesk", sans-serif);
    font-size: clamp(2rem, 3vw, 2.75rem);
    font-weight: 500;
    letter-spacing: -0.055em;
    line-height: 1.1;
  }

  .peak-social-proof-stats__stat h3 {
    margin: 0;
    color: var(--color-muted);
    font-weight: 400;
  }

  .peak-social-proof-stats__stat p {
    margin-top: 0.4rem;
    color: var(--color-muted);
  }

  .peak-social-proof-stats__logos {
    display: grid;
    grid-template-columns: repeat(6, minmax(0, 1fr));
    gap: clamp(1rem, 2vw, 2rem);
    align-items: center;
    margin-top: clamp(2rem, 4vw, 3rem);
    padding-top: clamp(1.5rem, 3vw, 2rem);
    border-top: 1px solid var(--border-color--border-primary, #d8d4cc);
  }

  .peak-social-proof-stats__logo-wrapper {
    position: relative;
    min-width: 0;
  }

  .peak-social-proof-stats__logo-link {
    display: flex;
    min-width: 0;
    height: 4rem;
    align-items: center;
    justify-content: center;
    border-radius: 0.75rem;
    transition: transform 180ms ease;
  }

  .peak-social-proof-stats__logo-link:hover,
  .peak-social-proof-stats__logo-link:focus-visible {
    transform: translateY(-2px);
  }

  .peak-social-proof-stats__logo-link:focus-visible {
    outline: 2px solid var(--color-brand-blue);
    outline-offset: 3px;
  }

  .peak-social-proof-stats__logo {
    display: block;
    width: 100%;
    max-width: 8.5rem;
    height: 2.35rem;
    object-fit: contain;
  }

  @media (max-width: 991px) {
    .peak-social-proof-stats__summary {
      grid-template-columns: 1fr;
    }

    .peak-social-proof-stats__logos {
      grid-template-columns: repeat(3, minmax(0, 1fr));
      row-gap: 1.5rem;
    }

    .peak-social-proof-stats :global(.logo2_wrapper:has(.logo2_logo--du-bruit) .logo2_case-study-card) {
      left: 0;
      right: auto;
      transform: translateY(0.45rem);
    }

    .peak-social-proof-stats :global(.logo2_wrapper:has(.logo2_logo--du-bruit):hover .logo2_case-study-card),
    .peak-social-proof-stats :global(.logo2_wrapper:has(.logo2_logo--du-bruit):focus-within .logo2_case-study-card) {
      transform: translateY(0);
    }
  }

  @media (max-width: 767px) {
    .peak-social-proof-stats__numbers {
      grid-template-columns: 0.75fr 0.9fr 1.35fr;
      gap: 0.75rem;
    }

    .peak-social-proof-stats__value {
      font-size: clamp(1.5rem, 5.5vw, 2rem);
    }

    .peak-social-proof-stats__logos {
      grid-template-columns: repeat(2, minmax(0, 1fr));
      gap: 1rem;
    }

    .peak-social-proof-stats__logo {
      max-width: 7.25rem;
      height: 2.1rem;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .peak-social-proof-stats__logo-link {
      transition: none;
      transform: none;
    }
  }
</style>
