---
import { googleBookingUrl, googleBookingEmbedUrl } from "../../data/cta-copy";
import { assets } from "../../data/assets";
import PeakIcon from "../ui/PeakIcon.astro";
import { defaultLocale, localeMetadata } from "../../i18n/config";

type Props = { modal?: boolean };
const { modal = false } = Astro.props;
const Heading = modal ? "h2" : "h1";
const DetailHeading = modal ? "h3" : "h2";
const locale = Astro.locals.locale ?? defaultLocale;
const calendarUrl = `${googleBookingEmbedUrl}&hl=${localeMetadata[locale].hreflang}`;
---

<div class="peak-demo-booking" data-demo-booking-page={!modal ? "" : undefined}>
  <div class="peak-demo-booking__intro">
    <div class="peak-demo-booking__heading margin-bottom margin-small"><Heading id={modal ? "demo-booking-title" : "demo-page-title"} class="heading-style-h3">See Peak with your own data</Heading></div>
    <div class="peak-demo-booking__host margin-bottom margin-small">
      <img class="peak-demo-booking__portrait" src={assets.team.theau} alt="Théau, co-founder of Peak" width="48" height="48" />
      <p class="text-style-tagline">Book a demo with Théau, co-founder</p>
    </div>
    <div class="peak-demo-booking__details">
      <div>
        <DetailHeading class="text-size-regular text-weight-semibold"><PeakIcon name="grid" wrapperClass="peak-demo-booking__icon" />Your data, if you want</DetailHeading>
        <p>Explore with your own Shopify catalog, or use our demo data. It's your choice.</p>
      </div>
      <div>
        <DetailHeading class="text-size-regular text-weight-semibold"><PeakIcon name="edit" wrapperClass="peak-demo-booking__icon" />Real product. No slides.</DetailHeading>
        <p>See how to edit, enrich, and sync products in Peak.</p>
      </div>
      <div>
        <DetailHeading class="text-size-regular text-weight-semibold"><PeakIcon name="chat" wrapperClass="peak-demo-booking__icon" />Your questions, answered</DetailHeading>
        <p>Focus on the workflows that matter to your team.</p>
      </div>
    </div>
    <figure class="peak-demo-booking__testimonial">
      <blockquote>“We installed Peak PIM to centralize all our product content, and the result has exceeded our expectations.”</blockquote>
      <figcaption>
        <img class="peak-demo-booking__testimonial-portrait" src={assets.testimonials.simonTordjman} alt="Simon Tordjman" width="44" height="44" />
        <div><strong>Simon Tordjman</strong><span>COO, Du Bruit dans la Cuisine</span></div>
      </figcaption>
    </figure>
  </div>
  <div class="peak-demo-booking__calendar">
    <iframe
      title="Book your live Peak PIM demo"
      src={modal ? undefined : calendarUrl}
      data-booking-src={modal ? calendarUrl : undefined}
      loading={modal ? "eager" : "lazy"}
      width="100%"
      height="650"
    ></iframe>
    <p class="peak-demo-booking__fallback"><a href={googleBookingUrl} target="_blank" rel="noopener">Open Google Calendar in a new tab</a></p>
  </div>
</div>

<style>
  .peak-demo-booking {
    display: grid;
    grid-template-columns: minmax(18rem, 0.85fr) minmax(0, 1.65fr);
    background: white;
    border: 1px solid var(--color-scheme-1--border);
    border-radius: 1rem;
    overflow: hidden;
  }
  .peak-demo-booking__intro {
    display: flex;
    flex-direction: column;
    padding: 3rem 2rem;
    background: var(--color-paper);
  }
  .peak-demo-booking__host {
    display: flex;
    align-items: center;
    gap: 0.75rem;
  }
  .peak-demo-booking__portrait {
    width: 3rem;
    height: 3rem;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }
  .peak-demo-booking__details {
    display: grid;
    gap: 1.5rem;
    margin-top: 0.5rem;
    margin-bottom: 2rem;
  }
  .peak-demo-booking__details p {
    margin-top: 0.4rem;
    color: var(--color-muted);
    font-size: 0.875rem;
    line-height: 1.5;
  }
  .peak-demo-booking__details :is(h2, h3) {
    display: flex;
    align-items: center;
    gap: 0.625rem;
  }
  .peak-demo-booking__details :global(.peak-demo-booking__icon) {
    width: 1.25rem;
    height: 1.25rem;
    flex-shrink: 0;
    color: var(--color-brand-blue);
  }
  .peak-demo-booking__testimonial {
    margin: auto 0 0;
    padding: 1.5rem;
    border-radius: 1rem;
    background: var(--color-ink);
    color: white;
  }
  .peak-demo-booking__testimonial blockquote {
    margin: 0;
    padding: 0;
    border: 0;
    font-size: 1rem;
    line-height: 1.5;
    text-wrap: pretty;
  }
  .peak-demo-booking__testimonial figcaption {
    display: flex;
    align-items: center;
    gap: 0.75rem;
    margin-top: 1.25rem;
    padding-top: 1rem;
    border-top: 1px solid rgb(255 255 255 / 15%);
    text-align: left;
    font-size: 0.8125rem;
    line-height: 1.5;
  }
  .peak-demo-booking__testimonial-portrait {
    width: 2.75rem;
    height: 2.75rem;
    flex-shrink: 0;
    border-radius: 50%;
    object-fit: cover;
  }
  .peak-demo-booking__testimonial figcaption span {
    display: block;
    margin-top: 0.125rem;
    font-size: 0.75rem;
    color: #ccc;
  }
  .peak-demo-booking__calendar {
    min-width: 0;
    padding: 3rem 1rem 1rem;
  }
  .peak-demo-booking__calendar iframe {
    display: block;
    width: 100%;
    height: 40.625rem;
    border: 0;
    background: white;
  }
  .peak-demo-booking__fallback {
    padding: 0.75rem;
    text-align: center;
    font-size: 0.75rem;
    color: var(--color-muted);
  }
  .peak-demo-booking__fallback a { text-decoration: underline; }
  @media (max-width: 991px) {
    .peak-demo-booking { grid-template-columns: 1fr; }
    .peak-demo-booking__intro { padding: 2rem; }
    .peak-demo-booking__heading { padding-right: 2.5rem; }
    .peak-demo-booking__details { grid-template-columns: repeat(3, minmax(0, 1fr)); }
    .peak-demo-booking__calendar { padding-top: 1rem; }
  }
  @media (max-width: 767px) {
    .peak-demo-booking__intro { padding: 2rem 1.25rem 1.25rem; }
    .peak-demo-booking__details { grid-template-columns: 1fr; gap: 1rem; }
    .peak-demo-booking__testimonial { padding: 1.25rem; }
    .peak-demo-booking__calendar { padding-inline: 0; }
    .peak-demo-booking__calendar iframe { height: 70rem; }
  }
</style>
