<script>
  const mobileQuery = window.matchMedia("(max-width: 767px)");

  document.querySelectorAll<HTMLElement>("[data-workflows]").forEach((switcher) => {
    const tabs = Array.from(switcher.querySelectorAll<HTMLButtonElement>("[data-workflow-tab]"));
    const accordions = Array.from(switcher.querySelectorAll<HTMLButtonElement>("[data-workflow-accordion]"));
    const panels = Array.from(switcher.querySelectorAll<HTMLElement>("[data-workflow-panel]"));
    let active = 0;

    function select(index: number) {
      active = index;
      tabs.forEach((tab, tabIndex) => {
        const selected = tabIndex === index;
        tab.setAttribute("aria-selected", String(selected));
        tab.tabIndex = selected || (index === -1 && tabIndex === 0) ? 0 : -1;
      });
      accordions.forEach((accordion, accordionIndex) => accordion.setAttribute("aria-expanded", String(accordionIndex === index)));
      panels.forEach((panel, panelIndex) => { panel.hidden = panelIndex !== index; });
    }

    function stopRotation() {
      switcher.classList.add("is-manual");
    }

    function applyLayout() {
      panels.forEach((panel, index) => {
        if (mobileQuery.matches) {
          panel.setAttribute("role", "region");
          panel.setAttribute("aria-labelledby", accordions[index].id);
          panel.removeAttribute("tabindex");
        } else {
          panel.setAttribute("role", "tabpanel");
          panel.setAttribute("aria-labelledby", tabs[index].id);
          panel.tabIndex = 0;
        }
      });

      if (!mobileQuery.matches && active === -1) select(0);
    }

    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => {
        stopRotation();
        select(index);
      });

      tab.addEventListener("keydown", (event) => {
        const keys: Record<string, number> = {
          ArrowDown: (index + 1) % tabs.length,
          ArrowRight: (index + 1) % tabs.length,
          ArrowUp: (index - 1 + tabs.length) % tabs.length,
          ArrowLeft: (index - 1 + tabs.length) % tabs.length,
          Home: 0,
          End: tabs.length - 1,
        };
        const next = keys[event.key];
        if (next === undefined) return;
        event.preventDefault();
        stopRotation();
        select(next);
        tabs[next].focus();
      });

      // The progress line drives auto-rotation, so reduced motion and manual selection stop it.
      tab.querySelector(".peak-workflows__progress")?.addEventListener("animationend", () => {
        if (switcher.classList.contains("is-manual") || tab.getAttribute("aria-selected") !== "true") return;
        select((index + 1) % tabs.length);
      });
    });

    accordions.forEach((accordion, index) => {
      accordion.addEventListener("click", () => {
        stopRotation();
        select(accordion.getAttribute("aria-expanded") === "true" ? -1 : index);
      });
    });

    let hovered = false;
    let visible = false;
    const updatePaused = () => switcher.classList.toggle("is-paused", hovered || !visible);

    switcher.addEventListener("mouseenter", () => { hovered = true; updatePaused(); });
    switcher.addEventListener("mouseleave", () => { hovered = false; updatePaused(); });

    new IntersectionObserver(([entry]) => {
      visible = entry.isIntersecting;
      updatePaused();
    }, { threshold: 0.4 }).observe(switcher);

    updatePaused();
    applyLayout();
    mobileQuery.addEventListener("change", applyLayout);
  });
</script>
