    .peak-workflows__accordion[aria-expanded="true"] .peak-workflows__chevron { transform: rotate(180deg); }

    .peak-workflows__panel { padding: 0 1.125rem 1.125rem; gap: 1rem; }
    .peak-workflows__panel[hidden] { display: none; }

    .peak-workflows__stage { min-height: 0; padding: 1rem 0.75rem; }
    .peak-wf-card { padding: 0.875rem; }
