---
import SectionHeading from "../ui/SectionHeading.astro";

const cards = [
  {
    title: "Hours back every week",
    description: "Bulk edit thousands of products, collections and media at once, schedule launches with Drops, and let AI draft missing content. No more CSV round trips between your ERP and Shopify stores, or outdated spreadsheets.",
  },
  {
    title: "Fewer errors",
    description: "Easily spot missing, incorrect or unoptimized content, from inaccurate descriptions and missing prices to empty metafields and mismatches between stores.",
  },
  {
    title: "A catalog that sells more",
    description: "Complete, consistent content converts better on your Shopify store, on Google and in AI assistants like ChatGPT. Fill the gaps with AI and translate for new markets.",
  },
  {
    title: "Security",
    description: "Keep product information and workflows in one source of truth, with advanced permissions, change history and backups. No more spreadsheets scattered across computers or knowledge locked with individual teammates.",
  },
];
---

<section id="outcomes" class="section_layout395 color-scheme-1">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="margin-bottom margin-xxlarge outcomes-heading">
          <SectionHeading title="Why merchants choose Peak PIM" />
        </div>
        <div class="w-layout-grid layout395_row outcomes-grid">
          {cards.map((card) => (
            <article class="layout395_card">
              <div class="layout395_card-content outcomes-content">
                <div>
                  <div class="margin-bottom margin-xsmall">
                    <h3 class="heading-style-h4 outcomes-title">
                      <span class="feature-mega-menu__marker" aria-hidden="true"></span>
                      <span>{card.title}</span>
                    </h3>
                  </div>
                  <p>{card.description}</p>
                </div>
              </div>
            </article>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .outcomes-heading :global(h2) { text-wrap: balance; }
  .outcomes-grid { grid-template-columns: repeat(2, minmax(0, 1fr)); }
  .outcomes-content { gap: 2rem; justify-content: flex-start; }
  .outcomes-content p { padding-left: calc(0.5rem + 1rem); text-align: left; }
  .outcomes-title { display: flex; align-items: flex-start; gap: 1rem; }
  .outcomes-title .feature-mega-menu__marker { margin-top: calc((1lh - 0.5rem) / 2); }
  @media (min-width: 992px) {
    .outcomes-heading :global(.max-width-large) { max-width: none; }
  }
  @media (max-width: 991px) {
    .outcomes-grid { grid-template-columns: 1fr; }
  }
</style>
