---
import Button from "../ui/Button.astro";
import { bookDemoUrl, ctaLabels, isBookDemoLabel, type CtaLabel } from "../../data/cta-copy";

type Props = {
  id?: string;
  title?: string;
  description?: string;
  primaryLabel?: CtaLabel;
  primaryHref?: string;
  secondaryLabel?: CtaLabel;
  secondaryHref?: string;
  secondaryExternal?: boolean;
  secondaryCrisp?: boolean;
  trustLine?: string;
};

const {
  id,
  title = "Ready to take control of your catalog?",
  description = "See how Peak PIM simplifies product management across all your Shopify stores.",
  primaryLabel = ctaLabels.tryFree,
  primaryHref = "https://apps.shopify.com/peak-pim",
  secondaryLabel = ctaLabels.bookDemo,
  secondaryHref = bookDemoUrl,
  secondaryExternal = true,
  secondaryCrisp = false,
  trustLine,
} = Astro.props;
const isBookDemo = isBookDemoLabel(secondaryLabel);
const resolvedSecondaryHref = isBookDemo ? bookDemoUrl : secondaryHref;
const resolvedSecondaryExternal = isBookDemo ? true : secondaryExternal;
const resolvedSecondaryCrisp = isBookDemo ? false : secondaryCrisp;
---

<section id={id} class="section_cta51 peak-cta-banner color-scheme-1">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="cta51_component peak-cta-banner__component">
          <div class="cta51_card peak-cta-banner__card color-scheme-2">
            <div class="text-align-center">
              <div class="max-width-large">
                <div class="margin-bottom margin-small"><h2 class="heading-style-h2">{title}</h2></div>
                <p class="text-size-medium">{description}</p>
              </div>
            </div>
            <div class="margin-top margin-medium">
              <div class="button-group is-center">
                <Button href={primaryHref} variant="alternate" external>{primaryLabel}</Button>
                <Button href={resolvedSecondaryHref} variant="secondary-alternate" external={resolvedSecondaryExternal} crisp={resolvedSecondaryCrisp}>{secondaryLabel}</Button>
              </div>
            </div>
            {trustLine && <p class="peak-cta-banner__trust text-size-small">{trustLine}</p>}
          </div>
        </div>
      </div>
    </div>
  </div>
</section>

<style>
  .peak-cta-banner__trust {
    margin-top: 1rem;
    text-align: center;
    opacity: 0.8;
  }
</style>
