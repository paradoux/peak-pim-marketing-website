---
import Button from "../ui/Button.astro";
import type { CtaLabel } from "../../data/cta-copy";

type Cta = { label: CtaLabel; href: string; external?: boolean };
type Props = {
  eyebrow?: string;
  title: string;
  description: string;
  image: string;
  imageAlt: string;
  imageCaption: string;
  companyLogo?: string;
  companyName?: string;
  primaryCta: Cta;
  secondaryCta?: Cta;
  headingLevel?: "h1" | "h2";
};

const {
  eyebrow = "Customer story",
  title,
  description,
  image,
  imageAlt,
  imageCaption,
  companyLogo,
  companyName,
  primaryCta,
  secondaryCta,
  headingLevel = "h1",
} = Astro.props;
const Heading = headingLevel;
---

<header class="section_header84 peak-customer-story-hero color-scheme-1">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-medium">
        <div class="header84_component peak-customer-story-hero__component">
          <div class="w-layout-grid header84_card peak-customer-story-hero__card">
            <div class="header84_card-content peak-customer-story-hero__content">
              <div class="header84_card-content-top">
                <div class="peak-customer-story-hero__identity">
                  <div class="tag is-text">{eyebrow}</div>
                  {companyLogo && <img src={companyLogo} alt={companyName ?? ""} class="peak-customer-story-hero__logo" />}
                </div>
                <div class="margin-bottom margin-small"><Heading class="heading-style-h1">{title}</Heading></div>
                <p class="text-size-medium">{description}</p>
              </div>
              <div class="margin-top margin-medium">
                <div class="button-group">
                  <Button href={primaryCta.href} external={primaryCta.external}>{primaryCta.label}</Button>
                  {secondaryCta && <Button href={secondaryCta.href} variant="secondary" external={secondaryCta.external}>{secondaryCta.label}</Button>}
                </div>
              </div>
            </div>
            <div class="header84_image-wrapper peak-customer-story-hero__image-wrapper">
              <img src={image} alt={imageAlt} loading="eager" fetchpriority="high" class="header84_image peak-customer-story-hero__image" />
              <span class="peak-customer-story-hero__caption">{imageCaption}</span>
            </div>
          </div>
        </div>
      </div>
    </div>
  </div>
</header>

<style>
  .peak-customer-story-hero__identity {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 1.5rem;
    margin-bottom: 1.5rem;
  }

  .peak-customer-story-hero__logo {
    width: 7.5rem;
    height: 3rem;
    object-fit: contain;
    object-position: right center;
  }

  .peak-customer-story-hero__image-wrapper {
    position: relative;
    min-height: 36rem;
    overflow: hidden;
  }

  .peak-customer-story-hero__image {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: 50% 28%;
  }

  .peak-customer-story-hero__caption {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    padding: 0.55rem 0.75rem;
    border-radius: 999px;
    background: rgba(25, 25, 25, 0.82);
    color: white;
    font-size: 0.72rem;
    line-height: 1.2;
    backdrop-filter: blur(8px);
  }

  @media (max-width: 767px) {
    .peak-customer-story-hero__identity {
      align-items: flex-start;
      flex-direction: column;
      gap: 0.75rem;
    }

    .peak-customer-story-hero__logo {
      width: 6.5rem;
      height: 2.25rem;
      object-position: left center;
    }

    .peak-customer-story-hero__image-wrapper {
      min-height: 30rem;
    }
  }
</style>
