---
import { getSharedLogoBannerHtml } from "../../lib/page-source";

type Props = { title?: string };

const { title = "Already trusted by top merchants" } = Astro.props;

function escapeHtml(value: string) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

const logoCloudHtml = getSharedLogoBannerHtml()
  .replace(
    '<section class="section_logo2 color-scheme-2">',
    `<section class="section_logo2 peak-logo-cloud color-scheme-2" aria-label="${escapeHtml(title)}">`,
  )
  .replace('class="logo2_component"', 'class="logo2_component peak-logo-cloud__component"')
  .replace('class="logo2_logo-list"', 'class="logo2_logo-list peak-logo-cloud__list"')
  .replaceAll('class="logo2_wrapper"', 'class="logo2_wrapper peak-logo-cloud__item"')
  .replace(
    '<h2 class="heading-style-h6">Already trusted by top merchants</h2>',
    `<h2 class="heading-style-h6">${escapeHtml(title)}</h2>`,
  )
  .replace(/<img\b([^>]*)>/g, (_tag, attributes: string) => {
    if (/\bclass="/.test(attributes)) {
      return `<img${attributes.replace(/class="([^"]*)"/, 'class="$1 peak-logo-cloud__logo"')}>`;
    }

    return `<img class="peak-logo-cloud__logo"${attributes}>`;
  });
---

<Fragment set:html={logoCloudHtml} />
