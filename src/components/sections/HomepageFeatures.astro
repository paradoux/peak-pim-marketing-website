---
import { parseFragment, type DefaultTreeAdapterMap } from "parse5";
import SectionHeading from "../ui/SectionHeading.astro";
import { assets } from "../../data/assets";
import { ctaExceptions } from "../../data/cta-copy";
import { getPage, getPageDocument } from "../../lib/page-source";

type Props = { html?: string };
type Node = DefaultTreeAdapterMap["node"];
type Element = DefaultTreeAdapterMap["element"];
const { html = getPageDocument(getPage("")!).mainHtml } = Astro.props;
const document = parseFragment(html);
const hasClass = (node: Node, name: string) => "attrs" in node && node.attrs.some(attr => attr.name === "class" && attr.value.split(/\s+/).includes(name));
function findAll(node: Node, match: (node: Node) => boolean): Element[] {
  if (match(node)) return [node as Element];
  return "childNodes" in node ? node.childNodes.flatMap(child => findAll(child, match)) : [];
}
function text(node?: Node): string {
  if (!node) return "";
  if (node.nodeName === "#text") return (node as DefaultTreeAdapterMap["textNode"]).value;
  return "childNodes" in node ? node.childNodes.map(text).join(" ").replace(/\s+/g, " ").trim() : "";
}
const section = findAll(document, node => hasClass(node, "section_layout375"))[0];
if (!section) throw new Error("The homepage features source section is missing.");
const title = text(findAll(section, node => node.nodeName === "h2")[0]);
const description = text(findAll(section, node => hasClass(node, "text-size-medium"))[0]);
const cards = [
  { id: "multi-stores", title: "Multi-stores", description: "Manage data across all your stores & channels from a single dashboard.", image: assets.productUi.multiStoreProductView, width: 2976, height: 1452 },
  { id: "bulk-edit", title: "Bulk Edit", description: "Edit hundreds of products, files, collections, metafields and more at once.", image: assets.productUi.bulkEditProductView, width: 2542, height: 1450 },
  { id: "media", title: "Media Management", description: "Upload, organize, and assign files across your catalog from a single media library.", image: assets.productUi.mediaManagementProductView, width: 2532, height: 1462 },
  { id: "drops", title: "Drops", description: "Schedule changes and automatic rollbacks.", image: assets.productUi.dropsProductView, width: 2540, height: 1460 },
  { id: "automations", title: "Automations", description: "Run repeatable catalog workflows automatically.", image: assets.productUi.automationsProductView, width: 2540, height: 1464 },
];
---

<section id="features" class="peak-home-features color-scheme-1" data-feature-showcase>
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-large">
        <div class="margin-bottom margin-xxlarge">
          <SectionHeading title={title} description={description} />
        </div>
        <div class="peak-home-features__navigation">
          <div class="peak-home-features__tabs" role="tablist" aria-label={title}>
            {cards.map((card, index) => (
              <button
                type="button"
                id={`feature-tab-${index}`}
                role="tab"
                aria-controls={`feature-panel-${index}`}
                aria-selected={index === 0 ? "true" : "false"}
                tabindex={index === 0 ? 0 : -1}
              >{card.title}</button>
            ))}
          </div>
          <button type="button" class="button is-link is-icon peak-home-features__explore" data-explore-features aria-controls="w-dropdown-list-0">
            <span>{ctaExceptions.exploreAll}</span>
            <svg width="16" height="16" viewBox="0 0 16 16" fill="none" aria-hidden="true"><path d="M3 8h10M8 3l5 5-5 5" stroke="currentColor" stroke-width="1.5" /></svg>
          </button>
        </div>
        <div class="peak-home-features__panels">
          {cards.map((card, index) => (
            <div
              id={`feature-panel-${index}`}
              role="tabpanel"
              aria-labelledby={`feature-tab-${index}`}
              tabindex="0"
              hidden={index !== 0}
              class="peak-home-features__panel"
              data-feature={card.id}
            >
              <div class="peak-home-features__caption">
                <p class="text-size-medium" set:html={card.description} />
              </div>
              <div class="peak-home-features__stage" role="img" aria-label={card.title}>
                <div class="peak-home-features__capture" aria-hidden="true">
                  <div class="peak-home-features__capture-frame">
                    <div class="peak-home-features__capture-window">
                      <div class="peak-home-features__capture-bar">
                        <i></i><i></i><i></i>
                        {card.id === "automations" && <span class="feature-status-badge">Coming soon</span>}
                      </div>
                      <img src={card.image} width={card.width} height={card.height} alt="" loading="lazy" decoding="async" />
                    </div>
                  </div>
                </div>
              </div>
            </div>
          ))}
        </div>
      </div>
    </div>
  </div>
</section>

<script>
  document.querySelectorAll<HTMLElement>("[data-feature-showcase]").forEach(showcase => {
    showcase.querySelector("[data-explore-features]")?.addEventListener("click", event => {
      const header = document.querySelector(".site-header");
      const toggle = header?.querySelector<HTMLElement>(".feature-menu-dropdown .navbar10_dropdown-toggle");
      if (!toggle) return;
      // Reuse the header's existing menu behavior, including its mobile navigation.
      event.stopPropagation();
      const mobileToggle = header?.querySelector<HTMLElement>(".navbar10_menu-button");
      if (window.matchMedia("(max-width: 991px)").matches && mobileToggle?.getAttribute("aria-expanded") !== "true") mobileToggle?.click();
      if (toggle.getAttribute("aria-expanded") !== "true") toggle.click();
      toggle.focus({ preventScroll: true });
    });
    const tabs = Array.from(showcase.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(showcase.querySelectorAll<HTMLElement>('[role="tabpanel"]'));
    function select(index: number) {
      tabs.forEach((tab, i) => {
        tab.setAttribute("aria-selected", String(i === index));
        tab.tabIndex = i === index ? 0 : -1;
        panels[i].hidden = i !== index;
      });
      // Scroll only the tab row, keeping the page in place on mobile.
      const row = tabs[index].parentElement!;
      const tabBounds = tabs[index].getBoundingClientRect();
      const rowBounds = row.getBoundingClientRect();
      if (tabBounds.left < rowBounds.left || tabBounds.right > rowBounds.right) {
        row.scrollLeft += tabBounds.left - rowBounds.left - (row.clientWidth - tabBounds.width) / 2;
      }
    }
    tabs.forEach((tab, index) => {
      tab.addEventListener("click", () => select(index));
      tab.addEventListener("keydown", event => {
        let next: number;
        switch (event.key) {
          case "ArrowRight": next = (index + 1) % tabs.length; break;
          case "ArrowLeft": next = (index - 1 + tabs.length) % tabs.length; break;
          case "Home": next = 0; break;
          case "End": next = tabs.length - 1; break;
          default: return;
        }
        event.preventDefault();
        select(next);
        tabs[next].focus({ preventScroll: true });
      });
    });
  });
</script>

<style>
  .peak-home-features { scroll-margin-top: 6rem; }
  .peak-home-features__navigation { display: flex; align-items: center; justify-content: center; gap: 1.5rem; margin-bottom: 1.25rem; min-width: 0; }
  .peak-home-features__explore { flex-shrink: 0; min-height: 44px; white-space: nowrap; }
  .peak-home-features__explore:focus-visible { outline: 2px solid #2845d6; outline-offset: 4px; }
  .peak-home-features__tabs { display: flex; gap: 0.25rem; max-width: 100%; padding: 0.375rem; overflow-x: auto; border: 1px solid #dcd9d2; border-radius: 0.75rem; background: #eae7e0; scrollbar-width: none; }
  .peak-home-features__tabs::-webkit-scrollbar { display: none; }
  .peak-home-features__tabs button { flex-shrink: 0; min-height: 44px; padding: 0.625rem 1.125rem; border: 0; border-radius: 0.5rem; background: transparent; color: #595852; font: inherit; font-size: 0.9375rem; font-weight: 500; cursor: pointer; transition: color 180ms, background-color 180ms, box-shadow 180ms; }
  .peak-home-features__tabs button:hover { color: #1a1a1a; background: #f5f3ee; }
  .peak-home-features__tabs button[aria-selected="true"] { color: #1a1a1a; background: #fff; box-shadow: 0 1px 5px #1a1a1a12; }
  .peak-home-features__tabs button:focus-visible { outline: 2px solid #2845d6; outline-offset: -2px; }
  .peak-home-features__panel[hidden] { display: none; }
  .peak-home-features__panel:focus-visible { outline: 2px solid #2845d6; outline-offset: 6px; border-radius: 1rem; }
  .peak-home-features__stage { position: relative; overflow: hidden; border-radius: 1rem; background: #1a1a1a; background-image: radial-gradient(rgba(255,255,255,0.08) 1px, transparent 1px); background-size: 14px 14px; }
  .peak-home-features__capture { padding: 4% 6%; }
  .peak-home-features__capture-frame { width: 100%; padding: 6px; border: 1px solid #ffffff40; border-radius: 14px; background: #ffffff24; box-shadow: 0 20px 60px #0004; }
  .peak-home-features__capture-window { overflow: hidden; border: 1px solid #dcd9d2; border-radius: 8px; background: #faf9f6; }
  .peak-home-features__capture-bar { display: flex; align-items: center; gap: 6px; height: 30px; padding-inline: 12px; border-bottom: 1px solid #e4e0d8; }
  .peak-home-features__capture-bar .feature-status-badge { margin-left: auto; }
  .peak-home-features__capture-bar i { width: 6px; height: 6px; border: 1px solid #b8b4ab; border-radius: 50%; }
  .peak-home-features__capture img { display: block; width: 100%; height: auto; }
  .peak-home-features__caption { display: flex; align-items: center; justify-content: center; margin-bottom: 1.25rem; min-height: 3.5rem; text-align: center; }
  .peak-home-features__caption p { max-width: 52rem; }
  @media (min-width: 1280px) {
    .peak-home-features__stage { background-image: radial-gradient(rgba(255,255,255,0.08) 1.25px, transparent 1.25px); background-size: 17.5px 17.5px; }
  }
  @media (max-width: 991px) {
    .peak-home-features__navigation { flex-direction: column; gap: 0.75rem; }
    .peak-home-features__caption { min-height: 4.5rem; }
    .peak-home-features__tabs button { padding-inline: 0.875rem; }
  }
  @media (max-width: 767px) {
    .peak-home-features__navigation { margin-bottom: 1rem; }
    .peak-home-features__tabs { border-radius: 0.625rem; }
    .peak-home-features__tabs button { font-size: 0.875rem; }
    .peak-home-features__stage { background-image: radial-gradient(rgba(255,255,255,0.08) 0.8px, transparent 0.8px); background-size: 11.2px 11.2px; }
    .peak-home-features__caption { margin-bottom: 1rem; min-height: 4.5rem; }
  }
  @media (prefers-reduced-motion: no-preference) {
    .peak-home-features__panel:not([hidden]) { animation: peak-feature-reveal 200ms ease-out; }
    @keyframes peak-feature-reveal { from { opacity: 0; transform: translateY(4px); } to { opacity: 1; transform: translateY(0); } }
  }
  @media (prefers-reduced-motion: reduce) {
    .peak-home-features__tabs button { transition: none; }
  }
</style>
