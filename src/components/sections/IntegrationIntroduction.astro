---
import Button from "../ui/Button.astro";
import BuildAroundYourBusiness from "../visuals/BuildAroundYourBusiness.astro";
import SectionHeading from "../ui/SectionHeading.astro";
import { ctaLabels } from "../../data/cta-copy";
---

<section id="integrations" class="section_layout1 peak-integration-introduction color-scheme-1">
  <div class="padding-global">
    <div class="container-large">
      <div class="padding-section-medium">
        <div class="margin-bottom margin-medium">
          <SectionHeading title="Connect Peak to your stack" description="Connect all your sources and sync with every channel and tool your business already uses." />
        </div>
        <BuildAroundYourBusiness />
        <div class="margin-top margin-medium"><div class="button-group is-center"><Button href="/custom-integrations" variant="link">{ctaLabels.learnMore}</Button></div></div>
      </div>
    </div>
  </div>
</section>
