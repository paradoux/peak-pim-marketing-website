---
import { getSharedHeaderHtml } from "../lib/page-source";
import { exploreNavigationLinks, featureNavigationGroups, resourceNavigationLinks } from "../data/site-navigation";
import { assets } from "../data/assets";
import { localizeInternalHref, type Locale } from "../i18n/config";
import { localizeSharedMarkup, translateSharedCopy } from "../i18n/shared-copy";

type Props = {
  locale?: Locale;
};

const { locale = "en" } = Astro.props;
const tr = (value: string) => translateSharedCopy(locale, value);
const localizedHref = (href: string) => localizeInternalHref(href, locale);

function escapeHtml(value: string) {
  return value
    .replaceAll("&", "&amp;")
    .replaceAll('"', "&quot;")
    .replaceAll("<", "&lt;")
    .replaceAll(">", "&gt;");
}

const featureGroupsHtml = featureNavigationGroups.filter((group) => group.label !== "Solutions").map((group) => `
  <section class="feature-mega-menu__group${group.label === "Operate" ? " is-dense" : ""}" aria-labelledby="feature-group-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}">
    <div class="feature-mega-menu__group-heading">
      <span class="feature-mega-menu__marker" aria-hidden="true"></span>
      <div>
        <div id="feature-group-${group.label.toLowerCase().replace(/[^a-z0-9]+/g, "-").replace(/^-|-$/g, "")}" class="feature-mega-menu__title">${escapeHtml(tr(group.label))}</div>
        <p class="feature-mega-menu__group-description">${escapeHtml(tr(group.description))}</p>
      </div>
    </div>
    <div class="feature-mega-menu__links">
      ${group.links.map((link) => link.comingSoon ? `
        <div class="feature-mega-menu__link is-coming-soon" aria-disabled="true">
          <span class="feature-mega-menu__link-heading">
            <span class="feature-mega-menu__link-title">${escapeHtml(tr(link.label))}</span>
            <span class="feature-status-badge">${escapeHtml(tr("Coming soon"))}</span>
          </span>
          <span class="feature-mega-menu__link-description">${escapeHtml(tr(link.description ?? ""))}</span>
        </div>
      ` : `
        <a href="${escapeHtml(localizedHref(link.href))}" class="feature-mega-menu__link">
          <span class="feature-mega-menu__link-heading">
            <span class="feature-mega-menu__link-title">${escapeHtml(tr(link.label))}</span>
            ${link.badge ? `<span class="feature-status-badge">${escapeHtml(tr(link.badge))}</span>` : ""}
          </span>
          <span class="feature-mega-menu__link-description">${escapeHtml(tr(link.description ?? ""))}</span>
        </a>
      `).join("")}
    </div>
  </section>
`).join("");
const liveDemoLink = exploreNavigationLinks.find((link) => link.href === "https://app.peak-pim.com/demo");

if (!liveDemoLink) {
  throw new Error("The shared navigation is missing the Live demo link.");
}

const featureMenuHtml = `
  <nav class="navbar10_dropdown-list feature-menu-dropdown__list w-dropdown-list" id="w-dropdown-list-0" aria-labelledby="w-dropdown-toggle-0" aria-label="Peak PIM features" style="opacity: 0;">
    <div class="navbar10_container">
      <div class="feature-mega-menu">
        <div class="feature-mega-menu__intro">
          <span class="feature-mega-menu__eyebrow">One Shopify PIM. Every catalog workflow.</span>
          <p>Connect all your stores, plug in your stack, and run your entire catalog from one place.</p>
          <a href="${escapeHtml(liveDemoLink.href)}" target="_blank" rel="noopener" class="feature-mega-menu__demo-link">${escapeHtml(tr(liveDemoLink.label))}<span aria-hidden="true">&rarr;</span></a>
        </div>
        <div class="feature-mega-menu__grid">${featureGroupsHtml}</div>
      </div>
    </div>
  </nav>
`;

const chevronHtml = `<div class="dropdown-chevron w-embed"><svg width="100%" height="100%" viewBox="0 0 16 16" fill="none" xmlns="http://www.w3.org/2000/svg" aria-hidden="true"><path fill-rule="evenodd" clip-rule="evenodd" d="M2.55806 6.29544C2.46043 6.19781 2.46043 6.03952 2.55806 5.94189L3.44195 5.058C3.53958 4.96037 3.69787 4.96037 3.7955 5.058L8.00001 9.26251L12.2045 5.058C12.3021 4.96037 12.4604 4.96037 12.5581 5.058L13.4419 5.94189C13.5396 6.03952 13.5396 6.19781 13.4419 6.29544L8.17678 11.5606C8.07915 11.6582 7.92086 11.6582 7.82323 11.5606L2.55806 6.29544Z" fill="currentColor"></path></svg></div>`;
const reviewsLink = exploreNavigationLinks.find((link) => link.label === "Reviews");
const testimonialLink = exploreNavigationLinks.find((link) => link.label === "Testimonials");

if (!reviewsLink || !testimonialLink) {
  throw new Error("The shared navigation is missing the customer proof links.");
}

const customerMenuHtml = `
  <div data-delay="300" data-hover="true" class="navbar10_menu-dropdown customers-menu-dropdown w-dropdown">
    <div class="navbar10_dropdown-toggle w-dropdown-toggle" id="w-dropdown-toggle-1" aria-controls="w-dropdown-list-1" aria-haspopup="menu" aria-expanded="false" role="button" tabindex="0"><div>Customers</div>${chevronHtml}</div>
    <nav class="navbar10_dropdown-list customers-mega-menu__dropdown w-dropdown-list" id="w-dropdown-list-1" aria-labelledby="w-dropdown-toggle-1" aria-label="Peak PIM customer proof" style="opacity: 0;">
      <div class="navbar10_container">
        <div class="customers-mega-menu">
          <section class="customers-mega-menu__section" aria-labelledby="customers-reviews-heading">
            <div class="customers-mega-menu__section-heading"><span class="customers-mega-menu__marker" aria-hidden="true"></span><span id="customers-reviews-heading">Reviews</span></div>
            <a href="${escapeHtml(reviewsLink.href)}" target="_blank" rel="noopener" class="customers-mega-menu__reviews-link">
              <strong>Verified Shopify reviews</strong>
              <span>Read reviews published by merchants on the Peak PIM listing in the Shopify App Store.</span>
              <span class="customers-mega-menu__action">Read reviews<span aria-hidden="true">&rarr;</span></span>
            </a>
          </section>
          <section class="customers-mega-menu__section" aria-labelledby="customers-use-cases-heading">
            <div class="customers-mega-menu__section-heading"><span class="customers-mega-menu__marker" aria-hidden="true"></span><span id="customers-use-cases-heading">Use cases</span></div>
            <div class="customers-mega-menu__stories">
              <a href="${escapeHtml(testimonialLink.href)}" class="customers-mega-menu__story-link">
                <span class="customers-mega-menu__story-image">
                  <img src="${escapeHtml(assets.testimonials.amelieSamsonMaeliParis)}" alt="Amélie Samson, founder of Maéli Paris" loading="lazy">
                  <span class="customers-mega-menu__story-logo"><img src="${escapeHtml(assets.customerLogos.light.maeli)}" alt="Maéli Paris" loading="lazy"></span>
                </span>
                <span class="customers-mega-menu__story-content">
                  <strong>Maéli Paris</strong>
                  <span>Save hours with weekly Drops and grow revenue in new markets.</span>
                  <span class="customers-mega-menu__action">See use case<span aria-hidden="true">&rarr;</span></span>
                </span>
              </a>
              <a href="/customers/carre-coco/" class="customers-mega-menu__story-link">
                <span class="customers-mega-menu__story-image">
                  <img src="${escapeHtml(assets.testimonials.colineLeleuCarreCoco)}" alt="Coline Leleu, founder of Carré Coco" loading="lazy">
                  <span class="customers-mega-menu__story-logo"><img src="${escapeHtml(assets.customerLogos.light.carreCocoStory)}" alt="Carré Coco" loading="lazy"></span>
                </span>
                <span class="customers-mega-menu__story-content">
                  <strong>Carré Coco</strong>
                  <span>B2B and B2C catalogs managed together.</span>
                  <span class="customers-mega-menu__action">See use case<span aria-hidden="true">&rarr;</span></span>
                </span>
              </a>
            </div>
          </section>
        </div>
      </div>
    </nav>
  </div>`;

const resourceMenuHtml = `
  <div data-delay="300" data-hover="true" class="navbar10_menu-dropdown resources-menu-dropdown w-dropdown">
    <div class="navbar10_dropdown-toggle w-dropdown-toggle" id="w-dropdown-toggle-2" aria-controls="w-dropdown-list-2" aria-haspopup="menu" aria-expanded="false" role="button" tabindex="0"><div>Resources</div>${chevronHtml}</div>
    <nav class="navbar10_dropdown-list resources-mega-menu__dropdown w-dropdown-list" id="w-dropdown-list-2" aria-labelledby="w-dropdown-toggle-2" aria-label="Peak PIM resources" style="opacity: 0;">
      <div class="navbar10_container">
        <div class="resources-mega-menu">
          <div class="resources-mega-menu__intro">
            <span class="feature-mega-menu__eyebrow">Explore Peak PIM</span>
            <p>See the product, learn the workflows, and find the technical details you need.</p>
          </div>
          <div class="resources-mega-menu__grid">
            ${resourceNavigationLinks.map((link) => `
              <a href="${escapeHtml(link.href)}" target="_blank" rel="noopener" class="resources-mega-menu__link">
                <span class="resources-mega-menu__link-heading"><span class="resources-mega-menu__link-marker" aria-hidden="true"></span><strong>${escapeHtml(tr(link.label))}</strong></span>
                <span>${escapeHtml(tr(link.description ?? ""))}</span>
              </a>
            `).join("")}
          </div>
        </div>
      </div>
    </nav>
  </div>`;

const sharedHeaderHtml = getSharedHeaderHtml();
const headerWithFeatureMenu = sharedHeaderHtml
  .replace('class="navbar10_menu-dropdown w-dropdown"', 'class="navbar10_menu-dropdown feature-menu-dropdown w-dropdown"')
  .replace(
    /<nav class="navbar10_dropdown-list w-dropdown-list"[\s\S]*?<\/nav>/,
    featureMenuHtml,
  );

if (headerWithFeatureMenu === sharedHeaderHtml) {
  throw new Error("The shared Features menu could not be replaced.");
}

const headerHtml = headerWithFeatureMenu
  .replace(
    '<a href="https://apps.shopify.com/peak-pim/reviews" target="_blank" class="navbar10_link w-nav-link">Reviews</a>',
    `${customerMenuHtml}${resourceMenuHtml}`,
  )
  .replace(
    '<a href="/pricing" class="navbar10_link w-nav-link">Pricing</a>',
    '<a href="/pricing/" class="navbar10_link w-nav-link">Pricing</a>',
  )
  .replace(
    '<img width="132" sizes="132px"',
    '<img width="132" height="58" sizes="132px"',
  );
const localizedHeaderHtml = localizeSharedMarkup(locale, headerHtml);
---

<div class="site-header" set:html={localizedHeaderHtml} />

<script is:inline>
  function setupPeakNavigation() {
    var header = document.querySelector(".site-header");

    if (!header || header.dataset.navigationReady === "true") {
      return;
    }

    header.dataset.navigationReady = "true";

    var dropdownItems = Array.from(header.querySelectorAll(".navbar10_menu-dropdown")).map(function(dropdown) {
      return {
        dropdown: dropdown,
        toggle: dropdown.querySelector(".navbar10_dropdown-toggle"),
        list: dropdown.querySelector(".navbar10_dropdown-list"),
        closeTimer: undefined,
      };
    });
    var menuButton = header.querySelector(".navbar10_menu-button");
    var menu = header.querySelector(".navbar10_menu");
    var overlay = header.querySelector(".w-nav-overlay");
    var scrollFrame;

    function updateScrolledState() {
      header.classList.toggle("is-scrolled", window.scrollY > 4);
      scrollFrame = undefined;
    }

    function handleScroll() {
      if (scrollFrame) {
        return;
      }

      scrollFrame = window.requestAnimationFrame(updateScrolledState);
    }

    updateScrolledState();
    window.addEventListener("scroll", handleScroll, { passive: true });

    function openDropdown(item) {
      if (!item || !item.dropdown || !item.toggle || !item.list) {
        return;
      }

      window.clearTimeout(item.closeTimer);
      dropdownItems.forEach(function(otherItem) {
        if (otherItem !== item) closeDropdown(otherItem);
      });
      item.dropdown.classList.add("w--open");
      item.toggle.classList.add("w--open");
      item.list.classList.add("w--open");
      item.list.style.opacity = "1";
      item.toggle.setAttribute("aria-expanded", "true");
    }

    function closeDropdown(item) {
      if (!item || !item.dropdown || !item.toggle || !item.list) {
        return;
      }

      item.dropdown.classList.remove("w--open");
      item.toggle.classList.remove("w--open");
      item.list.classList.remove("w--open");
      item.list.style.opacity = "0";
      item.toggle.setAttribute("aria-expanded", "false");
    }

    function closeAllDropdowns() {
      dropdownItems.forEach(closeDropdown);
    }

    function scheduleDropdownClose(item) {
      window.clearTimeout(item.closeTimer);
      item.closeTimer = window.setTimeout(function() { closeDropdown(item); }, 160);
    }

    function isDesktopNavigation() {
      return window.matchMedia("(min-width: 992px)").matches;
    }

    function setMobileMenu(open) {
      if (!menuButton || !menu || !overlay) {
        return;
      }

      menuButton.classList.toggle("w--open", open);
      menuButton.setAttribute("aria-expanded", String(open));
      overlay.style.display = open ? "block" : "";

      if (open) {
        menu.setAttribute("data-nav-menu-open", "");
      } else {
        menu.removeAttribute("data-nav-menu-open");
        closeAllDropdowns();
      }
    }

    dropdownItems.forEach(function(item) {
      if (!item.toggle || !item.list) return;

      item.dropdown.addEventListener("mouseenter", function() {
        if (isDesktopNavigation()) {
          openDropdown(item);
        }
      });
      item.dropdown.addEventListener("mouseleave", function() {
        if (isDesktopNavigation()) {
          scheduleDropdownClose(item);
        }
      });
      item.toggle.addEventListener("click", function(event) {
        event.preventDefault();
        event.stopImmediatePropagation();

        if (item.list.classList.contains("w--open")) {
          closeDropdown(item);
        } else {
          openDropdown(item);
        }
      }, true);
      item.toggle.addEventListener("keydown", function(event) {
        if (event.key === "Enter" || event.key === " ") {
          event.preventDefault();
          event.stopImmediatePropagation();
          openDropdown(item);
        }

        if (event.key === "Escape") {
          closeDropdown(item);
          item.toggle.focus();
        }
      });
      item.list.addEventListener("keydown", function(event) {
        if (event.key === "Escape") {
          closeDropdown(item);
          item.toggle.focus();
        }
      });
    });

    if (menuButton && menu && overlay) {
      menuButton.addEventListener("click", function(event) {
        event.preventDefault();
        event.stopImmediatePropagation();
        setMobileMenu(!menuButton.classList.contains("w--open"));
      }, true);
    }

    document.addEventListener("click", function(event) {
      if (!header.contains(event.target)) {
        closeAllDropdowns();
        setMobileMenu(false);
      }
    });
  }

  if (document.readyState === "loading") {
    document.addEventListener("DOMContentLoaded", setupPeakNavigation);
  } else {
    setupPeakNavigation();
  }
</script>
