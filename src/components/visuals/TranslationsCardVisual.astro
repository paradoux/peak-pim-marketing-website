---
import type { Locale } from "../../i18n/config";

type Props={mode:"matrix"|"ai"|"copy";locale?:Locale};const {mode,locale="en"}=Astro.props;
const copy=locale==="fr"?{
  matrixAria:"Matrice de traduction montrant une langue dans plusieurs boutiques Shopify",
  aiAria:"Workflow de brouillons traduits par l'IA avec le contenu source et le statut de révision",
  copyAria:"Fenêtre de copie des traductions montrant les langues compatibles dans les boutiques cibles",
  oneStore:"Une boutique · toutes les langues",oneLanguage:"Une langue · toutes les boutiques",french:"Français",frStore:"Boutique FR",intlStore:"Boutique internationale",title:"Titre",missing:"Manquant",color:"Couleur",
  source:"Source · anglais",prompt:"Traduisez les champs français et allemands manquants. Conservez le nom de la marque.",aiDraft:"Brouillon IA · Non enregistré",review:"Réviser les brouillons",
  copyFrom:"Copier depuis",franceStore:"Boutique France",copyTo:"Copier vers",targets:"International · Allemagne",international:"International",copied14:"14 copiés · 2 ignorés",germany:"Allemagne",copied8:"8 copiés · 8 ignorés",copyPublish:"Copier et publier",
}:{
  matrixAria:"Translation matrix showing one language across multiple Shopify stores",
  aiAria:"AI translation draft workflow with source content and review status",
  copyAria:"Copy translations dialog showing compatible languages across target stores",
  oneStore:"One store · all languages",oneLanguage:"One language · all stores",french:"French",frStore:"FR store",intlStore:"Intl store",title:"Title",missing:"Missing",color:"Color",
  source:"Source · English",prompt:"Translate the missing French and German fields. Keep the brand name unchanged.",aiDraft:"AI draft · Unsaved",review:"Review drafts",
  copyFrom:"Copy from",franceStore:"France store",copyTo:"Copy to",targets:"International · Germany",international:"International",copied14:"14 copied · 2 skipped",germany:"Germany",copied8:"8 copied · 8 skipped",copyPublish:"Copy & publish",
};
---
<div class:list={["peak-tr-card",`is-${mode}`]} role="img" aria-label={mode==="matrix"?copy.matrixAria:mode==="ai"?copy.aiAria:copy.copyAria}>
  {mode==="matrix"&&<><div class="peak-tr-card-tabs"><span>{copy.oneStore}</span><span class="active">{copy.oneLanguage}</span></div><div class="peak-tr-card-grid"><b>{copy.french}</b><b>{copy.frStore}</b><b>{copy.intlStore}</b><span>{copy.title}</span><em>Veste Alpine</em><em>Veste d'alpinisme</em><span>SEO</span><em>Coque légère…</em><em class="missing">{copy.missing}</em><span>{copy.color}</span><em>Rouge</em><em>Rouge</em></div></>}
  {mode==="ai"&&<div class="peak-tr-ai"><div><small>{copy.source}</small><b lang={locale === "fr" ? "en" : undefined}>Weather-ready shell jacket</b></div><p>{copy.prompt}</p><span><i>FR</i><b>Veste shell résistante…</b><em>{copy.aiDraft}</em></span><span><i>DE</i><b lang="de">Wetterfeste Shelljacke…</b><em>{copy.aiDraft}</em></span><button>{copy.review}</button></div>}
  {mode==="copy"&&<div class="peak-tr-copy"><div><small>{copy.copyFrom}</small><b>{copy.franceStore}</b></div><i>→</i><div><small>{copy.copyTo}</small><b>{copy.targets}</b></div><span><b>{copy.international}</b><em>{copy.copied14}</em></span><span><b>{copy.germany}</b><em>{copy.copied8}</em></span><button>{copy.copyPublish}</button></div>}
</div>
<style>
  .peak-tr-card{box-sizing:border-box;width:100%;min-height:300px;padding:25px;background:radial-gradient(#333 1px,transparent 1px),#191919;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-tr-card-tabs{display:grid;margin-bottom:12px;grid-template-columns:1fr 1fr;border-radius:7px;background:#fff;padding:4px}.peak-tr-card-tabs span{padding:9px;text-align:center;font-size:7px}.peak-tr-card-tabs .active{border-radius:5px;background:#e9edff;color:#2845d6;font-weight:700}.peak-tr-card-grid{display:grid;overflow:hidden;border-radius:8px;background:#fff;grid-template-columns:72px 1fr 1fr}.peak-tr-card-grid>*{padding:11px 8px;border-bottom:1px solid #eee;border-left:1px solid #eee;font-size:7px;font-style:normal}.peak-tr-card-grid b{background:#f6f3ec}.peak-tr-card-grid .missing{color:#b05a5a}.peak-tr-ai{display:grid;gap:9px}.peak-tr-ai>div,.peak-tr-ai>span,.peak-tr-ai p{margin:0;padding:12px;border-radius:7px;background:#fff}.peak-tr-ai>div{display:flex;flex-direction:column}.peak-tr-ai small,.peak-tr-ai em{color:#777;font-size:7px}.peak-tr-ai p{background:#e9edff;color:#2845d6;font-size:8px}.peak-tr-ai>span{display:grid;grid-template-columns:25px 1fr}.peak-tr-ai>span i{display:grid;width:22px;height:22px;grid-row:1/3;place-items:center;border-radius:4px;background:#191919;color:#fff;font-size:7px;font-style:normal}.peak-tr-ai>span b{font-size:8px}.peak-tr-ai>span em{grid-column:2;color:#5268db;font-style:normal}.peak-tr-ai button,.peak-tr-copy button{padding:11px;border:0;border-radius:7px;background:#2845d6;color:#fff;font:700 8px Inter,Arial,sans-serif}.peak-tr-copy{display:grid;align-items:center;gap:10px;grid-template-columns:1fr auto 1fr}.peak-tr-copy>div,.peak-tr-copy>span{display:flex;flex-direction:column;padding:14px;border-radius:7px;background:#fff}.peak-tr-copy>i{color:#fff;font-style:normal}.peak-tr-copy small,.peak-tr-copy em{color:#777;font-size:7px;font-style:normal}.peak-tr-copy b{font-size:9px}.peak-tr-copy>span{grid-column:1/-1;flex-direction:row;justify-content:space-between}.peak-tr-copy button{grid-column:1/-1}
</style>
