---
type Props = { mode: "context" | "approval" | "publish" };
const { mode } = Astro.props;

const labels = {
  context: "Peak PIM AI Assistant using the current product and store as conversation context",
  approval: "Peak PIM AI Assistant before-and-after proposal with Approve draft and Deny controls",
  publish: "Peak PIM AI Assistant asking for separate storefront publishing confirmation",
};
---

<div class:list={["peak-assistant-card", `is-${mode}`]} role="img" aria-label={labels[mode]}>
  <div class="peak-assistant-card__top"><span><i>AI</i><b>Peak Assistant</b></span><em>{mode === "context" ? "Product context" : mode === "approval" ? "Draft review" : "Publish review"}</em></div>

  {mode === "context" && (
    <div class="peak-assistant-card__context">
      <div><small>Current page</small><b>Summit Shell Jacket</b><span>France · Product detail</span></div>
      <p>What is missing here?</p>
      <ul>
        <li><i></i><span><b>SEO description</b><small>Missing in France</small></span></li>
        <li><i></i><span><b>Care instructions</b><small>Missing in master</small></span></li>
        <li class="is-ready"><i></i><span><b>Title and media</b><small>Ready</small></span></li>
      </ul>
    </div>
  )}

  {mode === "approval" && (
    <div class="peak-assistant-card__approval">
      <div class="peak-assistant-card__badge">Needs your approval</div>
      <strong>SEO description · France</strong>
      <span><small>Before</small><del>Empty</del></span>
      <span class="is-after"><small>After</small><b>Waterproof shell for changing mountain weather.</b></span>
      <div><button>Deny</button><button>Approve draft</button></div>
      <em>Nothing published</em>
    </div>
  )}

  {mode === "publish" && (
    <div class="peak-assistant-card__publish">
      <div><i>✓</i><span><small>Draft saved</small><b>SEO description · France</b></span></div>
      <p>Publish this approved draft to Shopify France?</p>
      <button>Confirm publish</button>
      <small>Separate confirmation required</small>
      <div class="peak-assistant-card__history"><i>AI</i><span><b>Assistant change logged</b><small>Before and after saved in History</small></span></div>
    </div>
  )}
</div>

<style>
  .peak-assistant-card {
    min-height: 310px;
    padding: 20px;
    background: radial-gradient(#343434 1px, transparent 1px), #191919;
    background-size: 18px 18px;
    color: #191919;
    font-family: Inter, Arial, sans-serif;
  }

  .peak-assistant-card__top,
  .peak-assistant-card__top span {
    display: flex;
    align-items: center;
  }

  .peak-assistant-card__top {
    justify-content: space-between;
    margin-bottom: 12px;
    color: #fff;
  }

  .peak-assistant-card__top span { gap: 7px; }
  .peak-assistant-card__top i,
  .peak-assistant-card__history > i { display: grid; width: 22px; height: 22px; place-items: center; border-radius: 5px; background: #fff; color: #191919; font-size: 7px; font-style: normal; font-weight: 800; }
  .peak-assistant-card__top b { font-size: 9px; }
  .peak-assistant-card__top em { color: #aaa; font-size: 7px; font-style: normal; }

  .peak-assistant-card__context,
  .peak-assistant-card__approval,
  .peak-assistant-card__publish {
    display: grid;
    gap: 9px;
    padding: 16px;
    border-radius: 9px;
    background: #fff;
  }

  .peak-assistant-card__context > div,
  .peak-assistant-card__context > div b,
  .peak-assistant-card__context > div span { display: block; }
  .peak-assistant-card small { color: #858585; font-size: 7px; }
  .peak-assistant-card__context > div b { margin: 4px 0; font-size: 11px; }
  .peak-assistant-card__context > div span { color: #858585; font-size: 7px; }
  .peak-assistant-card__context p { margin: 0; padding: 9px 11px; border-radius: 7px; background: #191919; color: #fff; font-size: 8px; }
  .peak-assistant-card__context ul { display: grid; gap: 5px; margin: 0; padding: 0; list-style: none; }
  .peak-assistant-card__context li { display: grid; grid-template-columns: 8px 1fr; align-items: center; gap: 8px; padding: 8px; border: 1px solid #ece9e2; border-radius: 6px; }
  .peak-assistant-card__context li > i { width: 8px; height: 8px; border-radius: 50%; background: #d7aa47; }
  .peak-assistant-card__context li.is-ready > i { background: #53a86d; }
  .peak-assistant-card__context li span { display: flex; flex-direction: column; }
  .peak-assistant-card__context li b { font-size: 8px; }

  .peak-assistant-card__badge { justify-self: start; padding: 5px 7px; border-radius: 999px; background: #eef1ff; color: #2845d6; font-size: 7px; font-weight: 700; }
  .peak-assistant-card__approval > strong { font-size: 10px; }
  .peak-assistant-card__approval > span { display: flex; flex-direction: column; gap: 4px; padding: 9px; border-radius: 6px; background: #f6f3ec; }
  .peak-assistant-card__approval del { color: #888; font-size: 8px; }
  .peak-assistant-card__approval span b { font-size: 8px; line-height: 1.35; }
  .peak-assistant-card__approval span.is-after { border: 1px solid #cdd4fa; background: #f5f6ff; }
  .peak-assistant-card__approval > div:not(.peak-assistant-card__badge) { display: grid; grid-template-columns: 1fr 1.4fr; gap: 7px; }
  .peak-assistant-card button { padding: 9px; border: 1px solid #d8d5ce; border-radius: 6px; background: #fff; color: #191919; font: 700 8px/1 Inter, Arial, sans-serif; }
  .peak-assistant-card__approval button:last-child,
  .peak-assistant-card__publish > button { border-color: #2845d6; background: #2845d6; color: #fff; }
  .peak-assistant-card__approval > em { color: #4c925f; font-size: 7px; font-style: normal; text-align: center; }

  .peak-assistant-card__publish > div:first-child,
  .peak-assistant-card__history { display: grid; grid-template-columns: 26px 1fr; align-items: center; gap: 8px; }
  .peak-assistant-card__publish > div:first-child > i { display: grid; width: 23px; height: 23px; place-items: center; border-radius: 50%; background: #53a86d; color: #fff; font-size: 8px; font-style: normal; }
  .peak-assistant-card__publish span { display: flex; flex-direction: column; }
  .peak-assistant-card__publish b { font-size: 8px; }
  .peak-assistant-card__publish p { margin: 4px 0; padding: 12px; border-radius: 7px; background: #f6f3ec; font-size: 9px; font-weight: 700; line-height: 1.4; }
  .peak-assistant-card__publish > small { color: #4c925f; text-align: center; }
  .peak-assistant-card__history { margin-top: 5px; padding-top: 10px; border-top: 1px solid #ece9e2; }
  .peak-assistant-card__history > i { background: #191919; color: #fff; }
</style>
