---
import ProductVisualFrame from "../ui/ProductVisualFrame.astro";
import type { Locale } from "../../i18n/config";

type Props = { locale?: Locale };
const { locale = "en" } = Astro.props;
const copy = locale === "fr" ? {
  ariaLabel: "Workflow de traduction Peak PIM montrant la couverture du catalogue, les brouillons générés par l'IA, la révision côte à côte et la publication multiboutique",
  section: "Traductions",
  status: "Brouillons révisés",
  action: "Publier les traductions",
  coverage: "Couverture des traductions",
  frenchGaps: "Français · 18 manquants",
  germanGaps: "Allemand · 11 manquants",
  health: "Analyse du Centre de contrôle",
  product: "Veste Alpine",
  view: "Français dans toutes les boutiques",
  sourceVisible: "Source visible",
  field: "Champ",
  source: "Source · EN",
  france: "France",
  international: "International",
  title: "Titre",
  seo: "Description SEO",
  option: "Valeur d'option",
  care: "Champ méta d'entretien",
  aiDraft: "Brouillon IA",
  findGaps: "Repérer les manques",
  fillDrafts: "L'IA prépare les brouillons",
  review: "Réviser avec la source",
  publish: "Publier",
} : {
  ariaLabel: "Peak PIM translation workflow showing catalog coverage, AI-generated drafts, side-by-side review, and multi-store publishing",
  section: "Translations",
  status: "Drafts reviewed",
  action: "Publish translations",
  coverage: "Translation coverage",
  frenchGaps: "French · 18 gaps",
  germanGaps: "German · 11 gaps",
  health: "Health Center analysis",
  product: "Alpine Jacket",
  view: "French across all stores",
  sourceVisible: "Source visible",
  field: "Field",
  source: "Source · EN",
  france: "France",
  international: "International",
  title: "Title",
  seo: "SEO description",
  option: "Option value",
  care: "Care metafield",
  aiDraft: "AI draft",
  findGaps: "Find gaps",
  fillDrafts: "AI fills drafts",
  review: "Review source",
  publish: "Publish",
};
---
<ProductVisualFrame ariaLabel={copy.ariaLabel} section={copy.section} status={copy.status} actionLabel={copy.action}>
  <div class="peak-tr-workspace">
    <aside class="peak-tr-health">
      <small>{copy.coverage}</small><strong>68%</strong><span><i style="width:68%"></i></span><b>{copy.frenchGaps}</b><b>{copy.germanGaps}</b><em>{copy.health}</em>
    </aside>
    <div class="peak-tr-main">
      <div class="peak-tr-heading"><div><small>{copy.product}</small><b>{copy.view}</b></div><span>{copy.sourceVisible}</span></div>
      <div class="peak-tr-grid">
        <div class="is-head"><span>{copy.field}</span><span>{copy.source}</span><span>{copy.france}</span><span>{copy.international}</span></div>
        <div><b>{copy.title}</b><span lang={locale === "fr" ? "en" : undefined}>Alpine Jacket</span><span>Veste Alpine</span><span>Veste Alpine</span></div>
        <div><b>{copy.seo}</b><span lang={locale === "fr" ? "en" : undefined}>Weather-ready shell…</span><span class="is-ai">Coque conçue pour… <em>{copy.aiDraft}</em></span><span class="is-ai">Coque conçue pour… <em>{copy.aiDraft}</em></span></div>
        <div><b>{copy.option}</b><span lang={locale === "fr" ? "en" : undefined}>Red</span><span>Rouge</span><span>Rouge</span></div>
        <div><b>{copy.care}</b><span lang={locale === "fr" ? "en" : undefined}>Cold wash</span><span class="is-ai">Lavage à froid <em>{copy.aiDraft}</em></span><span class="is-ai">Lavage à froid <em>{copy.aiDraft}</em></span></div>
      </div>
      <div class="peak-tr-flow"><span><i>1</i>{copy.findGaps}</span><span><i>2</i>{copy.fillDrafts}</span><span><i>3</i>{copy.review}</span><span class="is-ready"><i>4</i>{copy.publish}</span></div>
    </div>
  </div>
</ProductVisualFrame>
<style>
  .peak-tr-workspace{display:grid;min-height:440px;grid-template-columns:170px minmax(0,1fr);background:#f6f3ec;font-family:Inter,Arial,sans-serif}.peak-tr-health{display:flex;flex-direction:column;gap:9px;padding:26px 18px;border-right:1px solid #dfdcd5;background:#fbfaf7}.peak-tr-health small{color:#777;font-size:8px}.peak-tr-health strong{font-size:30px}.peak-tr-health>span{height:6px;overflow:hidden;border-radius:999px;background:#ddd}.peak-tr-health>span i{display:block;height:100%;border-radius:inherit;background:#2845d6}.peak-tr-health b{font-size:8px;font-weight:600}.peak-tr-health em{margin-top:auto;color:#2845d6;font-size:7px;font-style:normal}.peak-tr-main{min-width:0;padding:24px}.peak-tr-heading{display:flex;align-items:center;justify-content:space-between;margin-bottom:15px}.peak-tr-heading div{display:flex;flex-direction:column;gap:3px}.peak-tr-heading small{color:#777;font-size:8px}.peak-tr-heading b{font-size:13px}.peak-tr-heading>span{padding:6px 8px;border:1px solid #ddd;border-radius:5px;background:#fff;font-size:7px}.peak-tr-grid{overflow:hidden;border:1px solid #ddd;border-radius:7px;background:#fff}.peak-tr-grid>div{display:grid;grid-template-columns:86px repeat(3,1fr)}.peak-tr-grid>div+div{border-top:1px solid #e7e4de}.peak-tr-grid span,.peak-tr-grid b{min-width:0;padding:11px 9px;border-left:1px solid #eee;font-size:7px;font-weight:500}.peak-tr-grid b{border-left:0;background:#fbfaf7}.peak-tr-grid .is-head span{background:#191919;color:#aaa;font-weight:700}.peak-tr-grid .is-head span:first-child{border-left:0}.peak-tr-grid .is-ai{position:relative;background:#f2f4ff;color:#273baf}.peak-tr-grid em{display:block;margin-top:4px;color:#7080da;font-size:6px;font-style:normal}.peak-tr-flow{display:grid;margin-top:14px;grid-template-columns:repeat(4,1fr);border:1px solid #ddd;border-radius:7px;background:#fff}.peak-tr-flow span{display:flex;align-items:center;gap:5px;padding:10px 7px;font-size:7px}.peak-tr-flow span+span{border-left:1px solid #eee}.peak-tr-flow i{display:grid;width:17px;height:17px;place-items:center;border-radius:50%;background:#e9edff;color:#2845d6;font-style:normal}.peak-tr-flow .is-ready{color:#36874e}.peak-tr-flow .is-ready i{background:#dff1e4;color:#36874e}@media(max-width:767px){.peak-tr-workspace{min-height:395px;grid-template-columns:1fr}.peak-tr-health{display:none}.peak-tr-main{padding:16px}.peak-tr-grid>div{grid-template-columns:70px repeat(2,1fr)}.peak-tr-grid>div>*:last-child{display:none}.peak-tr-flow{grid-template-columns:repeat(2,1fr)}.peak-tr-flow span:nth-child(3){border-left:0;border-top:1px solid #eee}.peak-tr-flow span:nth-child(4){border-top:1px solid #eee}}@media(prefers-reduced-motion:no-preference){.peak-tr-grid .is-ai{animation:peak-tr-draft 3s ease-in-out infinite}@keyframes peak-tr-draft{50%{background:#e6eaff}}}@media(prefers-reduced-motion:reduce){.peak-tr-grid .is-ai{animation:none}}
</style>
