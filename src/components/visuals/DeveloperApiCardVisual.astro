---
type Props={mode:"query"|"update"|"publish"};const {mode}=Astro.props;
---
<div class:list={["peak-api-card",`is-${mode}`]} role="img" aria-label={mode==="query"?"Developer API query with filters and pagination":mode==="update"?"Developer API safe partial update with revision control":"Developer API multi-store publish pipeline"}>
  <div class="peak-api-card__bar"><i></i><i></i><i></i><span>{mode==="query"?"GET /products":mode==="update"?"PATCH /products/:id":"POST /publish"}</span></div>
  {mode==="query"&&<pre><code><b>GET</b> /v1/products
?search=alpine
&amp;store=fr
&amp;status=draft

<em>200</em> · 24 results
page 1 of 3</code></pre>}
  {mode==="update"&&<pre><code><b>PATCH</b> /stores/fr
If-Match: revision-42

title: "Veste Alpine"

<em>200</em> · revision-43
status: draft</code></pre>}
  {mode==="publish"&&<div class="peak-api-pipeline"><span><i>1</i><b>Validate</b><small>Master + versions</small></span><span><i>2</i><b>Publish</b><small>US · FR · DE</small></span><span><i>3</i><b>Sync</b><small>Variants + media</small></span><em>Completed through Peak pipeline</em></div>}
</div>
<style>
  .peak-api-card{min-height:300px;background:#151515;color:#ddd;font-family:ui-monospace,SFMono-Regular,Menlo,monospace}.peak-api-card__bar{display:flex;align-items:center;gap:6px;padding:14px 16px;border-bottom:1px solid #333}.peak-api-card__bar i{width:7px;height:7px;border-radius:50%;background:#666}.peak-api-card__bar span{margin-left:auto;color:#999;font-size:7px}.peak-api-card pre{margin:0;padding:28px;color:#ddd;font:9px/2 ui-monospace,SFMono-Regular,Menlo,monospace}.peak-api-card pre b{color:#91a3ff}.peak-api-card pre em{color:#91d0a5;font-style:normal}.peak-api-pipeline{display:grid;gap:10px;padding:26px}.peak-api-pipeline span{display:grid;grid-template-columns:28px 1fr;align-items:center;padding:12px;border:1px solid #333;border-radius:7px}.peak-api-pipeline span i{display:grid;width:22px;height:22px;grid-row:1/3;place-items:center;border-radius:50%;background:#2845d6;color:#fff;font-size:8px;font-style:normal}.peak-api-pipeline b{font:700 10px Inter,Arial,sans-serif}.peak-api-pipeline small{color:#888;font:7px Inter,Arial,sans-serif}.peak-api-pipeline>em{padding:9px;border-radius:5px;background:#203026;color:#91d0a5;font:normal 7px Inter,Arial,sans-serif;text-align:center}
</style>
