---
import ProductVisualFrame from "../ui/ProductVisualFrame.astro";
---

<ProductVisualFrame
  ariaLabel="Peak PIM Drop review showing scheduled Shopify price and product changes with automatic rollback"
  section="Drops"
  status="Scheduled · Nov 28, 00:01"
  actionLabel="Review Drop"
>
  <div class="peak-drop-workspace">
    <aside class="peak-drop-sidebar">
      <strong>Drops</strong>
      <span class="is-active"><i aria-hidden="true"></i>Black Friday</span>
      <span><i aria-hidden="true"></i>Winter launch</span>
      <span><i aria-hidden="true"></i>Weekend flash sale</span>
      <small>Lifecycle</small>
      <b>Scheduled</b>
      <b>Active</b>
      <b>History</b>
    </aside>

    <div class="peak-drop-main">
      <div class="peak-drop-heading">
        <div><small>Scheduled Drop</small><strong>Black Friday</strong></div>
        <em>Starts in 2d 08h</em>
      </div>

      <div class="peak-drop-window">
        <div><small>Starts</small><strong>Nov 28 · 00:01</strong></div>
        <span aria-hidden="true">→</span>
        <div><small>Reverts</small><strong>Dec 2 · 00:01</strong></div>
        <b>Europe / Paris</b>
      </div>

      <div class="peak-drop-summary">
        <span><small>Changes</small><strong>184</strong></span>
        <span><small>Stores</small><strong>3</strong></span>
        <span class="is-ready"><small>Conflicts</small><strong>0</strong></span>
      </div>

      <div class="peak-drop-table">
        <div class="peak-drop-row is-header"><span>Item</span><span>Store</span><span>Field</span><span>Live → scheduled</span></div>
        <div class="peak-drop-row"><span><i class="peak-drop-thumb"></i>Ridge Jacket</span><span><em>US</em></span><span>Price</span><span><del>$129</del><b>$99</b></span></div>
        <div class="peak-drop-row"><span><i class="peak-drop-thumb is-blue"></i>Trail Pack</span><span><em>FR</em></span><span>Compare-at</span><span><del>€120</del><b>€149</b></span></div>
        <div class="peak-drop-row"><span><i class="peak-drop-thumb is-sand"></i>Summit Cap</span><span><em>GB</em></span><span>Title</span><span><del>Summit Cap</del><b>Black Friday Cap</b></span></div>
      </div>

      <div class="peak-drop-restore"><i aria-hidden="true">↶</i><span>Current values will be captured at start time and restored automatically.</span></div>
    </div>
  </div>
</ProductVisualFrame>

<style>
  .peak-drop-workspace {
    display: grid;
    min-height: 440px;
    grid-template-columns: 156px minmax(0, 1fr);
    background: #f6f3ec;
  }

  .peak-drop-sidebar {
    display: flex;
    flex-direction: column;
    gap: 7px;
    padding: 22px 14px;
    border-right: 1px solid #e1ded7;
    background: #fbfaf7;
    color: #717171;
    font-size: 9px;
  }

  .peak-drop-sidebar > strong {
    margin: 0 8px 8px;
    color: #191919;
    font-size: 10px;
  }

  .peak-drop-sidebar > span {
    display: flex;
    align-items: center;
    gap: 8px;
    padding: 9px 8px;
    border-radius: 5px;
  }

  .peak-drop-sidebar > span i {
    width: 6px;
    height: 6px;
    flex: 0 0 auto;
    border-radius: 50%;
    background: #bbb;
  }

  .peak-drop-sidebar > span.is-active {
    background: #e9edff;
    color: #2845d6;
    font-weight: 700;
  }

  .peak-drop-sidebar > span.is-active i {
    background: #2845d6;
  }

  .peak-drop-sidebar > small {
    margin: 13px 8px 0;
    color: #999;
    font-size: 8px;
    text-transform: uppercase;
  }

  .peak-drop-sidebar > b {
    margin: 0 8px;
    color: #555;
    font-size: 8px;
    font-weight: 600;
  }

  .peak-drop-main {
    min-width: 0;
    padding: 24px;
  }

  .peak-drop-heading {
    display: flex;
    align-items: center;
    justify-content: space-between;
    padding-bottom: 15px;
    border-bottom: 1px solid #dedbd4;
  }

  .peak-drop-heading > div {
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .peak-drop-heading small,
  .peak-drop-window small,
  .peak-drop-summary small {
    color: #777;
    font-size: 8px;
  }

  .peak-drop-heading strong {
    font-size: 13px;
  }

  .peak-drop-heading > em {
    padding: 5px 8px;
    border-radius: 999px;
    background: #eef1ff;
    color: #2845d6;
    font-size: 8px;
    font-style: normal;
    font-weight: 700;
  }

  .peak-drop-window {
    display: grid;
    align-items: center;
    gap: 10px;
    margin: 18px 0 12px;
    padding: 12px;
    border: 1px solid #dedbd4;
    border-radius: 7px;
    background: #fff;
    grid-template-columns: minmax(0, 1fr) auto minmax(0, 1fr) auto;
  }

  .peak-drop-window > div {
    display: flex;
    min-width: 0;
    flex-direction: column;
    gap: 3px;
  }

  .peak-drop-window strong {
    overflow: hidden;
    font-size: 9px;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .peak-drop-window > span {
    color: #aaa;
  }

  .peak-drop-window > b {
    padding: 5px 7px;
    border-radius: 4px;
    background: #f3f1eb;
    color: #666;
    font-size: 7px;
  }

  .peak-drop-summary {
    display: grid;
    gap: 8px;
    margin-bottom: 12px;
    grid-template-columns: repeat(3, 1fr);
  }

  .peak-drop-summary > span {
    display: flex;
    align-items: center;
    justify-content: space-between;
    gap: 8px;
    padding: 9px 10px;
    border: 1px solid #dedbd4;
    border-radius: 6px;
    background: #fff;
  }

  .peak-drop-summary strong {
    font-size: 11px;
  }

  .peak-drop-summary .is-ready strong {
    color: #26854a;
  }

  .peak-drop-table {
    overflow: hidden;
    border: 1px solid #dedbd4;
    border-radius: 7px;
    background: #fff;
  }

  .peak-drop-row {
    display: grid;
    min-width: 0;
    align-items: center;
    gap: 10px;
    padding: 10px 12px;
    border-top: 1px solid #eceae5;
    font-size: 8px;
    grid-template-columns: 1.4fr 0.48fr 0.7fr 1.35fr;
  }

  .peak-drop-row.is-header {
    border-top: 0;
    background: #f8f7f3;
    color: #777;
    font-size: 7px;
    font-weight: 700;
    text-transform: uppercase;
  }

  .peak-drop-row > span {
    display: flex;
    min-width: 0;
    align-items: center;
    gap: 6px;
    overflow: hidden;
    text-overflow: ellipsis;
    white-space: nowrap;
  }

  .peak-drop-row em {
    display: inline-grid;
    min-width: 23px;
    height: 20px;
    place-items: center;
    border-radius: 4px;
    background: #f3f1eb;
    font-size: 7px;
    font-style: normal;
    font-weight: 700;
  }

  .peak-drop-row del {
    color: #999;
  }

  .peak-drop-row b {
    color: #2845d6;
    font-size: 8px;
  }

  .peak-drop-thumb {
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    border-radius: 3px;
    background: #202020;
  }

  .peak-drop-thumb.is-blue {
    background: #9db0cc;
  }

  .peak-drop-thumb.is-sand {
    background: #d3b898;
  }

  .peak-drop-restore {
    display: flex;
    align-items: center;
    gap: 8px;
    margin-top: 12px;
    padding: 9px 11px;
    border-radius: 6px;
    background: #eef7f0;
    color: #32744a;
    font-size: 8px;
  }

  .peak-drop-restore i {
    display: grid;
    width: 18px;
    height: 18px;
    flex: 0 0 auto;
    place-items: center;
    border-radius: 50%;
    background: #53a86d;
    color: #fff;
    font-size: 11px;
    font-style: normal;
    animation: peak-drop-ready 3.4s ease-in-out infinite;
  }

  @keyframes peak-drop-ready {
    0%, 70%, 100% { transform: rotate(0deg); }
    82% { transform: rotate(-28deg); }
  }

  @media (max-width: 767px) {
    .peak-drop-workspace {
      min-height: 365px;
      grid-template-columns: 1fr;
    }

    .peak-drop-sidebar {
      display: none;
    }

    .peak-drop-main {
      padding: 15px;
    }

    .peak-drop-window {
      grid-template-columns: 1fr auto 1fr;
    }

    .peak-drop-window > b {
      display: none;
    }

    .peak-drop-row {
      gap: 7px;
      padding: 9px;
      grid-template-columns: 1.25fr 0.42fr 0.72fr 1.2fr;
    }
  }

  @media (max-width: 479px) {
    .peak-drop-heading > em,
    .peak-drop-row span:nth-child(3),
    .peak-drop-row.is-header span:nth-child(3) {
      display: none;
    }

    .peak-drop-row {
      grid-template-columns: 1.3fr 0.45fr 1.25fr;
    }

    .peak-drop-restore span {
      line-height: 1.35;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .peak-drop-restore i {
      animation: none;
    }
  }
</style>
