---
type Props={mode:"market"|"catalog"|"prices"};
const {mode}=Astro.props;
---

<div class:list={["peak-mkt-card",`is-${mode}`]} role="img" aria-label={mode==="market"?"Market editor with countries, currency, and store coverage":mode==="catalog"?"Catalog editor with percentage pricing and selected product scope":"Fixed variant price editor with draft and stale currency states"}>
  {mode==="market"&&<div class="peak-mkt-market"><header><small>Market</small><b>Switzerland</b><em>Draft</em></header><label><small>Countries</small><span><i>CH</i>Switzerland</span></label><label><small>Display currency</small><span>CHF · Swiss franc</span></label><section><small>Stores</small><span><i>EU</i>Europe store<mark>✓</mark></span><span><i>UK</i>United Kingdom<mark>+</mark></span></section><button>Save market</button></div>}
  {mode==="catalog"&&<div class="peak-mkt-catalog"><header><small>Catalog</small><b>Switzerland retail</b><em>Ready</em></header><section><span><small>Currency</small><b>CHF</b></span><span><small>Price adjustment</small><b>+10%</b></span></section><div><small>Product scope</small><strong>Selected products</strong><span>Summit Shell Jacket <mark>Included</mark></span><span>Alpine Parka <mark>Included</mark></span><span>Trail Vest <mark>Staged</mark></span></div><button>Publish catalog</button></div>}
  {mode==="prices"&&<div class="peak-mkt-prices"><header><small>Variant · Switzerland</small><b>Summit Shell · Black · M</b></header><label><small>Fixed price</small><span>CHF 149.00</span></label><label><small>Compare-at price</small><span>CHF 169.00</span></label><section><span><i></i>Draft change</span><span class="is-stale"><i></i>Currency check passed</span></section><button>Save fixed price</button></div>}
</div>

<style>
  .peak-mkt-card{box-sizing:border-box;width:100%;min-height:300px;padding:25px;background:radial-gradient(#333 1px,transparent 1px),#191919;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-mkt-market,.peak-mkt-catalog,.peak-mkt-prices{display:grid;gap:9px}.peak-mkt-card header,.peak-mkt-market label,.peak-mkt-market section,.peak-mkt-catalog section,.peak-mkt-catalog>div,.peak-mkt-prices label,.peak-mkt-prices section{padding:11px;border-radius:7px;background:#fff}.peak-mkt-card header{display:grid;grid-template-columns:1fr auto}.peak-mkt-card header small{grid-column:1;color:#777;font-size:7px}.peak-mkt-card header b{grid-column:1;font-size:10px}.peak-mkt-card header em{grid-column:2;grid-row:1/3;align-self:center;padding:5px 7px;border-radius:999px;background:#edf6ef;color:#438258;font-size:6px;font-style:normal}.peak-mkt-card label{display:flex;flex-direction:column;gap:5px}.peak-mkt-card label small,.peak-mkt-card section small,.peak-mkt-catalog>div>small{color:#777;font-size:7px}.peak-mkt-card label span{display:flex;align-items:center;gap:6px;font-size:8px}.peak-mkt-card i{display:grid;width:22px;height:22px;place-items:center;border-radius:4px;background:#191919;color:#fff;font:normal 6px Inter,Arial,sans-serif}.peak-mkt-market section{display:grid;gap:6px}.peak-mkt-market section>span{display:grid;align-items:center;gap:6px;grid-template-columns:22px 1fr auto;font-size:7px}.peak-mkt-market mark,.peak-mkt-catalog mark{background:transparent;color:#438258;font-size:7px}.peak-mkt-card button{padding:11px;border:0;border-radius:7px;background:#2845d6;color:#fff;font:700 8px Inter,Arial,sans-serif}.peak-mkt-catalog section{display:grid;grid-template-columns:1fr 1fr}.peak-mkt-catalog section span{display:flex;flex-direction:column;gap:4px}.peak-mkt-catalog section b{font-size:9px}.peak-mkt-catalog>div{display:grid;gap:7px}.peak-mkt-catalog>div strong{font-size:8px}.peak-mkt-catalog>div span{display:flex;justify-content:space-between;font-size:7px}.peak-mkt-catalog>div span:last-child mark{color:#2845d6}.peak-mkt-prices label span{padding:7px;border:1px solid #dedbd3;border-radius:5px;background:#f7f5ef}.peak-mkt-prices section{display:flex;justify-content:space-between;gap:7px}.peak-mkt-prices section span{display:flex;align-items:center;gap:4px;color:#777;font-size:6px}.peak-mkt-prices section i{width:6px;height:6px;border-radius:50%;background:#e2a64a}.peak-mkt-prices section .is-stale i{background:#4f9b64}
  @media(prefers-reduced-motion:no-preference){.peak-mkt-prices section .is-stale{animation:peak-mkt-check 3s ease-in-out infinite}@keyframes peak-mkt-check{50%{color:#367647;transform:translateY(-1px)}}}
  @media(prefers-reduced-motion:reduce){.peak-mkt-prices section .is-stale{animation:none}}
</style>
