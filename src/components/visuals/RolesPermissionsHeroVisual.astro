---
import ProductVisualFrame from "../ui/ProductVisualFrame.astro";
---
<ProductVisualFrame ariaLabel="Peak PIM users and permissions workspace showing a catalog editor with selected stores and separate view, edit, and publish access" section="Users & permissions" status="Access updated" actionLabel="Invite user">
  <div class="peak-rp-workspace">
    <aside class="peak-rp-users"><div><small>Workspace users</small><b>8 active</b></div><span><i>AM</i><b>Alex Morgan</b><small>Workspace owner</small></span><span class="active"><i>SL</i><b>Sam Lee</b><small>Catalog editor</small></span><span><i>MP</i><b>Maya Patel</b><small>Agency partner</small></span><button>+ Add user</button></aside>
    <div class="peak-rp-main"><div class="peak-rp-heading"><div><small>User access</small><b>Sam Lee</b></div><em>Active</em></div><div class="peak-rp-panels"><section><small>Role</small><h3>Catalog editor</h3><p>Work on product information without workspace administration.</p><div class="peak-rp-perms"><span><i>✓</i><b>View catalog</b><em>Allowed</em></span><span><i>✓</i><b>Edit drafts</b><em>Allowed</em></span><span><i>×</i><b>Publish to stores</b><em>Not allowed</em></span><span><i>×</i><b>Manage users</b><em>Not allowed</em></span></div></section><section class="peak-rp-stores"><small>Store access</small><span><i>US</i><b>United States</b><em>View only</em></span><span class="selected"><i>FR</i><b>France</b><em>Edit</em></span><span class="selected"><i>DE</i><b>Germany</b><em>Edit</em></span><div><b>2 of 3 stores selected</b><small>Changes stay as drafts</small></div></section></div></div>
  </div>
</ProductVisualFrame>
<style>
  .peak-rp-workspace{display:grid;min-height:440px;grid-template-columns:190px minmax(0,1fr);background:#f6f3ec;font-family:Inter,Arial,sans-serif}.peak-rp-users{display:flex;flex-direction:column;gap:8px;padding:22px 14px;border-right:1px solid #ddd;background:#fbfaf7}.peak-rp-users>div{display:flex;justify-content:space-between;padding:0 8px 10px}.peak-rp-users small{color:#777;font-size:7px}.peak-rp-users b{font-size:8px}.peak-rp-users>span{display:grid;padding:9px;border-radius:6px;grid-template-columns:29px 1fr}.peak-rp-users>span.active{background:#e9edff;color:#2845d6}.peak-rp-users i{display:grid;width:24px;height:24px;grid-row:1/3;place-items:center;border-radius:50%;background:#191919;color:#fff;font-size:7px;font-style:normal}.peak-rp-users>span small{grid-column:2}.peak-rp-users button{margin-top:auto;padding:10px;border:1px solid #ddd;border-radius:6px;background:#fff;font:700 8px Inter,Arial,sans-serif}.peak-rp-main{min-width:0;padding:24px}.peak-rp-heading{display:flex;align-items:center;justify-content:space-between;padding-bottom:15px;border-bottom:1px solid #ddd}.peak-rp-heading div{display:flex;flex-direction:column}.peak-rp-heading small{color:#777;font-size:8px}.peak-rp-heading b{font-size:13px}.peak-rp-heading em{padding:6px 8px;border-radius:999px;background:#e5f1e8;color:#3b8150;font-size:7px;font-style:normal}.peak-rp-panels{display:grid;gap:14px;margin-top:18px;grid-template-columns:minmax(0,1fr) 165px}.peak-rp-panels section{padding:16px;border:1px solid #ddd;border-radius:7px;background:#fff}.peak-rp-panels section>small{color:#777;font-size:7px}.peak-rp-panels h3{margin:5px 0;font-size:12px}.peak-rp-panels p{margin:0 0 12px;color:#666;font-size:8px}.peak-rp-perms{display:grid;gap:6px}.peak-rp-perms span,.peak-rp-stores>span{display:grid;align-items:center;padding:8px;border-radius:5px;background:#f6f3ec;grid-template-columns:22px 1fr}.peak-rp-perms i{grid-row:1/3;color:#3d8752;font-style:normal}.peak-rp-perms b,.peak-rp-stores b{font-size:8px}.peak-rp-perms em,.peak-rp-stores em{grid-column:3;grid-row:1;color:#777;font-size:7px;font-style:normal}.peak-rp-stores{display:flex;flex-direction:column;gap:7px}.peak-rp-stores>span{grid-template-columns:25px 1fr}.peak-rp-stores>span i{display:grid;width:21px;height:21px;grid-row:1/3;place-items:center;border-radius:4px;background:#191919;color:#fff;font-size:7px;font-style:normal}.peak-rp-stores>span.selected{outline:1px solid #7183df;background:#f0f2ff}.peak-rp-stores>div{margin-top:auto;padding:9px;border-radius:5px;background:#e5f1e8}.peak-rp-stores>div b,.peak-rp-stores>div small{display:block;color:#397c4d;font-size:7px}@media(max-width:767px){.peak-rp-workspace{min-height:395px;grid-template-columns:1fr}.peak-rp-users{display:none}.peak-rp-main{padding:16px}.peak-rp-panels{grid-template-columns:1fr}.peak-rp-stores{display:grid;grid-template-columns:repeat(3,1fr)}.peak-rp-stores>small,.peak-rp-stores>div{grid-column:1/-1}.peak-rp-stores>span{padding:6px;grid-template-columns:20px 1fr}.peak-rp-stores>span i{width:17px;height:17px}.peak-rp-stores>span em{display:none}}@media(prefers-reduced-motion:no-preference){.peak-rp-users>span.active{animation:peak-rp-focus 2.5s ease-in-out infinite}@keyframes peak-rp-focus{50%{box-shadow:inset 3px 0 #2845d6}}}@media(prefers-reduced-motion:reduce){.peak-rp-users>span.active{animation:none}}
</style>
