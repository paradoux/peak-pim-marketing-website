<style is:global>
.ppim-sn{--ppim-sn-bg:#1C1C1C;position:relative;width:100%;aspect-ratio:1/1;overflow:hidden;background:var(--ppim-sn-bg) radial-gradient(rgba(255,255,255,.07) 1px,transparent 1.2px) 0 0/14px 14px;font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;color:#2C2C2A;-webkit-font-smoothing:antialiased;text-align:left;line-height:1.3}
.ppim-sn *{box-sizing:border-box}
.ppim-sn-canvas{position:absolute;left:0;top:0;width:360px;height:360px;transform-origin:0 0;transition:opacity .6s ease}
.ppim-sn-canvas.is-dim{opacity:0}
.ppim-sn-lines{position:absolute;inset:0;width:360px;height:360px;overflow:visible}
.ppim-sn-path{fill:none;stroke:rgba(255,255,255,.3);stroke-width:1.5;stroke-dasharray:3 4;transition:stroke .5s ease;animation:ppim-sn-dash 1.6s linear infinite}
.ppim-sn-path.is-live{stroke:rgba(123,149,240,.75)}
.ppim-sn-tile{position:absolute;width:76px;height:76px;border-radius:18px;background:#fff;display:flex;align-items:center;justify-content:center;box-shadow:0 8px 24px rgba(0,0,0,.35);transition:transform .3s ease}
.ppim-sn-tile.is-pulse{transform:scale(1.06)}
.ppim-sn-cap{position:absolute;width:110px;text-align:center;font-size:11px;color:rgba(255,255,255,.6)}
.ppim-sn-card{position:absolute;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 10px 30px rgba(0,0,0,.4)}
.ppim-sn-spin{display:inline-block;width:10px;height:10px;border-radius:50%;border:1.5px solid #2845D6;border-top-color:transparent;animation:ppim-sn-spin 1s linear infinite;flex-shrink:0}
.ppim-sn-spin-d{border-color:#2C2C2A;border-top-color:transparent}
.ppim-sn-cursor{position:absolute;left:0;top:0;z-index:5;opacity:0;pointer-events:none;transform:translate(330px,400px);transition:transform var(--ppim-sn-d,600ms) cubic-bezier(.45,0,.2,1),opacity .3s ease;filter:drop-shadow(0 2px 3px rgba(0,0,0,.4))}
.ppim-sn-cursor svg{display:block;transition:transform .14s ease;transform-origin:3px 2px}
.ppim-sn-cursor.is-on{opacity:1}
.ppim-sn-cursor.is-press svg{transform:scale(.86)}
.ppim-sn-ripple{position:absolute;left:0;top:0;width:30px;height:30px;margin:-15px 0 0 -15px;border-radius:50%;border:2px solid #7B95F0;opacity:0;pointer-events:none;z-index:4}
.ppim-sn-ripple.is-go{animation:ppim-sn-ripple .55s ease-out}

/* 1. connect */
.ppim-sn-c-shop{left:66px;top:90px}
.ppim-sn-c-peak{left:218px;top:90px}
.ppim-sn-badge{position:absolute;right:-7px;top:-7px;width:24px;height:24px;border-radius:50%;background:#1D9E75;border:2px solid #1C1C1C;display:flex;align-items:center;justify-content:center;transform:scale(0);transition:transform .35s cubic-bezier(.3,1.6,.5,1)}
.ppim-sn-c-shop.is-done .ppim-sn-badge{transform:scale(1)}
.ppim-sn-c-cap1{left:49px;top:176px}
.ppim-sn-c-cap2{left:201px;top:176px}
.ppim-sn-cbtn{position:absolute;left:88px;top:222px;width:184px;height:46px;border-radius:23px;background:#fff;display:flex;align-items:center;justify-content:center;gap:8px;font-size:12px;font-weight:600;letter-spacing:.08em;text-transform:uppercase;color:#1a1a1a;box-shadow:0 8px 24px rgba(0,0,0,.35);transition:transform .12s ease,color .3s ease}
.ppim-sn-cbtn.is-pressed{transform:scale(.96)}
.ppim-sn-cbtn .ppim-sn-spin,.ppim-sn-cbtn-ic{display:none}
.ppim-sn-cbtn.is-busy .ppim-sn-spin{display:inline-block}
.ppim-sn-cbtn.is-done{color:#0F6E56}
.ppim-sn-cbtn.is-done .ppim-sn-cbtn-ic{display:inline-flex}
.ppim-sn-ccount{position:absolute;left:0;right:0;top:290px;text-align:center;font-size:12px;color:rgba(255,255,255,.65);opacity:0;transform:translateY(6px);transition:opacity .4s ease,transform .4s ease}
.ppim-sn-ccount b{color:#fff;font-weight:600;font-variant-numeric:tabular-nums}
.ppim-sn-ccount.is-on{opacity:1;transform:none}

/* 2. two-way sync */
.ppim-sn-s-pim{left:24px;top:22px;width:312px}
.ppim-sn-s-shop{left:24px;top:218px;width:312px}
.ppim-sn-chead{height:34px;display:flex;align-items:center;gap:7px;padding:0 12px;border-bottom:1px solid #EEEAE0}
.ppim-sn-chead b{font-size:12px;font-weight:600}
.ppim-sn-chead span{margin-left:auto;font-size:10.5px;color:#8A8983}
.ppim-sn-rows{display:grid;gap:6px;padding:9px 12px 11px}
.ppim-sn-row{display:grid;grid-template-columns:44px 1fr;gap:8px;align-items:center}
.ppim-sn-lbl{font-size:9px;font-weight:500;letter-spacing:.05em;text-transform:uppercase;color:#8A8983}
.ppim-sn-in{position:relative;height:30px;display:flex;align-items:center;padding:0 10px;background:#F8F7F3;border:1px solid #E8E6DE;border-radius:6px;font-size:12px;white-space:nowrap;overflow:hidden;transition:background .3s ease,border-color .3s ease,color .3s ease}
.ppim-sn-v{border-radius:3px;transition:background-color 1.4s ease,opacity .25s ease}
.ppim-sn-v.is-sel{background:#C9D3FB;transition:none}
.ppim-sn-v.is-hl-c{background-color:rgba(40,69,214,.16);transition:none}
.ppim-sn-v.is-hl-g{background-color:rgba(29,158,117,.18);transition:none}
.ppim-sn-caret{display:none;width:1.5px;height:14px;background:#2845D6;margin-left:1px;animation:ppim-sn-blink 1s step-end infinite}
.ppim-sn-row.is-focus .ppim-sn-in{background:#EEF1FE;border-color:#2845D6;color:#1A2CA3}
.ppim-sn-row.is-focus .ppim-sn-caret{display:block}
.ppim-sn-pill{position:absolute;top:168px;height:24px;display:flex;align-items:center;gap:5px;padding:0 10px;border-radius:99px;background:#2A2A28;border:1px solid rgba(255,255,255,.14);color:rgba(255,255,255,.7);font-size:10.5px;font-weight:500;transform:translateX(-50%);transition:background .3s ease,color .3s ease,border-color .3s ease}
.ppim-sn-s-push{left:104px}
.ppim-sn-s-pull{left:256px}
.ppim-sn-s-push.is-on{background:#2845D6;border-color:#2845D6;color:#fff}
.ppim-sn-s-pull.is-on{background:#1D9E75;border-color:#1D9E75;color:#fff}

/* 3. scale */
.ppim-sn-stores{position:absolute;left:30px;top:20px;width:300px;display:grid;grid-template-columns:repeat(3,1fr)}
.ppim-sn-st{display:flex;flex-direction:column;align-items:center;gap:7px}
.ppim-sn-tile.ppim-sn-tile-s{position:relative;width:50px;height:50px;border-radius:13px}
.ppim-sn-code{min-width:34px;height:20px;padding:0 6px;border-radius:5px;background:#fff;font-size:10px;font-weight:600;display:flex;align-items:center;justify-content:center}
.ppim-sn-node{position:absolute;left:50%;top:146px;transform:translateX(-50%);height:34px;display:flex;align-items:center;gap:7px;padding:0 14px;border-radius:99px;background:#fff;box-shadow:0 8px 24px rgba(0,0,0,.35);white-space:nowrap}
.ppim-sn-node b{font-size:12px;font-weight:600}
.ppim-sn-node-s{position:relative;width:132px;height:16px;margin-left:3px;padding-left:10px;border-left:1px solid #E8E6DE}
.ppim-sn-node-s>span{position:absolute;left:10px;top:0;height:16px;display:inline-flex;align-items:center;gap:5px;font-size:11px;transition:opacity .35s ease}
.ppim-sn-node-busy{color:#1A2CA3;font-weight:500}
.ppim-sn-node-done{color:#0F6E56;font-weight:500;opacity:0}
.ppim-sn-node.is-done .ppim-sn-node-busy{opacity:0}
.ppim-sn-node.is-done .ppim-sn-node-done{opacity:1}
.ppim-sn-cat{left:24px;top:198px;width:312px}
.ppim-sn[data-anim="scale"] .ppim-sn-path{animation:none}
.ppim-sn-grid{display:grid;grid-template-columns:1fr 1fr;gap:4px 14px;padding:10px 14px}
.ppim-sn-cell{display:flex;align-items:center;gap:7px;height:27px;border-bottom:1px solid #F4F1EA}
.ppim-sn-ck{position:relative;width:13px;height:13px;flex-shrink:0}
.ppim-sn-ck svg{position:absolute;left:0;top:0;display:block;transition:opacity .25s ease,transform .3s cubic-bezier(.3,1.6,.5,1)}
.ppim-sn-ck-1{opacity:0;transform:scale(.4)}
.ppim-sn-cell.is-done .ppim-sn-ck-0{opacity:0}
.ppim-sn-cell.is-done .ppim-sn-ck-1{opacity:1;transform:none}
.ppim-sn-cl{flex:1;font-size:11.5px;color:#6B6B6B;transition:color .3s ease}
.ppim-sn-cell.is-on .ppim-sn-cl{color:#2C2C2A}
.ppim-sn-cn{font-size:11.5px;font-weight:600;color:#C4C0B6;font-variant-numeric:tabular-nums;transition:color .3s ease}
.ppim-sn-cell.is-on .ppim-sn-cn{color:#2C2C2A}

@keyframes ppim-sn-spin{to{transform:rotate(360deg)}}
@keyframes ppim-sn-blink{0%,50%{opacity:1}50.01%,100%{opacity:0}}
@keyframes ppim-sn-dash{to{stroke-dashoffset:-14}}
@keyframes ppim-sn-ripple{0%{transform:scale(.3);opacity:.6}100%{transform:scale(1.2);opacity:0}}
@media (prefers-reduced-motion:reduce){.ppim-sn-path,.ppim-sn-spin,.ppim-sn-caret{animation:none}}
</style>
<script>
(function(){
  /* PACE: one knob for all three animations. Lower is faster, higher is slower. */
  var PACE=1.3;
  var W=360;
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var T=function(ms){return Math.round(ms*PACE)};
  var sleep=function(ms){return new Promise(function(r){setTimeout(r,T(ms))})};
  var later=function(fn,ms){setTimeout(fn,T(ms))};
  var fmt=function(n){return Math.round(n).toString().replace(/\B(?=(\d{3})+(?!\d))/g,',')};
  function tween(from,to,ms,fn){var d=T(ms),t0=performance.now();return new Promise(function(res){(function step(now){var k=Math.min(1,(now-t0)/d),e=1-Math.pow(1-k,3);fn(from+(to-from)*e);if(k<1)requestAnimationFrame(step);else res()})(t0)})}

  function setup(root){
    if(root.getAttribute('data-ready'))return;root.setAttribute('data-ready','1');
    var canvas=root.querySelector('.ppim-sn-canvas'),scale=1;
    var q=function(s){return root.querySelector(s)},qa=function(s){return Array.prototype.slice.call(root.querySelectorAll(s))};
    function fit(){scale=root.clientWidth/W||1;canvas.style.transform='scale('+scale+')'}
    if(window.ResizeObserver)new ResizeObserver(fit).observe(root);else window.addEventListener('resize',fit);fit();
    var visible=true,waiters=[];
    if(window.IntersectionObserver)new IntersectionObserver(function(e){visible=e[0].isIntersecting;if(visible){waiters.forEach(function(w){w()});waiters=[]}}).observe(root);
    function whenVisible(){return visible&&!document.hidden?Promise.resolve():new Promise(function(r){waiters.push(r);document.addEventListener('visibilitychange',function h(){if(!document.hidden&&visible){document.removeEventListener('visibilitychange',h);r()}})})}
    function rel(el,fx,fy){var b=canvas.getBoundingClientRect(),r=el.getBoundingClientRect();return {x:(r.left-b.left+r.width*fx)/scale,y:(r.top-b.top+r.height*fy)/scale}}
    var cursor=q('.ppim-sn-cursor'),ripple=q('.ppim-sn-ripple');
    function cursorTo(p,ms){if(!cursor)return;cursor.style.setProperty('--ppim-sn-d',T(ms||0)+'ms');cursor.style.transform='translate('+(p.x-3)+'px,'+(p.y-2)+'px)'}
    async function moveTo(el,ms,fx,fy){cursorTo(rel(el,fx == null ? .5 : fx,fy == null ? .5 : fy),ms);await sleep(ms)}
    async function click(el,fx,fy){var p=rel(el,fx == null ? .5 : fx,fy == null ? .5 : fy);cursor.classList.add('is-press');el.classList.add('is-pressed');ripple.style.left=p.x+'px';ripple.style.top=p.y+'px';ripple.classList.remove('is-go');void ripple.offsetWidth;ripple.classList.add('is-go');await sleep(110);cursor.classList.remove('is-press');el.classList.remove('is-pressed');await sleep(80)}
    function dot(path,dur,color,rev){
      var ns='http://www.w3.org/2000/svg',g=q('.ppim-sn-dots'),len=path.getTotalLength(),d=T(dur);
      var glow=document.createElementNS(ns,'circle'),core=document.createElementNS(ns,'circle');
      glow.setAttribute('r',12);glow.setAttribute('fill',color);glow.setAttribute('fill-opacity',.28);core.setAttribute('r',3.5);core.setAttribute('fill',color);g.appendChild(glow);g.appendChild(core);
      var t0=performance.now();
      return new Promise(function(res){(function step(now){var k=Math.min(1,(now-t0)/d),e=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2,pt=path.getPointAtLength(len*(rev?1-e:e)),o=k<.12?k/.12:k>.88?(1-k)/.12:1;
        [glow,core].forEach(function(n){n.setAttribute('cx',pt.x);n.setAttribute('cy',pt.y);n.setAttribute('opacity',o)});
        if(k<1)requestAnimationFrame(step);else{glow.remove();core.remove();res()}})(t0)});
    }
    async function typeInto(row,text,speed){
      var v=row.querySelector('.ppim-sn-v'),inp=row.querySelector('.ppim-sn-in');
      await moveTo(inp,480,.6,.55);await click(inp,.6,.55);row.classList.add('is-focus');
      v.classList.add('is-sel');await sleep(260);v.classList.remove('is-sel');v.textContent='';
      for(var i=1;i<=text.length;i++){v.textContent=text.slice(0,i);await sleep(speed||26)}
      await sleep(160);row.classList.remove('is-focus');
    }
    function hl(v,cls){v.classList.add(cls);requestAnimationFrame(function(){requestAnimationFrame(function(){v.classList.remove(cls)})})}
    function swap(v,text,cls){v.style.opacity=0;later(function(){v.textContent=text;v.style.opacity=1;v.classList.add(cls);later(function(){v.classList.remove(cls)},350)},220)}

    var A={};
    /* ---------- 1. one-click connection ---------- */
    A.connect={
      init:function(){this.shop=q('.ppim-sn-c-shop');this.peak=q('.ppim-sn-c-peak');this.btn=q('.ppim-sn-cbtn');this.bt=q('.ppim-sn-cbtn-t');this.cnt=q('.ppim-sn-ccount');this.cn=q('.ppim-sn-ccount b');this.path=q('.ppim-sn-path')},
      reset:function(){this.shop.classList.remove('is-done');this.btn.className='ppim-sn-cbtn';this.bt.textContent='Connect store';this.cnt.classList.remove('is-on');this.cn.textContent='0';this.path.classList.remove('is-live');cursor.classList.remove('is-on');cursorTo({x:330,y:400},0)},
      final:function(){this.shop.classList.add('is-done');this.btn.className='ppim-sn-cbtn is-done';this.bt.textContent='Connected';this.cnt.classList.add('is-on');this.cn.textContent='2,847';this.path.classList.add('is-live')},
      run:async function(){
        var s=this;await sleep(600);cursor.classList.add('is-on');
        await moveTo(s.btn,700,.72,.6);await click(s.btn,.72,.6);
        s.btn.className='ppim-sn-cbtn is-busy';s.bt.textContent='Connecting';later(function(){cursor.classList.remove('is-on')},400);
        s.path.classList.add('is-live');
        await dot(s.path,800,'#95BF47');
        s.peak.classList.add('is-pulse');later(function(){s.peak.classList.remove('is-pulse')},220);
        s.shop.classList.add('is-done');s.btn.className='ppim-sn-cbtn is-done';s.bt.textContent='Connected';
        s.cnt.classList.add('is-on');
        var flow=true;(async function(){while(flow){await dot(s.path,800,'#95BF47');s.peak.classList.add('is-pulse');later(function(){s.peak.classList.remove('is-pulse')},200)}})();
        await tween(0,2847,1500,function(v){s.cn.textContent=fmt(v)});
        flow=false;await sleep(2400);
      }
    };
    /* ---------- 2. two-way sync ---------- */
    A.sync={
      init:function(){
        this.pim=q('.ppim-sn-s-pim');this.shop=q('.ppim-sn-s-shop');this.paths=qa('.ppim-sn-path');this.push=q('.ppim-sn-s-push');this.pull=q('.ppim-sn-s-pull');
        this.r={pimTitle:this.pim.querySelector('[data-k="title"]'),pimPrice:this.pim.querySelector('[data-k="price"]'),shopTitle:this.shop.querySelector('[data-k="title"]'),shopPrice:this.shop.querySelector('[data-k="price"]')};
      },
      reset:function(){var r=this.r;r.pimTitle.querySelector('.ppim-sn-v').textContent='PeakPro Freeride X';r.shopTitle.querySelector('.ppim-sn-v').textContent='PeakPro Freeride X';r.pimPrice.querySelector('.ppim-sn-v').textContent='$189.00';r.shopPrice.querySelector('.ppim-sn-v').textContent='$189.00';this.push.classList.remove('is-on');this.pull.classList.remove('is-on');this.paths.forEach(function(p){p.classList.remove('is-live')});cursor.classList.remove('is-on');cursorTo({x:330,y:400},0)},
      final:function(){var r=this.r;r.pimTitle.querySelector('.ppim-sn-v').textContent='PeakPro Freeride X Goggles';r.shopTitle.querySelector('.ppim-sn-v').textContent='PeakPro Freeride X Goggles';r.pimPrice.querySelector('.ppim-sn-v').textContent='$179.00';r.shopPrice.querySelector('.ppim-sn-v').textContent='$179.00'},
      run:async function(){
        var s=this,r=s.r;await sleep(600);cursor.classList.add('is-on');
        // edit in Peak PIM, push to Shopify
        await typeInto(r.pimPrice,'$179.00',40);
        s.push.classList.add('is-on');s.paths[0].classList.add('is-live');
        await dot(s.paths[0],800,'#7B95F0');
        swap(r.shopPrice.querySelector('.ppim-sn-v'),'$179.00','is-hl-c');
        await sleep(500);s.push.classList.remove('is-on');s.paths[0].classList.remove('is-live');
        await sleep(500);
        // change in Shopify, refresh into Peak PIM
        await typeInto(r.shopTitle,'PeakPro Freeride X Goggles',24);
        later(function(){cursor.classList.remove('is-on')},200);
        s.pull.classList.add('is-on');s.paths[1].classList.add('is-live');
        await dot(s.paths[1],800,'#3FC59A');
        swap(r.pimTitle.querySelector('.ppim-sn-v'),'PeakPro Freeride X Goggles','is-hl-g');
        await sleep(500);s.pull.classList.remove('is-on');s.paths[1].classList.remove('is-live');
        await sleep(2200);
      }
    };
    /* ---------- 3. all your Shopify data ---------- */
    A.scale={
      init:function(){this.tiles=qa('.ppim-sn-tile-s');this.codes=qa('.ppim-sn-code');this.node=q('.ppim-sn-node');this.paths=qa('.ppim-sn-path');this.cells=qa('.ppim-sn-cell')},
      layout:function(){var s=this,to=rel(s.node,.5,0);to.y-=3;s.codes.forEach(function(c,i){var a=rel(c,.5,1);a.y+=4;var my=(a.y+to.y)/2;s.paths[i].setAttribute('d','M '+a.x+' '+a.y+' C '+a.x+' '+my+', '+to.x+' '+my+', '+to.x+' '+to.y)})},
      reset:function(){this.layout();this.node.classList.remove('is-done');this.cells.forEach(function(c){c.classList.remove('is-on','is-done');c.querySelector('.ppim-sn-cn').textContent='0'});this.paths.forEach(function(p){p.classList.remove('is-live')})},
      final:function(){this.layout();this.node.classList.add('is-done');this.cells.forEach(function(c){c.classList.add('is-on','is-done');c.querySelector('.ppim-sn-cn').textContent=fmt(+c.getAttribute('data-n'))})},
      run:async function(){
        var s=this;await sleep(500);
        s.paths.forEach(function(p){p.classList.add('is-live')});
        var flow=true;
        /* each store alternates: Shopify data down into Peak PIM (green), Peak PIM changes back up (cobalt) */
        s.paths.forEach(function(p,i){(async function(){await sleep(i*260);var up=false;while(flow){
          if(!up){s.tiles[i].classList.add('is-pulse');later(function(){s.tiles[i].classList.remove('is-pulse')},200)}
          await dot(p,750,up?'#7B95F0':'#95BF47',up);
          if(up){s.tiles[i].classList.add('is-pulse');later(function(){s.tiles[i].classList.remove('is-pulse')},200)}
          up=!up;await sleep(110)}})()});
        await sleep(700);
        for(var i=0;i<s.cells.length;i++){
          (function(c){c.classList.add('is-on');tween(0,+c.getAttribute('data-n'),650,function(v){c.querySelector('.ppim-sn-cn').textContent=fmt(v)}).then(function(){c.classList.add('is-done')})})(s.cells[i]);
          await sleep(320);
        }
        await sleep(1400);flow=false;
        s.node.classList.add('is-done');
        await sleep(900);s.paths.forEach(function(p){p.classList.remove('is-live')});
        await sleep(1800);
      }
    };

    var a=A[root.getAttribute('data-anim')];if(!a)return;a.init();
    function start(){fit();a.reset();if(reduce){a.final();return}loop()}
    async function loop(){for(;;){await whenVisible();a.reset();canvas.classList.remove('is-dim');await a.run();canvas.classList.add('is-dim');await sleep(500)}}
    if(document.fonts&&document.fonts.ready)document.fonts.ready.then(start);else start();
  }
  Array.prototype.forEach.call(document.querySelectorAll('.ppim-sn[data-anim]'),setup);
})();
</script>
