---
type Props={mode:"invite"|"assign"|"review"};const {mode}=Astro.props;
---
<div class:list={["peak-rp-card",`is-${mode}`]} role="img" aria-label={mode==="invite"?"Invite user form for a merchandising team member":mode==="assign"?"Role assignment with catalog, publishing, and administration permissions":"User access overview with active and removed users"}>
  {mode==="invite"&&<div class="peak-rp-invite"><div><small>Invite user</small><b>merchandising@brand.com</b></div><label><small>Role</small><span>Catalog editor</span></label><label><small>Stores</small><span>France · Germany</span></label><label><small>Access starts</small><span>Immediately</span></label><button>Send invitation</button></div>}
  {mode==="assign"&&<div class="peak-rp-assign"><div><small>Catalog editor</small><b>Permission summary</b></div><span><i>✓</i><b>View catalog</b><em>On</em></span><span><i>✓</i><b>Edit drafts</b><em>On</em></span><span><i>×</i><b>Publish changes</b><em>Off</em></span><span><i>×</i><b>Manage workspace</b><em>Off</em></span><button>Save role</button></div>}
  {mode==="review"&&<div class="peak-rp-review"><div><small>Access review</small><b>8 users · 3 roles</b></div><span><i>AM</i><b>Workspace owner</b><em>All stores</em></span><span><i>SL</i><b>Catalog editor</b><em>FR · DE</em></span><span><i>MP</i><b>Agency partner</b><em>US · View</em></span><section><b>1 invitation pending</b><small>Access can be changed or removed</small></section></div>}
</div>
<style>
  .peak-rp-card{box-sizing:border-box;width:100%;min-height:300px;padding:25px;background:radial-gradient(#333 1px,transparent 1px),#191919;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-rp-invite,.peak-rp-assign,.peak-rp-review{display:grid;gap:9px}.peak-rp-card div>div,.peak-rp-card label,.peak-rp-card div>span,.peak-rp-review section{padding:12px;border-radius:7px;background:#fff}.peak-rp-card div>div{display:flex;flex-direction:column}.peak-rp-card small{color:#777;font-size:7px}.peak-rp-card b{font-size:9px}.peak-rp-card label{display:flex;justify-content:space-between}.peak-rp-card label span{font-size:8px}.peak-rp-card button{padding:11px;border:0;border-radius:7px;background:#2845d6;color:#fff;font:700 8px Inter,Arial,sans-serif}.peak-rp-assign>span,.peak-rp-review>span{display:grid;align-items:center;grid-template-columns:28px 1fr}.peak-rp-assign>span i,.peak-rp-review>span i{display:grid;width:23px;height:23px;grid-row:1/3;place-items:center;border-radius:50%;background:#191919;color:#fff;font-size:7px;font-style:normal}.peak-rp-assign>span em,.peak-rp-review>span em{grid-column:3;grid-row:1;color:#5c6fd0;font-size:7px;font-style:normal}.peak-rp-review section{background:#e5f1e8}.peak-rp-review section b,.peak-rp-review section small{display:block;color:#397c4d}
</style>
