---
import { assets } from "../../data/assets";
---

<img
  class="build-buy-evidence"
  src={assets.marketing.buildVsBuyMaintenanceExample}
  alt="Post describing a team returning to Linear because maintaining its internally built tool consumed work bandwidth"
  width="1190"
  height="812"
  loading="eager"
  decoding="async"
  fetchpriority="high"
/>

<style>
  .build-buy-evidence {
    display: block;
    width: 100%;
    max-width: 680px;
    height: auto !important;
    max-height: none;
    margin: 0 auto;
    border-radius: 14px;
    box-shadow:
      0 0 0 1px rgba(255, 255, 255, 0.28),
      0 18px 42px rgba(26, 26, 26, 0.14),
      0 0 32px rgba(40, 69, 214, 0.1);
    aspect-ratio: 1190 / 812;
    object-fit: contain;
  }
</style>
