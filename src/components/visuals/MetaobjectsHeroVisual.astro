---
import ProductVisualFrame from "../ui/ProductVisualFrame.astro";
---
<ProductVisualFrame ariaLabel="Peak PIM metaobject workspace showing a Size Guide definition, typed entry fields, and publishing results across Shopify stores" section="Metaobjects" status="Draft saved" actionLabel="Publish to 3 stores">
  <div class="peak-mo-workspace">
    <aside class="peak-mo-sidebar"><strong>Size Guide</strong><small>Definition</small><span class="active">Entries</span><span>Fields</span><span>Translations</span><small>Stores</small><b>US · Connected</b><b>FR · Connected</b><b>DE · Connected</b></aside>
    <div class="peak-mo-main">
      <div class="peak-mo-heading"><div><small>Size Guide entry</small><b>Women's outerwear</b></div><span>Canonical entry</span></div>
      <div class="peak-mo-content">
        <div class="peak-mo-form"><label><small>Display name · Text</small><span>Women's outerwear</span></label><label><small>Handle · Per store</small><span>womens-outerwear</span></label><label><small>Measurement unit · Choice</small><span>Centimeters</span></label><label class="wide"><small>Fit notes · Multi-line text</small><span>Measure around the fullest part of the chest.</span></label><div><em>#FFFFFF</em><em>Required</em><em>Validated</em></div></div>
        <div class="peak-mo-stores"><small>Publish outcomes</small><span><i>US</i><b>Active</b><em>Ready</em></span><span><i>FR</i><b>Draft</b><em>Ready</em></span><span><i>DE</i><b>Draft</b><em>Ready</em></span><div><b>Definition + entry</b><small>One publish pipeline</small></div></div>
      </div>
    </div>
  </div>
</ProductVisualFrame>
<style>
  .peak-mo-workspace{display:grid;min-height:440px;grid-template-columns:155px minmax(0,1fr);background:#f6f3ec;font-family:Inter,Arial,sans-serif}.peak-mo-sidebar{display:flex;flex-direction:column;gap:7px;padding:22px 14px;border-right:1px solid #dfdcd5;background:#fbfaf7}.peak-mo-sidebar strong{padding:0 8px 8px;font-size:11px}.peak-mo-sidebar small{margin:10px 8px 0;color:#999;font-size:7px;text-transform:uppercase}.peak-mo-sidebar span,.peak-mo-sidebar b{padding:8px;border-radius:5px;color:#666;font-size:8px}.peak-mo-sidebar span.active{background:#e9edff;color:#2845d6;font-weight:700}.peak-mo-sidebar b{padding-block:4px;font-weight:500}.peak-mo-main{min-width:0;padding:24px}.peak-mo-heading{display:flex;align-items:center;justify-content:space-between;padding-bottom:15px;border-bottom:1px solid #ddd}.peak-mo-heading div{display:flex;flex-direction:column}.peak-mo-heading small{color:#777;font-size:8px}.peak-mo-heading b{font-size:13px}.peak-mo-heading>span{padding:6px 8px;border-radius:999px;background:#e9edff;color:#2845d6;font-size:7px}.peak-mo-content{display:grid;gap:14px;margin-top:18px;grid-template-columns:minmax(0,1fr) 140px}.peak-mo-form{display:grid;gap:9px;grid-template-columns:1fr 1fr}.peak-mo-form label{display:flex;min-width:0;flex-direction:column;gap:6px;padding:11px;border:1px solid #ddd;border-radius:6px;background:#fff}.peak-mo-form label.wide,.peak-mo-form>div{grid-column:1/-1}.peak-mo-form small{color:#777;font-size:7px}.peak-mo-form label span{overflow:hidden;font-size:8px;text-overflow:ellipsis;white-space:nowrap}.peak-mo-form>div{display:flex;gap:6px}.peak-mo-form em{padding:6px 8px;border-radius:999px;background:#fff;color:#777;font-size:7px;font-style:normal}.peak-mo-stores{display:flex;flex-direction:column;gap:8px}.peak-mo-stores>small{color:#777;font-size:8px}.peak-mo-stores>span{display:grid;align-items:center;padding:10px;border:1px solid #ddd;border-radius:6px;background:#fff;grid-template-columns:25px 1fr}.peak-mo-stores i{display:grid;width:21px;height:21px;grid-row:1/3;place-items:center;border-radius:4px;background:#191919;color:#fff;font-size:7px;font-style:normal}.peak-mo-stores b{font-size:8px}.peak-mo-stores em{grid-column:2;color:#438f5a;font-size:7px;font-style:normal}.peak-mo-stores>div{margin-top:auto;padding:11px;border-radius:6px;background:#e5f1e8}.peak-mo-stores>div b,.peak-mo-stores>div small{display:block;color:#337448;font-size:7px}@media(max-width:767px){.peak-mo-workspace{min-height:395px;grid-template-columns:1fr}.peak-mo-sidebar{display:none}.peak-mo-main{padding:16px}.peak-mo-content{grid-template-columns:1fr}.peak-mo-stores{display:grid;grid-template-columns:repeat(3,1fr)}.peak-mo-stores>small,.peak-mo-stores>div{grid-column:1/-1}.peak-mo-stores>span{padding:7px;grid-template-columns:20px 1fr}.peak-mo-stores i{width:17px;height:17px}}@media(prefers-reduced-motion:no-preference){.peak-mo-stores>div{animation:peak-mo-ready 2.5s ease-in-out infinite}@keyframes peak-mo-ready{50%{box-shadow:0 0 0 4px rgba(67,143,90,.12)}}}@media(prefers-reduced-motion:reduce){.peak-mo-stores>div{animation:none}}
</style>
