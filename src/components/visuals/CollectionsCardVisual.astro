---
type Props={mode:"canonical"|"memberships"|"schedule"};
const {mode}=Astro.props;
---

<div class:list={["peak-col-card",`is-${mode}`]} role="img" aria-label={mode==="canonical"?"Canonical collection projected to three Shopify stores":mode==="memberships"?"Per-store collection membership editor for one product":"Scheduled Holiday Gifts collection changes with an automatic restore time"}>
  {mode==="canonical"&&<div class="peak-col-canonical"><header><small>Master collection</small><b>Holiday Gifts</b></header><section><span><i>US</i><b>Holiday Gifts</b><em>Published</em></span><span><i>FR</i><b>Cadeaux de Noël</b><em>Published</em></span><span><i>DE</i><b>Weihnachtsgeschenke</b><em>Ready</em></span></section><button>Publish to 3 stores</button></div>}
  {mode==="memberships"&&<div class="peak-col-memberships"><header><small>Summit Shell Jacket</small><b>Collection memberships</b></header><section><span><i>US</i><b>Holiday Gifts</b><mark>✓</mark></span><span><i>FR</i><b>Cadeaux de Noël</b><mark>✓</mark></span><span class="peak-col-membership is-updated"><i>DE</i><b>Weihnachtsgeschenke</b><mark>+</mark></span></section><button>Add to all stores</button></div>}
  {mode==="schedule"&&<div class="peak-col-schedule"><header><small>Drop</small><b>Holiday launch</b><em>Scheduled</em></header><div><span>Starts</span><b>Nov 15 · 00:01</b></div><div><span>Restores</span><b>Jan 03 · 08:00</b></div><section><small>3 stores</small><strong>12 collection changes</strong><span><i></i>Title</span><span><i></i>Description</span><span><i></i>Memberships</span></section><button>Review scheduled changes</button></div>}
</div>

<style>
  .peak-col-card{box-sizing:border-box;width:100%;min-height:300px;padding:25px;background:radial-gradient(#333 1px,transparent 1px),#191919;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-col-canonical,.peak-col-memberships,.peak-col-schedule{display:grid;gap:9px}.peak-col-card header,.peak-col-canonical span,.peak-col-memberships span,.peak-col-schedule>div,.peak-col-schedule section{padding:11px;border-radius:7px;background:#fff}.peak-col-card header{display:grid;grid-template-columns:1fr auto}.peak-col-card header small{grid-column:1;color:#777;font-size:7px}.peak-col-card header b{grid-column:1;font-size:10px}.peak-col-card header em{grid-column:2;grid-row:1/3;align-self:center;padding:5px 7px;border-radius:999px;background:#edf6ef;color:#438258;font-size:6px;font-style:normal}.peak-col-card section{display:grid;gap:7px}.peak-col-canonical span,.peak-col-memberships span{display:grid;align-items:center;grid-template-columns:27px 1fr auto}.peak-col-canonical i,.peak-col-memberships i{display:grid;width:23px;height:23px;grid-row:1/3;place-items:center;border-radius:4px;background:#191919;color:#fff;font:normal 6px Inter,Arial,sans-serif}.peak-col-canonical b,.peak-col-memberships b{font-size:8px}.peak-col-canonical em{color:#777;font-size:6px;font-style:normal}.peak-col-memberships mark{display:grid;width:20px;height:20px;place-items:center;border-radius:50%;background:#edf6ef;color:#438258;font-size:8px}.peak-col-memberships .is-updated{outline:2px solid #7386eb}.peak-col-memberships .is-updated mark{background:#e9edff;color:#2845d6}.peak-col-card button{padding:11px;border:0;border-radius:7px;background:#2845d6;color:#fff;font:700 8px Inter,Arial,sans-serif}.peak-col-schedule>div{display:flex;align-items:center;justify-content:space-between}.peak-col-schedule>div span{color:#777;font-size:7px}.peak-col-schedule>div b{font-size:8px}.peak-col-schedule section{grid-template-columns:1fr auto}.peak-col-schedule section small{color:#777;font-size:7px}.peak-col-schedule section strong{font-size:8px}.peak-col-schedule section span{display:flex;align-items:center;gap:4px;color:#666;font-size:6px}.peak-col-schedule section span i{width:5px;height:5px;border-radius:50%;background:#2845d6}
  @media(prefers-reduced-motion:no-preference){.peak-col-membership.is-updated{animation:peak-col-membership 3s ease-in-out infinite}@keyframes peak-col-membership{50%{transform:translateY(-2px);box-shadow:0 7px 16px rgba(40,69,214,.2)}}}
  @media(prefers-reduced-motion:reduce){.peak-col-membership.is-updated{animation:none}}
</style>
