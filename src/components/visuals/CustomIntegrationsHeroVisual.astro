---
import ProductVisualFrame from "../ui/ProductVisualFrame.astro";
---

<ProductVisualFrame
  ariaLabel="Peak PIM custom integration map connecting supplier, ERP, logistics, and B2B and B2C store systems through validated catalog data flows"
  section="Custom integrations"
  status="Flow validated"
  actionLabel="Ready to launch"
>
  <div class="peak-ci-map">
    <section class="peak-ci-systems" aria-hidden="true">
      <small>Business systems</small>
      <article><i>SU</i><span><b>Supplier feed</b><em>Products + costs</em></span></article>
      <article><i>ERP</i><span><b>Internal ERP</b><em>References + rules</em></span></article>
      <article><i>3PL</i><span><b>Logistics partner</b><em>Operational data</em></span></article>
    </section>
    <div class="peak-ci-flow" aria-hidden="true"><span></span><span></span><span></span></div>
    <section class="peak-ci-peak" aria-hidden="true">
      <small>Peak PIM</small>
      <div class="peak-ci-peak__mark">P</div>
      <b>Connected catalog</b>
      <span><i>1</i> Map fields</span>
      <span><i>2</i> Validate data</span>
      <span><i>3</i> Route changes</span>
    </section>
    <div class="peak-ci-flow is-outbound" aria-hidden="true"><span></span><span></span></div>
    <section class="peak-ci-destinations" aria-hidden="true">
      <small>Destinations</small>
      <article><i>B2C</i><span><b>Main store</b><em>Published</em></span></article>
      <article><i>B2B</i><span><b>Wholesale store</b><em>Published</em></span></article>
      <p><strong>1 source of truth</strong><span>Different data where needed</span></p>
    </section>
  </div>
</ProductVisualFrame>

<style>
  .peak-ci-map{display:grid;min-height:440px;grid-template-columns:minmax(130px,.9fr) 34px minmax(150px,1fr) 34px minmax(130px,.9fr);align-items:center;padding:30px;background:radial-gradient(#dedede 1px,transparent 1px),#f8f8f6;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-ci-map section{min-width:0}.peak-ci-map small{display:block;margin-bottom:10px;color:#777;font-size:8px;font-weight:700;letter-spacing:.06em;text-transform:uppercase}.peak-ci-systems,.peak-ci-destinations{display:grid;gap:9px}.peak-ci-map article{display:flex;align-items:center;gap:9px;padding:11px;border:1px solid #dedede;border-radius:8px;background:#fff;box-shadow:0 8px 22px rgba(0,0,0,.05)}.peak-ci-map article>i{display:grid;width:28px;height:28px;flex:0 0 auto;place-items:center;border-radius:6px;background:#191919;color:#fff;font-size:7px;font-style:normal;font-weight:800}.peak-ci-map article span{display:flex;min-width:0;flex-direction:column}.peak-ci-map article b{font-size:8px;white-space:nowrap}.peak-ci-map article em{color:#777;font-size:7px;font-style:normal;white-space:nowrap}.peak-ci-flow{display:grid;gap:38px}.peak-ci-flow span{position:relative;height:1px;background:#9aa7ea}.peak-ci-flow span::after{position:absolute;top:-3px;right:-1px;width:7px;height:7px;border-top:1px solid #2845d6;border-right:1px solid #2845d6;content:"";transform:rotate(45deg)}.peak-ci-peak{display:grid;gap:8px;padding:18px;border:1px solid #aeb8ee;border-radius:12px;background:#fff;box-shadow:0 18px 42px rgba(40,69,214,.12);text-align:center}.peak-ci-peak small{margin-bottom:0;color:#2845d6}.peak-ci-peak__mark{display:grid;width:42px;height:42px;margin:0 auto;place-items:center;border-radius:10px;background:#191919;color:#fff;font-size:17px;font-weight:800}.peak-ci-peak>b{font-size:10px}.peak-ci-peak>span{display:flex;align-items:center;gap:7px;padding:7px;border-radius:6px;background:#f4f5fb;font-size:7px;text-align:left}.peak-ci-peak>span i{display:grid;width:16px;height:16px;place-items:center;border-radius:50%;background:#2845d6;color:#fff;font-size:6px;font-style:normal}.peak-ci-destinations article>i{background:#2845d6}.peak-ci-destinations article em{color:#397c4d}.peak-ci-destinations p{display:flex;margin:2px 0 0;flex-direction:column;padding:10px;border-radius:7px;background:#e6f2e9}.peak-ci-destinations p strong{font-size:8px}.peak-ci-destinations p span{color:#397c4d;font-size:7px}@media(max-width:767px){.peak-ci-map{min-height:390px;grid-template-columns:1fr 22px 1fr;padding:18px}.peak-ci-systems{display:none}.peak-ci-map>.peak-ci-flow:not(.is-outbound){display:none}.peak-ci-peak{padding:14px}.peak-ci-map article{padding:9px}.peak-ci-destinations p{padding:9px}}@media(max-width:479px){.peak-ci-map{grid-template-columns:minmax(105px,1fr) 18px minmax(110px,1fr);padding:12px}.peak-ci-map article{gap:6px}.peak-ci-map article>i{width:24px;height:24px}.peak-ci-map article b,.peak-ci-map article em{white-space:normal}}
</style>
