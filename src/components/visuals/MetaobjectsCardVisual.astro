---
type Props={mode:"define"|"entry"|"publish"};const {mode}=Astro.props;
---
<div class:list={["peak-mo-card",`is-${mode}`]} role="img" aria-label={mode==="define"?"Metaobject definition editor with typed fields and validations":mode==="entry"?"Metaobject entry editor with type-aware field controls":"Multi-store metaobject publish results with one structure conflict"}>
  {mode==="define"&&<div class="peak-mo-definition"><div><small>Definition</small><b>Care Instructions</b><em>All stores</em></div><span><i>T</i><b>Title</b><small>Single-line text · Required</small></span><span><i>¶</i><b>Instructions</b><small>Multi-line text · Required</small></span><span><i>◷</i><b>Updated date</b><small>Date · Optional</small></span><button>Save definition</button></div>}
  {mode==="entry"&&<div class="peak-mo-entry"><div><small>Entry · France</small><b>Care Instructions · Wool</b></div><label><small>Handle</small><span>entretien-laine</span></label><label><small>Instructions</small><span>Lavage à froid · Séchage à plat</span></label><section><em>#4A443F</em><em>2026-07-28</em><em>Draft</em></section><button>Save draft</button></div>}
  {mode==="publish"&&<div class="peak-mo-publish"><div><small>Publish definition + 12 entries</small><b>Size Guide</b></div><span><i>US</i><b>Published</b><em>12 entries</em></span><span><i>FR</i><b>Published</b><em>12 entries</em></span><span class="conflict"><i>DE</i><b>Structure conflict</b><em>Field “unit” differs</em></span><button>Review conflict</button></div>}
</div>
<style>
  .peak-mo-card{box-sizing:border-box;width:100%;min-height:300px;padding:25px;background:radial-gradient(#333 1px,transparent 1px),#191919;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-mo-definition,.peak-mo-entry,.peak-mo-publish{display:grid;gap:9px}.peak-mo-definition>div,.peak-mo-entry>div,.peak-mo-publish>div,.peak-mo-definition>span,.peak-mo-publish>span,.peak-mo-entry label{padding:12px;border-radius:7px;background:#fff}.peak-mo-definition>div,.peak-mo-entry>div,.peak-mo-publish>div{display:grid;grid-template-columns:1fr auto}.peak-mo-card small,.peak-mo-card em{color:#777;font-size:7px;font-style:normal}.peak-mo-card div>b{grid-column:1;font-size:10px}.peak-mo-card div>em{grid-column:2;grid-row:1/3;align-self:center;padding:5px;border-radius:999px;background:#eef1ff;color:#2845d6}.peak-mo-definition>span,.peak-mo-publish>span{display:grid;grid-template-columns:28px 1fr}.peak-mo-definition>span i,.peak-mo-publish>span i{display:grid;width:23px;height:23px;grid-row:1/3;place-items:center;border-radius:4px;background:#191919;color:#fff;font-size:8px;font-style:normal}.peak-mo-definition>span b,.peak-mo-publish>span b{font-size:8px}.peak-mo-definition>span small,.peak-mo-publish>span em{grid-column:2}.peak-mo-card button{padding:11px;border:0;border-radius:7px;background:#2845d6;color:#fff;font:700 8px Inter,Arial,sans-serif}.peak-mo-entry label{display:flex;flex-direction:column;gap:4px}.peak-mo-entry label span{font-size:8px}.peak-mo-entry section{display:flex;gap:6px}.peak-mo-entry section em{padding:6px 8px;border-radius:999px;background:#fff}.peak-mo-publish .conflict{outline:2px solid #b36a56}.peak-mo-publish .conflict b,.peak-mo-publish .conflict em{color:#9c4b36}
</style>
