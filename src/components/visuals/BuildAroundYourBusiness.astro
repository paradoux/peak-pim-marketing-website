<style is:global>
.peak-business-animation{width:100%;max-width:1200px;margin-inline:auto}
.ppim-ba{position:relative;width:100%;aspect-ratio:1200/520;overflow:hidden;font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;color:#2C2C2A;-webkit-font-smoothing:antialiased;text-align:left;line-height:1.3}
.ppim-ba *{box-sizing:border-box}
.ppim-ba-canvas{position:absolute;left:0;top:0;width:1200px;height:520px;transform-origin:0 0}
.ppim-ba-dotsbg{position:absolute;inset:0;background:radial-gradient(#CFC7B8 1px,transparent 1.3px) 0 0/16px 16px;-webkit-mask-image:radial-gradient(ellipse 52% 60% at 50% 48%,#000 30%,transparent 100%);mask-image:radial-gradient(ellipse 52% 60% at 50% 48%,#000 30%,transparent 100%);opacity:.75}
.ppim-ba-svg{position:absolute;inset:0;width:1200px;height:520px;overflow:visible}
.ppim-ba-edge{fill:none;stroke:#D3CCBF;stroke-width:1.3}
.ppim-ba-edge.is-dotted{stroke-dasharray:2 4}
.ppim-ba-trail{fill:none;stroke:#2845D6;stroke-width:1.6;stroke-linecap:round;opacity:.55;transition:opacity .6s ease}

/* cards */
.ppim-ba-card{position:absolute;width:270px;height:60px;display:flex;align-items:center;gap:12px;padding:0 14px;background:#fff;border:1px solid #E4DED2;border-radius:10px;box-shadow:0 1px 2px rgba(13,26,99,.04),0 8px 22px rgba(13,26,99,.06);transition:border-color .3s ease,box-shadow .3s ease;z-index:2}
.ppim-ba-card.is-more{background:#FBF9F5;box-shadow:3px 3px 0 -1px #fff,3px 3px 0 0 #E4DED2,6px 6px 0 -1px #fff,6px 6px 0 0 #E4DED2}
.ppim-ba-card.is-more .ppim-ba-tx b{color:#6B6B6B}
.ppim-ba-ic{width:32px;height:32px;border-radius:8px;border:1px solid #E8E3D8;background:#fff;display:flex;align-items:center;justify-content:center;flex-shrink:0}
.ppim-ba-tx{flex:1;min-width:0;display:flex;flex-direction:column;gap:3px}
.ppim-ba-tx b{font-size:13.5px;font-weight:600;letter-spacing:-.005em;white-space:nowrap}
.ppim-ba-tx b i{font-style:normal;font-weight:400;color:#6B6B6B}
.ppim-ba-tx em{font-style:normal;font-size:11.5px;color:#8A8983;white-space:nowrap;transition:color .3s ease,opacity .25s ease}
.ppim-ba-ck{flex-shrink:0;opacity:0;transform:scale(.4);transition:opacity .25s ease,transform .35s cubic-bezier(.3,1.6,.5,1)}
.ppim-ba-card.is-active{border-color:#1a1a1a;box-shadow:0 0 0 .5px #1a1a1a,0 10px 26px rgba(13,26,99,.12)}
.ppim-ba-card.is-active .ppim-ba-ck{opacity:1;transform:none}
.ppim-ba-dest.is-fresh em{color:#2C2C2A}

/* ---------- mobile layout (container under 860px): 380 x 580 canvas, flow runs top to bottom ---------- */
.ppim-ba.ppim-ba--m{aspect-ratio:380/580;max-width:480px;margin-left:auto;margin-right:auto}
.ppim-ba--m .ppim-ba-canvas,.ppim-ba--m .ppim-ba-svg{width:380px;height:580px}
.ppim-ba--m .ppim-ba-dotsbg{-webkit-mask-image:radial-gradient(ellipse 70% 55% at 50% 50%,#000 30%,transparent 100%);mask-image:radial-gradient(ellipse 70% 55% at 50% 50%,#000 30%,transparent 100%)}
.ppim-ba--m .ppim-ba-card{width:172px;height:48px;gap:8px;padding:0 10px;border-radius:9px}
.ppim-ba--m .ppim-ba-ic{width:26px;height:26px;border-radius:7px}
.ppim-ba--m .ppim-ba-ic svg{width:14px;height:14px}
.ppim-ba--m .ppim-ba-tx b{font-size:12.5px}
.ppim-ba--m .ppim-ba-card .ppim-ba-ck{position:absolute;right:7px;top:7px;width:14px;height:14px}
.ppim-ba--m .ppim-ba-dest{height:64px;align-items:flex-start;padding-top:11px}
.ppim-ba--m .ppim-ba-dest .ppim-ba-tx{padding-right:10px}
.ppim-ba--m .ppim-ba-dest .ppim-ba-tx em{font-size:10.5px;white-space:normal;line-height:1.25}
.ppim-ba--m [data-id="sheets"]{left:15px!important;top:16px!important}
.ppim-ba--m [data-id="shopify"]{left:193px!important;top:16px!important}
.ppim-ba--m [data-id="erp"]{left:15px!important;top:72px!important}
.ppim-ba--m [data-id="more"]{left:193px!important;top:72px!important}
.ppim-ba--m .ppim-ba-pim{left:15px;top:186px;width:350px;border-radius:12px}
.ppim-ba--m .ppim-ba-phead{height:40px;padding:0 14px}
.ppim-ba--m .ppim-ba-verbs{display:grid;grid-template-columns:1fr 1fr;gap:2px 4px;padding:6px}
.ppim-ba--m .ppim-ba-verb{height:38px;gap:9px;padding:0 8px}
.ppim-ba--m .ppim-ba-vic{width:26px;height:26px}
.ppim-ba--m .ppim-ba-vtx b{font-size:12.5px}
.ppim-ba--m .ppim-ba-verb .ppim-ba-ck{right:8px;top:11px}
.ppim-ba--m [data-id="us"]{left:15px!important;top:428px!important}
.ppim-ba--m [data-id="b2b"]{left:193px!important;top:428px!important}
.ppim-ba--m [data-id="eu"]{left:15px!important;top:500px!important}
.ppim-ba--m [data-id="mkt"]{left:193px!important;top:500px!important}
/* Peak PIM card with verbs */
.ppim-ba-pim{position:absolute;left:450px;top:112px;width:300px;background:#fff;border:1px solid #E4DED2;border-radius:14px;overflow:hidden;box-shadow:0 4px 12px rgba(13,26,99,.06),0 24px 60px rgba(13,26,99,.12);transition:box-shadow .35s ease,border-color .35s ease;z-index:3}
.ppim-ba-pim.is-active{border-color:#C9D3FB;box-shadow:0 0 0 4px rgba(40,69,214,.08),0 4px 12px rgba(13,26,99,.06),0 24px 60px rgba(13,26,99,.14)}
.ppim-ba-phead{height:44px;display:flex;align-items:center;gap:9px;padding:0 16px;background:#1a1a1a}
.ppim-ba-phead b{font-size:13px;font-weight:500;color:#fff}
.ppim-ba-verbs{padding:6px}
.ppim-ba-verb{position:relative;height:40px;display:flex;align-items:center;gap:11px;padding:0 10px;border-radius:8px;transition:background .3s ease}
.ppim-ba-verb::before{content:"";position:absolute;left:0;top:8px;bottom:8px;width:3px;border-radius:2px;background:#2845D6;transform:scaleY(0);transition:transform .3s ease}
.ppim-ba-vic{width:28px;height:28px;border-radius:7px;background:#F4F1EA;color:#4A4A47;display:flex;align-items:center;justify-content:center;flex-shrink:0;transition:background .3s ease,color .3s ease}
.ppim-ba-vtx{flex:1;min-width:0;display:flex;flex-direction:column;gap:2px}
.ppim-ba-vtx b{font-size:13px;font-weight:600;transition:color .3s ease}
.ppim-ba-vtx em{font-style:normal;font-size:11px;color:#8A8983;white-space:nowrap}
.ppim-ba-ai{display:inline-flex;align-items:center;gap:3px;height:18px;padding:0 6px;border-radius:99px;background:#EEF1FE;color:#1A2CA3;font-size:9.5px;font-weight:600;flex-shrink:0}
.ppim-ba-verb .ppim-ba-ck{position:absolute;right:10px;top:12px}
.ppim-ba-verb.is-active{background:#EEF1FE}
.ppim-ba-verb.is-active::before{transform:scaleY(1)}
.ppim-ba-verb.is-active .ppim-ba-vic{background:#2845D6;color:#fff}
.ppim-ba-verb.is-active .ppim-ba-vtx b{color:#1A2CA3}
.ppim-ba-verb.is-active .ppim-ba-ai{opacity:0}
.ppim-ba-verb.is-done .ppim-ba-ck{opacity:1;transform:none}
.ppim-ba-verb.is-done .ppim-ba-ai{opacity:0}
.ppim-ba-ai{transition:opacity .2s ease}
</style>
<script is:inline>
(function(){
  /* PACE: one knob for the whole animation. Lower is faster, higher is slower. */
  var PACE=1.3;
  var root=document.getElementById('ppim-ba');
  if(!root||root.getAttribute('data-ready'))return;root.setAttribute('data-ready','1');
  var W=1200,isM=false,ready=false,canvas=root.querySelector('.ppim-ba-canvas'),scale=1;
  var T=function(ms){return Math.round(ms*PACE)},sleep=function(ms){return new Promise(function(r){setTimeout(r,T(ms))})},later=function(f,ms){setTimeout(f,T(ms))};
  var el={};Array.prototype.forEach.call(root.querySelectorAll('[data-id]'),function(e){el[e.getAttribute('data-id')]=e});
  var edgesG=root.querySelector('.ppim-ba-edges'),liveG=root.querySelector('.ppim-ba-live'),NS='http://www.w3.org/2000/svg';

  /* the graph: [from, to, dotted?]  sources feed Peak PIM, Peak PIM feeds channels */
  var EDGES=[['sheets','pim'],['shopify','pim'],['erp','pim'],['more','pim',1],['pim','us'],['pim','b2b'],['pim','eu'],['pim','mkt']];
  /* each flow: one source, the things you do in Peak PIM, one channel */
  var CYCLES=[
    {route:['sheets','us'],verbs:['clean','schedule'],msg:'Winter prices live'},
    {route:['shopify','eu'],verbs:['duplicate','translate'],msg:'2,847 products in French'},
    {route:['erp','b2b'],verbs:['clean','enrich'],msg:'Wholesale catalog live'},
    {route:['shopify','mkt'],verbs:['visualize','enrich'],msg:'1,640 listings updated'}
  ];

  /* the layout follows the width of the parent: under 860px it switches to the vertical mobile layout */
  var host=root.parentElement||root;
  function fit(){
    var m=host.clientWidth>0&&host.clientWidth<860,changed=m!==isM;
    if(changed){isM=m;root.classList.toggle('ppim-ba--m',m);W=m?380:1200;root.querySelector('.ppim-ba-svg').setAttribute('viewBox',m?'0 0 380 580':'0 0 1200 520')}
    scale=root.clientWidth/W||1;canvas.style.transform='scale('+scale+')';
    if(changed&&ready)layout();
  }
  if(window.ResizeObserver){var ro=new ResizeObserver(fit);ro.observe(host);ro.observe(root)}else window.addEventListener('resize',fit);fit();
  function box(id){var e=el[id];return {x:e.offsetLeft,y:e.offsetTop,w:e.offsetWidth,h:e.offsetHeight}}
  function anchor(id,side){var b=box(id);if(isM)return {x:b.x+b.w/2,y:side==='out'?b.y+b.h:b.y};return {x:side==='out'?b.x+b.w:b.x,y:b.y+b.h/2}}
  /* edges run from the right side of one element to the left side of the next */
  function d(a,b){var p=anchor(a,'out'),q=anchor(b,'in');if(isM){var my=(p.y+q.y)/2;return 'M '+p.x+' '+p.y+' C '+p.x+' '+my+', '+q.x+' '+my+', '+q.x+' '+q.y}var mx=(p.x+q.x)/2;return 'M '+p.x+' '+p.y+' C '+mx+' '+p.y+', '+mx+' '+q.y+', '+q.x+' '+q.y}
  var paths={};
  function layout(){
    edgesG.innerHTML='';
    EDGES.forEach(function(e){var p=document.createElementNS(NS,'path');p.setAttribute('d',d(e[0],e[1]));p.setAttribute('class','ppim-ba-edge'+(e[2]?' is-dotted':''));edgesG.appendChild(p);paths[e[0]+'>'+e[1]]=p});
  }
  layout();

  function travel(a,b,ms){
    var src=paths[a+'>'+b],len=src.getTotalLength(),dur=T(ms);
    var trail=document.createElementNS(NS,'path');trail.setAttribute('d',src.getAttribute('d'));trail.setAttribute('class','ppim-ba-trail');
    trail.style.strokeDasharray=len;trail.style.strokeDashoffset=len;liveG.appendChild(trail);
    var glow=document.createElementNS(NS,'circle'),core=document.createElementNS(NS,'circle');
    glow.setAttribute('r',12);glow.setAttribute('fill','#2845D6');glow.setAttribute('fill-opacity',.16);core.setAttribute('r',4);core.setAttribute('fill','#2845D6');
    liveG.appendChild(glow);liveG.appendChild(core);
    var t0=performance.now();
    return new Promise(function(res){(function step(now){var k=Math.min(1,(now-t0)/dur),e=k<.5?2*k*k:1-Math.pow(-2*k+2,2)/2,pt=src.getPointAtLength(len*e);
      glow.setAttribute('cx',pt.x);glow.setAttribute('cy',pt.y);core.setAttribute('cx',pt.x);core.setAttribute('cy',pt.y);trail.style.strokeDashoffset=len*(1-e);
      if(k<1)requestAnimationFrame(step);else{glow.remove();core.remove();res(trail)}})(t0)});
  }
  function pulse(id,ms){el[id].classList.add('is-active');later(function(){el[id].classList.remove('is-active')},ms||420)}

  async function cycle(c){
    var src=c.route[0],dstId=c.route[1],trails=[];
    Object.keys(el).forEach(function(k){if(el[k].classList.contains('ppim-ba-card'))el[k].classList.remove('is-active')});
    el[src].classList.add('is-active');
    await sleep(380);
    trails.push(await travel(src,'pim',700));
    el.pim.classList.add('is-active');
    for(var i=0;i<c.verbs.length;i++){
      var v=el[c.verbs[i]];v.classList.add('is-active');await sleep(620);
      v.classList.remove('is-active');v.classList.add('is-done');await sleep(140);
    }
    trails.push(await travel('pim',dstId,700));
    var dst=el[dstId],em=dst.querySelector('em');
    el[src].classList.remove('is-active');el.pim.classList.remove('is-active');dst.classList.add('is-active','is-fresh');
    em.style.opacity=0;later(function(){em.textContent=c.msg;em.style.opacity=1},180);
    later(function(){trails.forEach(function(t){t.style.opacity=0;setTimeout(function(){t.remove()},700)})},250);
    await sleep(1400);
    c.verbs.forEach(function(k){el[k].classList.remove('is-done')});
  }
  function finalState(){CYCLES.forEach(function(c){var dst=el[c.route[c.route.length-1]];dst.querySelector('em').textContent=c.msg;dst.classList.add('is-fresh')});el.eu.classList.add('is-active')}

  var visible=true,waiters=[];
  if(window.IntersectionObserver)new IntersectionObserver(function(e){visible=e[0].isIntersecting;if(visible){waiters.forEach(function(w){w()});waiters=[]}}).observe(root);
  function whenVisible(){return visible&&!document.hidden?Promise.resolve():new Promise(function(r){waiters.push(r);document.addEventListener('visibilitychange',function h(){if(!document.hidden&&visible){document.removeEventListener('visibilitychange',h);r()}})})}
  async function loop(){for(var i=0;;i=(i+1)%CYCLES.length){await whenVisible();await cycle(CYCLES[i])}}
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  function start(){fit();layout();ready=true;if(reduce)finalState();else loop()}
  start();
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(function(){fit();layout()});
})();
</script>
