---
type Props={mode:"connect"|"permissions"|"control"};
const {mode}=Astro.props;
---
<div class:list={["peak-ai-card",`is-${mode}`]} role="img" aria-label={mode==="connect"?"Three step setup for connecting an AI assistant to Peak PIM":mode==="permissions"?"Peak PIM AI access level controls":"Peak PIM AI activity log and disconnect control"}>
  {mode==="connect"&&<ol><li><i>1</i><span><small>Peak PIM settings</small><b>Copy connector URL</b></span><em>Copied</em></li><li><i>2</i><span><small>Claude or ChatGPT</small><b>Add custom connector</b></span></li><li><i>3</i><span><small>Secure approval</small><b>Authorize in browser</b></span><em>OAuth</em></li></ol>}
  {mode==="permissions"&&<div class="peak-ai-levels"><span><i></i><b>Read only</b><small>Search and inspect</small></span><span class="is-selected"><i></i><b>Read &amp; update</b><small>Create validated drafts</small><em>Selected</em></span><span><i></i><b>Read, update &amp; publish</b><small>Explicit storefront actions</small></span></div>}
  {mode==="control"&&<div class="peak-ai-control"><div><small>AI activity</small><b>12 catalog actions today</b></div><span><i>✓</i><b>3 descriptions drafted</b><small>No storefront changes</small></span><span><i>↗</i><b>1 product published</b><small>French store · Approved</small></span><button>Disconnect all assistants</button></div>}
</div>
<style>
  .peak-ai-card{min-height:300px;padding:26px;background:radial-gradient(#333 1px,transparent 1px),#191919;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-ai-card ol,.peak-ai-levels,.peak-ai-control{display:grid;gap:10px;margin:0;padding:0;list-style:none}.peak-ai-card li,.peak-ai-levels span,.peak-ai-control>span,.peak-ai-control>div{display:flex;align-items:center;gap:10px;padding:15px;border-radius:8px;background:#fff}.peak-ai-card li>i{display:grid;width:26px;height:26px;place-items:center;border-radius:50%;background:#191919;color:#fff;font-size:9px;font-style:normal}.peak-ai-card span span,.peak-ai-card li span{display:flex;flex:1;flex-direction:column}.peak-ai-card small{color:#888;font-size:7px}.peak-ai-card b{font-size:10px}.peak-ai-card em{padding:5px 7px;border-radius:999px;background:#eef1ff;color:#2845d6;font-size:7px;font-style:normal}.peak-ai-levels span{display:grid;grid-template-columns:18px 1fr auto}.peak-ai-levels span>i{width:12px;height:12px;border:1px solid #bbb;border-radius:50%}.peak-ai-levels span small{grid-column:2}.peak-ai-levels .is-selected{outline:2px solid #5268db}.peak-ai-levels .is-selected>i{border:3px solid #fff;background:#2845d6;outline:1px solid #2845d6}.peak-ai-levels em{grid-column:3;grid-row:1/3}.peak-ai-control>div{flex-direction:column;align-items:flex-start}.peak-ai-control>span{display:grid;grid-template-columns:25px 1fr}.peak-ai-control>span i{grid-row:1/3;font-style:normal}.peak-ai-control>span small{grid-column:2}.peak-ai-control button{padding:12px;border:1px solid #555;border-radius:8px;background:#191919;color:#fff;font:700 9px Inter,Arial,sans-serif}
</style>
