---
type Props={mode:"canonical"|"options"|"publish"};
const {mode}=Astro.props;
---

<div class:list={["peak-pv-card",`is-${mode}`]} role="img" aria-label={mode==="canonical"?"One canonical product projected to three Shopify stores with deliberate differences":mode==="options"?"Product option editor previewing variants to create and keep":"Product publish review with per-store outcomes and dependent catalog updates"}>
  {mode==="canonical"&&<div class="peak-pv-canonical"><header><small>Canonical product</small><b>Summit Shell Jacket</b></header><section><span><i>US</i><b>United States</b><em>$129 · Active</em></span><span><i>FR</i><b>France</b><em>€129 · Active</em></span><span><i>DE</i><b>Germany</b><em>€135 · Draft</em></span></section><button>Add to another store</button></div>}
  {mode==="options"&&<div class="peak-pv-options"><header><small>Options & variants</small><b>Preview structure</b></header><label><small>Size</small><span><i>S</i><i>M</i><i>L</i></span></label><label><small>Color</small><span><i>Black</i><i>Sand</i></span></label><section><span><b>6</b><small>kept</small></span><span class="is-create"><b>3</b><small>created</small></span><span><b>0</b><small>removed</small></span></section><button>Apply structure</button></div>}
  {mode==="publish"&&<div class="peak-pv-publish"><header><small>Publish product</small><b>Summit Shell Jacket</b><em>4 drafts</em></header><section><span><i>US</i><b>Ready</b><em>12 variants · 8 media</em></span><span><i>FR</i><b>Ready</b><em>12 variants · 8 media</em></span><span class="is-pending"><i>DE</i><b>2 variants staged</b><em>Collections + prices follow</em></span></section><button>Publish to 3 stores</button></div>}
</div>

<style>
  .peak-pv-card{box-sizing:border-box;width:100%;min-height:300px;padding:25px;background:radial-gradient(#333 1px,transparent 1px),#191919;background-size:18px 18px;color:#191919;font-family:Inter,Arial,sans-serif}.peak-pv-canonical,.peak-pv-options,.peak-pv-publish{display:grid;gap:9px}.peak-pv-card header,.peak-pv-canonical section>span,.peak-pv-options label,.peak-pv-options section,.peak-pv-publish section>span{padding:11px;border-radius:7px;background:#fff}.peak-pv-card header{display:grid;grid-template-columns:1fr auto}.peak-pv-card header small{grid-column:1;color:#777;font-size:7px}.peak-pv-card header b{grid-column:1;font-size:10px}.peak-pv-card header em{grid-column:2;grid-row:1/3;align-self:center;padding:5px 7px;border-radius:999px;background:#fff2dc;color:#9b681d;font-size:6px;font-style:normal}.peak-pv-canonical section,.peak-pv-publish section{display:grid;gap:7px}.peak-pv-canonical section>span,.peak-pv-publish section>span{display:grid;align-items:center;grid-template-columns:27px 1fr}.peak-pv-card section i{display:grid;width:23px;height:23px;grid-row:1/3;place-items:center;border-radius:4px;background:#191919;color:#fff;font:normal 6px Inter,Arial,sans-serif}.peak-pv-card section b{font-size:8px}.peak-pv-canonical section em,.peak-pv-publish section em{grid-column:2;color:#777;font-size:6px;font-style:normal}.peak-pv-card button{padding:11px;border:0;border-radius:7px;background:#2845d6;color:#fff;font:700 8px Inter,Arial,sans-serif}.peak-pv-options label{display:grid;gap:6px}.peak-pv-options label small{color:#777;font-size:7px}.peak-pv-options label span{display:flex;gap:5px}.peak-pv-options label i{padding:6px 8px;border-radius:5px;background:#f2efe8;color:#333;font:normal 7px Inter,Arial,sans-serif}.peak-pv-options section{display:grid;grid-template-columns:repeat(3,1fr)}.peak-pv-options section>span{display:flex;align-items:center;gap:4px}.peak-pv-options section b{font-size:11px}.peak-pv-options section small{color:#777;font-size:6px}.peak-pv-options section .is-create b{color:#2845d6}.peak-pv-publish .is-pending{outline:2px solid #7386eb}.peak-pv-publish .is-pending b{color:#2845d6}
  @media(prefers-reduced-motion:no-preference){.peak-pv-options section .is-create{animation:peak-pv-create 3s ease-in-out infinite}@keyframes peak-pv-create{50%{transform:translateY(-2px);color:#2845d6}}}
  @media(prefers-reduced-motion:reduce){.peak-pv-options section .is-create{animation:none}}
</style>
