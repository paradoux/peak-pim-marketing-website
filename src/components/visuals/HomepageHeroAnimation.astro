  }
  function setTab(t){Object.keys(tab).forEach(function(k){tab[k].classList.toggle('is-active',k===t)})}
  function show(n){Object.keys(scenes).forEach(function(k){var s=scenes[k];if(+k===n){s.classList.remove('is-out');s.classList.add('is-in')}else if(s.classList.contains('is-in')){s.classList.remove('is-in');s.classList.add('is-out')}})}

  function reset(){
    Object.keys(scenes).forEach(function(k){var s=scenes[k];s.style.transition='none';s.classList.remove('is-in','is-out');void s.offsetWidth;s.style.transition=''});
    srcCards.forEach(function(c){c.classList.remove('is-busy','is-done')});countN.textContent='0';hubSub.textContent='0 sources connected';
    Object.keys(rows).forEach(function(k){rows[k].classList.remove('is-focus','is-gen')});
    setTab('us');setRows(US0);rows.media.classList.add('has-ai');empty.classList.remove('is-on');pname.textContent=US0.title[0];ring(64,true);
    trBtn.className='ppim-hh-tr';trT.textContent='Fill from Heritage';
    btn.className='ppim-hh-btn is-disabled';btnT.textContent='Publish to 3 stores';
    node.classList.remove('is-done');
    stores.forEach(function(s){
      s.classList.remove('is-busy','is-synced','is-flash');
      var key=s.getAttribute('data-store'),t=q('.ppim-hh-stitle-t',s),d=q('.ppim-hh-sdesc-t',s);
      t.classList.remove('ppim-hh-hl');d.classList.remove('ppim-hh-hl');
      if(key!=='eu')t.textContent=US0.title[0];
      s.classList.toggle('is-new',key==='eu');
    });
    cursor.classList.remove('is-on');cursorTo({x:W/2,y:H+40},0);
  }
  function updateStore(s){
    var key=s.getAttribute('data-store'),t=q('.ppim-hh-stitle-t',s),d=q('.ppim-hh-sdesc-t',s);
    s.classList.remove('is-busy');s.classList.add('is-flash');
    if(key!=='eu'){t.style.opacity=0;later(function(){t.textContent=US1.title[0];t.style.opacity=1},250)}
    later(function(){s.classList.remove('is-new');s.classList.add('is-synced');t.classList.add('ppim-hh-hl');d.classList.add('ppim-hh-hl')},250);
    later(function(){s.classList.remove('is-flash');t.classList.remove('ppim-hh-hl');d.classList.remove('ppim-hh-hl')},1500);
  }
  function finalState(){
    reset();show(3);node.classList.add('is-done');
    stores.forEach(function(s){if(s.getAttribute('data-store')!=='eu')q('.ppim-hh-stitle-t',s).textContent=US1.title[0];s.classList.remove('is-new');s.classList.add('is-synced')});
  }

  var visible=true,waiters=[];
  if(window.IntersectionObserver)new IntersectionObserver(function(e){visible=e[0].isIntersecting;if(visible){waiters.forEach(function(w){w()});waiters=[]}}).observe(root);
  function whenVisible(){return visible&&!document.hidden?Promise.resolve():new Promise(function(r){waiters.push(r);document.addEventListener('visibilitychange',function h(){if(!document.hidden&&visible){document.removeEventListener('visibilitychange',h);r()}})})}

  async function loop(){
    for(;;){
      await whenVisible();
      reset();canvas.classList.remove('is-dim');fit();layout();

      /* ---- 1. Connect sources ---- */
      show(1);await sleep(500);
      var totals=[1204,2310,2847],colors=['#95BF47','#2845D6','#2845D6'];
      await Promise.all(srcCards.map(function(c,i){
        return sleep(i*560).then(function(){c.classList.add('is-busy');return sleep(420)})
          .then(function(){return dot(scenes[1],i,760,colors[i])})
          .then(function(){c.classList.remove('is-busy');c.classList.add('is-done');hubMark.classList.add('is-pulse');later(function(){hubMark.classList.remove('is-pulse')},220);
            hubSub.textContent=[3,7,8][i]+' sources connected';var from=i?totals[i-1]:0;return tween(from,totals[i],500,function(v){countN.textContent=fmt(v)})});
      }));
      await sleep(900);

      /* ---- 2. Complete Heritage, create for Sommet, publish ---- */
      show(2);await sleep(650);
      cursor.classList.add('is-on');
      // Heritage. Title: direct input
      await typeEdit('title',US1.title[0],{move:460,select:true,speed:24});
      pname.style.opacity=0;later(function(){pname.textContent=US1.title[0];pname.style.opacity=1},200);
      ring(76);await sleep(250);
      // Media: AI
      var ab=q('.ppim-hh-aibtn',rows.media);
      await moveTo(ab,380,.5,.5);await click(ab);
      await aiFill('media',US1.media[0],'Generating',750);ring(88);await sleep(250);
      // Lens metafield: direct input
      await typeEdit('lens',US1.lens[0],{move:360});ring(100);await sleep(500);
      // Sommet: product does not exist yet
      await moveTo(tab.eu,440,.5,.5);await click(tab.eu);
      setTab('eu');rows.media.classList.remove('has-ai');empty.classList.add('is-on');ring(0,false,450);
      await sleep(700);
      await moveTo(createBtn,380,.55,.5);await click(createBtn,.55,.5);
      setRows(FR0);empty.classList.remove('is-on');
      later(function(){trBtn.classList.add('is-on')},250);
      await sleep(750);
      // Fill from Heritage with AI
      await moveTo(trBtn,380,.55,.5);await click(trBtn,.55,.5);
      trBtn.classList.add('is-busy');trT.textContent='Filling from Heritage';
      await Promise.all(['title','media','lens'].map(function(k,i){
        return sleep(i*240).then(function(){return aiFill(k,FR1[k],'From Heritage',700)}).then(function(){ring(Math.round((i+1)*100/3),false,450)});
      }));
      trBtn.classList.remove('is-busy');trT.textContent='Filled from Heritage';
      btn.className='ppim-hh-btn is-ready';
      await sleep(650);
      // Publish
      await moveTo(btn,460,.55,.55);await click(btn,.55,.55);
      btn.className='ppim-hh-btn is-busy';btnT.textContent='Publishing';
      later(function(){cursor.classList.remove('is-on')},250);
      await sleep(700);

      /* ---- 3. Shopify stores update ---- */
      show(3);await sleep(550);
      await Promise.all(stores.map(function(s,i){
        return sleep(i*200).then(function(){s.classList.add('is-busy');return dot(scenes[3],i,850,'#2845D6')}).then(function(){updateStore(s)});
      }));
      await sleep(500);node.classList.add('is-done');
      await sleep(2300);
      canvas.classList.add('is-dim');await sleep(500);
    }
  }
  var reduce=window.matchMedia&&window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  var start=function(){fit();layout();ready=true;if(reduce)finalState();else loop()};
  if(document.fonts&&document.fonts.ready)document.fonts.ready.then(start);else start();
})();
</script>
<!-- ============ Peak PIM homepage hero animation v8 (embed end) ============ -->