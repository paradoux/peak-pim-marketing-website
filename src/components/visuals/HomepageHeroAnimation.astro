<style is:global>
.ppim-hh{position:relative;width:100%;aspect-ratio:1/1;font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif;color:#2C2C2A;-webkit-font-smoothing:antialiased;text-align:left;line-height:1.3}
.ppim-hh *{box-sizing:border-box}
.ppim-hh-canvas{position:absolute;left:0;top:0;width:600px;height:600px;transform-origin:0 0;transition:opacity .7s ease}
.ppim-hh-canvas.is-dim{opacity:0}
.ppim-hh-mono{font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace}

/* scenes: data flows downward, so each scene rises in from below and leaves upward */
.ppim-hh-scene{position:absolute;left:0;top:0;width:600px;height:600px;opacity:0;transform:translateY(30px);transition:opacity .7s ease,transform .7s cubic-bezier(.4,0,.2,1);pointer-events:none}
.ppim-hh-scene.is-in{opacity:1;transform:none}
.ppim-hh-scene.is-out{opacity:0;transform:translateY(-30px)}
.ppim-hh-lines{position:absolute;left:0;top:0;width:600px;height:600px;overflow:visible}
.ppim-hh-path{fill:none;stroke:#2845D6;stroke-opacity:.24;stroke-width:1.5;stroke-dasharray:3 4;animation:ppim-hh-dash 1.6s linear infinite}

/* scene 1 */
.ppim-hh-srcs{position:absolute;left:30px;top:96px;width:540px;display:grid;grid-template-columns:repeat(3,1fr);gap:12px}
.ppim-hh-srccard{position:relative;height:112px;padding:14px;background:#fff;border-radius:12px;box-shadow:0 1px 3px rgba(13,26,99,.05),0 14px 36px rgba(13,26,99,.10)}
.ppim-hh-srccard.is-multi::before,.ppim-hh-srccard.is-multi::after{content:"";position:absolute;left:8px;right:8px;top:0;bottom:-6px;z-index:-1;background:#fff;border-radius:12px;box-shadow:0 6px 16px rgba(13,26,99,.07);opacity:.85}
.ppim-hh-srccard.is-multi::after{left:16px;right:16px;bottom:-12px;z-index:-2;opacity:.55}
.ppim-hh-tile{width:34px;height:34px;border-radius:9px;display:flex;align-items:center;justify-content:center}
.ppim-hh-srct{margin-top:14px;font-size:13px;font-weight:600}
.ppim-hh-srcsub{font-size:11px;color:#8A8983;margin-top:3px;white-space:nowrap}
.ppim-hh-srcsub.ppim-hh-mono{font-size:10px}
.ppim-hh-pills{position:absolute;right:12px;top:20px;height:22px}
.ppim-hh-pills>span{position:absolute;right:0;top:0;height:22px;display:inline-flex;align-items:center;gap:5px;padding:0 8px;border-radius:99px;font-size:10px;font-weight:500;white-space:nowrap;opacity:0;transition:opacity .35s ease}
.ppim-hh-p-busy{background:#EEF1FE;color:#1A2CA3}
.ppim-hh-p-done{background:#EEF7F1;color:#0F6E56}
.ppim-hh-srccard.is-busy .ppim-hh-p-busy,.ppim-hh-srccard.is-done .ppim-hh-p-done{opacity:1}
.ppim-hh-hub{position:absolute;left:180px;top:338px;width:240px;display:flex;flex-direction:column;align-items:center;text-align:center}
.ppim-hh-hubmark{position:relative;width:104px;height:104px;border-radius:25px;background:#1a1a1a;display:flex;align-items:center;justify-content:center;box-shadow:0 4px 14px rgba(13,26,99,.12),0 24px 60px rgba(13,26,99,.14);transition:transform .3s ease}
.ppim-hh-hubmark::before{content:"";position:absolute;inset:-1px;border-radius:26px;border:1.5px solid #2845D6;opacity:0;animation:ppim-hh-halo 2.8s ease-out infinite}
.ppim-hh-hubmark.is-pulse{transform:scale(1.05)}
.ppim-hh-count{margin-top:22px;font-size:13px;color:#6B6B6B;white-space:nowrap}
.ppim-hh-count-n{display:inline-block;min-width:64px;text-align:right;font-size:26px;font-weight:600;color:#2C2C2A;letter-spacing:-.02em;font-variant-numeric:tabular-nums;margin-right:4px}
.ppim-hh-hubsub{margin-top:6px;font-size:11px;color:#8A8983}

/* scene 2 */
.ppim-hh-pim{position:absolute;left:40px;top:50%;transform:translateY(-50%);width:520px;background:#fff;border-radius:12px;overflow:hidden;box-shadow:0 4px 12px rgba(13,26,99,.06),0 24px 60px rgba(13,26,99,.12)}
.ppim-hh-banner{height:36px;background:#1a1a1a;display:flex;align-items:center;gap:8px;padding:0 16px}
.ppim-hh-brand{font-size:12px;color:#fff;font-weight:500}
.ppim-hh-bsep{font-size:11px;color:rgba(255,255,255,.5)}
.ppim-hh-bsub{font-size:11px;color:rgba(255,255,255,.6)}
.ppim-hh-head{display:flex;align-items:center;gap:14px;padding:16px 18px;border-bottom:1px solid #EEEAE0}
.ppim-hh-thumb{width:50px;height:50px;border-radius:8px;flex-shrink:0;background:var(--ppim-hh-img) center/cover no-repeat,#F4F1EA;box-shadow:inset 0 0 0 1px rgba(0,0,0,.05)}
.ppim-hh-hinfo{flex:1;min-width:0;text-align:left}
.ppim-hh-pname{font-size:15px;font-weight:600;letter-spacing:-.01em;transition:opacity .3s ease;white-space:nowrap}
.ppim-hh-pmeta{margin-top:4px;font-size:11px;color:#8A8983}
.ppim-hh-ring{position:relative;width:56px;height:56px;flex-shrink:0}
.ppim-hh-ring-p{transition:stroke-dashoffset .7s cubic-bezier(.4,0,.2,1),stroke .45s ease}
.ppim-hh-ring-n{position:absolute;inset:0;display:flex;align-items:center;justify-content:center;font-size:12.5px;font-weight:600;letter-spacing:-.015em;font-variant-numeric:tabular-nums}
.ppim-hh-tools{display:flex;align-items:center;justify-content:space-between;padding:12px 18px 0}
.ppim-hh-seg{display:flex;gap:2px;padding:3px;background:#F4F1EA;border-radius:8px}
.ppim-hh-segb{display:flex;align-items:center;gap:6px;height:26px;padding:0 9px 0 6px;white-space:nowrap;border-radius:6px;font-size:11.5px;color:#8A8983;transition:background .3s ease,color .3s ease,box-shadow .3s ease}
.ppim-hh-segb.is-active{background:#fff;color:#2C2C2A;font-weight:500;box-shadow:0 1px 2px rgba(13,26,99,.10)}
.ppim-hh-tr{display:flex;align-items:center;gap:6px;height:30px;padding:0 12px;border-radius:7px;background:#EEF1FE;border:1px solid #C9D3FB;color:#1A2CA3;font-size:11.5px;font-weight:500;opacity:0;transform:translateX(6px);transition:opacity .35s ease,transform .35s ease,background .2s ease}
.ppim-hh-tr.is-on{opacity:1;transform:none}
.ppim-hh-tr.is-pressed{background:#DDE4FD}
.ppim-hh-tr .ppim-hh-spin{display:none}
.ppim-hh-tr.is-busy .ppim-hh-spin{display:inline-block}
.ppim-hh-tr.is-busy svg{display:none}
.ppim-hh-fields{padding:12px 18px 16px;display:grid;gap:10px}
.ppim-hh-fwrap{position:relative}
.ppim-hh-empty{position:absolute;inset:0;background:#fff;display:flex;flex-direction:column;align-items:center;justify-content:center;gap:12px;opacity:0;pointer-events:none;transition:opacity .4s ease}
.ppim-hh-empty.is-on{opacity:1}
.ppim-hh-empty-t{display:flex;align-items:center;gap:8px;font-size:12.5px;color:#6B6B6B}
.ppim-hh-create{display:inline-flex;align-items:center;gap:7px;height:34px;padding:0 15px;border-radius:7px;background:#2845D6;color:#fff;font-size:12px;font-weight:500;transition:transform .12s ease,box-shadow .3s ease;box-shadow:0 0 0 4px rgba(40,69,214,.12)}
.ppim-hh-create.is-pressed{transform:scale(.96)}
.ppim-hh-gen b{font-weight:400}

.ppim-hh-row{display:grid;grid-template-columns:84px 1fr 128px;gap:10px;align-items:center;height:36px}
.ppim-hh-label{display:flex;align-items:center;gap:6px;font-size:9.5px;color:#8A8983;font-weight:500;letter-spacing:.05em;text-transform:uppercase}
.ppim-hh-chip{font-family:'JetBrains Mono','SF Mono',ui-monospace,monospace;font-size:8.5px;letter-spacing:0;text-transform:none;color:#1A2CA3;background:#EEF1FE;padding:1px 5px;border-radius:3px;font-weight:500}
.ppim-hh-flag{border-radius:4px;color:#fff;font-size:7px;font-weight:600;letter-spacing:0;display:inline-flex;align-items:center;justify-content:center;flex-shrink:0}
.ppim-hh-input{position:relative;height:34px;display:flex;align-items:center;gap:8px;padding:0 10px;background:#F8F7F3;border:1px solid #E8E6DE;border-radius:6px;font-size:12.5px;white-space:nowrap;overflow:hidden;transition:background .3s ease,border-color .3s ease,color .3s ease}
.ppim-hh-input.ppim-hh-mono{font-size:11px}
.ppim-hh-mthumb{width:22px;height:22px;border-radius:4px;flex-shrink:0;background:var(--ppim-hh-img) center/cover no-repeat,#F4F1EA;box-shadow:inset 0 0 0 1px rgba(0,0,0,.05)}
.ppim-hh-v{transition:opacity .3s ease,color .3s ease}
.ppim-hh-v.is-sel{background:#C9D3FB;border-radius:2px}
.ppim-hh-ph{display:none;color:#B9B6AD;font-style:italic}
.ppim-hh-row.is-empty .ppim-hh-ph{display:inline}
.ppim-hh-row.is-empty .ppim-hh-v{display:none}
.ppim-hh-row.is-fallback .ppim-hh-v{color:#ABA89F}
.ppim-hh-caret{display:none;width:1.5px;height:14px;background:#2845D6;margin-left:-7px;animation:ppim-hh-blink 1s step-end infinite}
.ppim-hh-gen{display:none;align-items:center;gap:5px;color:#1A2CA3;font-size:11.5px;font-style:italic;font-family:'Inter',-apple-system,BlinkMacSystemFont,sans-serif}
.ppim-hh-aibtn{position:absolute;right:5px;top:50%;margin-top:-12px;width:24px;height:24px;border-radius:5px;background:#EEF1FE;color:#2845D6;display:flex;align-items:center;justify-content:center;transition:opacity .3s ease,background .2s ease}
.ppim-hh-aibtn.is-pressed{background:#DDE4FD}
.ppim-hh-row:not(.is-flag) .ppim-hh-aibtn,.ppim-hh-row:not(.has-ai) .ppim-hh-aibtn,.ppim-hh-row.is-gen .ppim-hh-aibtn{opacity:0}
.ppim-hh-row.is-empty .ppim-hh-mthumb{display:none}
.ppim-hh-row.is-flag .ppim-hh-input{background:#FFFBF3;border-color:rgba(201,138,30,.45)}
.ppim-hh-row.is-focus .ppim-hh-input{background:#EEF1FE;border-color:#2845D6;color:#1A2CA3}
.ppim-hh-row.is-focus .ppim-hh-caret{display:block}
.ppim-hh-row.is-focus .ppim-hh-ph{display:none}
.ppim-hh-row.is-gen .ppim-hh-input{border-color:#C9D3FB;background:linear-gradient(90deg,#EEF1FE 0%,#DCE3FD 35%,#EEF1FE 70%) 0 0/220% 100%;animation:ppim-hh-shim 1.1s linear infinite}
.ppim-hh-row.is-gen .ppim-hh-v,.ppim-hh-row.is-gen .ppim-hh-ph{display:none}
.ppim-hh-row.is-gen .ppim-hh-gen{display:inline-flex}
.ppim-hh-st{position:relative;height:22px}
.ppim-hh-st>span{position:absolute;left:0;top:0;height:22px;display:inline-flex;align-items:center;gap:5px;padding:0 8px;border-radius:99px;font-size:10.5px;font-weight:500;white-space:nowrap;opacity:0;transform:translateY(3px);transition:opacity .35s ease,transform .35s ease}
.ppim-hh-st em{font-style:normal}
.ppim-hh-st-flag{background:#FBF1DF;color:#8A5208}
.ppim-hh-st-ok{color:#0F6E56;padding-left:2px!important}
.ppim-hh-st-ai{background:#EEF1FE;color:#1A2CA3}
.ppim-hh-row.is-flag .ppim-hh-st-flag,.ppim-hh-row.is-ok .ppim-hh-st-ok,.ppim-hh-row.is-ai .ppim-hh-st-ai{opacity:1;transform:none}
.ppim-hh-foot{display:flex;align-items:center;justify-content:space-between;height:58px;padding:0 18px;background:#FAF8F2;border-top:1px solid #EEEAE0}
.ppim-hh-fstores{display:flex;align-items:center;gap:4px;font-size:11px;color:#8A8983}
.ppim-hh-fstores i{width:8px;height:8px;border-radius:50%;box-shadow:0 0 0 2px #FAF8F2}
.ppim-hh-fstores i+i{margin-left:-3px}
.ppim-hh-fstores span:last-child{margin-left:8px}
.ppim-hh-btn{height:34px;min-width:170px;padding:0 16px;border-radius:7px;background:#2845D6;color:#fff;font-size:12px;font-weight:500;display:inline-flex;align-items:center;justify-content:center;gap:7px;transition:opacity .4s ease,box-shadow .4s ease,transform .12s ease}
