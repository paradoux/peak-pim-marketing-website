---
import { assets } from "../../data/assets";
---

<!-- ============ Peak PIM homepage hero animation v8 (embed start) ============ -->
<div class="ppim-hh" id="ppim-hh" style={`--ppim-hh-img:url("${assets.productUi.homepageFreerideRed}")`} role="img" aria-label="Three steps. Several Shopify stores, supplier spreadsheets and an ERP connect to Peak PIM. In Peak PIM, the product is completed for the Heritage store: the title is corrected by hand, the image filename is fixed with AI and a metafield is filled in. The product is then created for the Sommet Europe store, filled from Heritage with AI, and published to three Shopify stores: Heritage in the US, Sommet in Europe, and Heritage B2B. Heritage and Heritage B2B update and the product appears on Sommet.">
  <div class="ppim-hh-canvas">

    <!-- SCENE 1: sources connect to Peak PIM -->
    <div class="ppim-hh-scene" data-scene="1">
      <svg class="ppim-hh-lines" aria-hidden="true"><path class="ppim-hh-path"/><path class="ppim-hh-path"/><path class="ppim-hh-path"/><g class="ppim-hh-dots"></g></svg>
      <div class="ppim-hh-srcs">
        <div class="ppim-hh-srccard is-multi">
          <div class="ppim-hh-tile" style="background:#F2F6EA;color:#95BF47"><svg width="17" height="17" viewBox="0 0 32 32" fill="none" style="color:#95BF47;flex-shrink:0"><path d="M20.919 4.546c-0.025 0-0.075 0.026-0.097 0.026s-0.361 0.094-0.892 0.262c-0.529-1.541-1.47-2.962-3.134-2.962h-0.144c-0.356-0.5-0.921-0.832-1.564-0.868l-0.005-0c-3.881 0-5.736 4.845-6.317 7.305-1.492 0.456-2.578 0.795-2.699 0.842-0.844 0.266-0.867 0.29-0.965 1.087-0.094 0.577-2.287 17.574-2.287 17.574l16.946 3.183zM17.18 2.935c0.867 0.092 1.426 1.083 1.786 2.193-0.436 0.142-0.919 0.289-1.447 0.457v-0.315c0.001-0.049 0.002-0.107 0.002-0.165 0-0.777-0.125-1.524-0.355-2.224l0.014 0.050zM16.506 5.727v0.169c-0.942 0.29-1.978 0.605-2.992 0.92 0.264-1.607 1.237-2.944 2.58-3.699l0.026-0.013c0.248 0.705 0.391 1.518 0.391 2.365 0 0.091-0.002 0.182-0.005 0.273l0-0.013zM14.963 2.042c0 0 0.001 0 0.001 0 0.19 0 0.366 0.063 0.507 0.17l-0.002-0.002c-1.749 1.048-2.947 2.861-3.132 4.964l-0.002 0.024c-0.82 0.266-1.616 0.506-2.361 0.722 0.648-2.231 2.216-5.867 4.988-5.867zM15.638 15.132c-0.648-0.32-1.408-0.514-2.211-0.530l-0.005-0c-1.808 0-1.879 1.132-1.879 1.426 0 1.54 4.049 2.143 4.049 5.785 0.014 0.128 0.021 0.277 0.021 0.427 0 2.359-1.912 4.271-4.271 4.271-0.002 0-0.005 0-0.007 0h0c-0.050 0.002-0.108 0.002-0.166 0.002-1.676 0-3.187-0.703-4.255-1.830l-0.003-0.003 0.807-2.607c0.774 0.68 1.745 1.154 2.817 1.328l0.033 0.004c0.012 0 0.025 0.001 0.039 0.001 0.646 0 1.171-0.520 1.180-1.165v-0.001c0-2.023-3.317-2.117-3.317-5.447-0-0.020-0-0.044-0-0.068 0-3.026 2.453-5.478 5.478-5.478 0.195 0 0.388 0.010 0.578 0.030l-0.024-0.002c0.077-0.004 0.167-0.007 0.258-0.007 0.756 0 1.474 0.169 2.116 0.471l-0.030-0.013-1.181 3.393zM20.170 30.970l9.017-1.951s-3.254-22.010-3.280-22.156c-0.018-0.133-0.128-0.235-0.263-0.240h-0c-0.121 0-2.411-0.170-2.411-0.170s-1.593-1.592-1.798-1.763c-0.043-0.039-0.093-0.070-0.148-0.091l-0.003-0.001-1.142 26.372z" fill="currentColor"/></svg></div>
          <div class="ppim-hh-pills"><span class="ppim-hh-p-busy"><i class="ppim-hh-spin"></i>Connecting</span><span class="ppim-hh-p-done"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Connected</span></div>
          <div class="ppim-hh-srct">Shopify stores</div><div class="ppim-hh-srcsub">US, EU and B2B</div>
        </div>
        <div class="ppim-hh-srccard is-multi">
          <div class="ppim-hh-tile" style="background:#EEF7F1;color:#0F6E56"><svg width="17" height="17" viewBox="0 0 18 18" fill="none"><rect x="2.5" y="2.5" width="13" height="13" rx="2" stroke="currentColor" stroke-width="1.4"/><path d="M2.5 7h13M2.5 11h13M7 2.5v13" stroke="currentColor" stroke-width="1.2"/></svg></div>
          <div class="ppim-hh-pills"><span class="ppim-hh-p-busy"><i class="ppim-hh-spin"></i>Connecting</span><span class="ppim-hh-p-done"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Connected</span></div>
          <div class="ppim-hh-srct">Spreadsheets</div><div class="ppim-hh-srcsub">4 supplier files</div>
        </div>
        <div class="ppim-hh-srccard">
          <div class="ppim-hh-tile" style="background:#F1EFEA;color:#4A4A47"><svg width="17" height="17" viewBox="0 0 18 18" fill="none"><ellipse cx="9" cy="4.5" rx="5.5" ry="2" stroke="currentColor" stroke-width="1.4"/><path d="M3.5 4.5v9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2v-9M3.5 9c0 1.1 2.5 2 5.5 2s5.5-.9 5.5-2" stroke="currentColor" stroke-width="1.4"/></svg></div>
          <div class="ppim-hh-pills"><span class="ppim-hh-p-busy"><i class="ppim-hh-spin"></i>Connecting</span><span class="ppim-hh-p-done"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Connected</span></div>
          <div class="ppim-hh-srct">ERP</div><div class="ppim-hh-srcsub">SKUs and prices</div>
        </div>
      </div>
      <div class="ppim-hh-hub">
        <div class="ppim-hh-hubmark"><svg viewBox="511 481 556 425" width="44" height="44" style="flex-shrink:0"><path fill-rule="nonzero" fill="#F2F3F5" d="M 713.535156 751.597656 L 860.074219 634.671875 L 826.027344 721.976562 L 1066.578125 905.730469 L 789.171875 481.910156 L 511.765625 905.730469 L 713.535156 751.597656 Z"/></svg></div>
        <div class="ppim-hh-count"><span class="ppim-hh-count-n">0</span> products</div>
        <div class="ppim-hh-hubsub">0 sources connected</div>
      </div>
    </div>

    <!-- SCENE 2: complete, translate and publish inside Peak PIM -->
    <div class="ppim-hh-scene" data-scene="2">
      <div class="ppim-hh-pim">
        <div class="ppim-hh-banner"><svg viewBox="511 481 556 425" width="14" height="14" style="flex-shrink:0"><path fill-rule="nonzero" fill="#F2F3F5" d="M 713.535156 751.597656 L 860.074219 634.671875 L 826.027344 721.976562 L 1066.578125 905.730469 L 789.171875 481.910156 L 511.765625 905.730469 L 713.535156 751.597656 Z"/></svg><span class="ppim-hh-brand">Peak PIM</span><span class="ppim-hh-bsep">·</span><span class="ppim-hh-bsub">Products</span></div>
        <div class="ppim-hh-head">
          <div class="ppim-hh-thumb"></div>
          <div class="ppim-hh-hinfo"><div class="ppim-hh-pname">PEAKPRO FREERIDE X RED</div><div class="ppim-hh-pmeta">SKU PP-FRX-RED</div></div>
          <div class="ppim-hh-ring">
            <svg viewBox="0 0 56 56" width="56" height="56"><circle cx="28" cy="28" r="23" fill="none" stroke="#EEEAE0" stroke-width="5"/><circle class="ppim-hh-ring-p" cx="28" cy="28" r="23" fill="none" stroke="#2845D6" stroke-width="5" stroke-linecap="round" transform="rotate(-90 28 28)"/></svg>
            <span class="ppim-hh-ring-n">64%</span>
          </div>
        </div>
        <div class="ppim-hh-tools">
          <div class="ppim-hh-seg"><span class="ppim-hh-segb is-active" data-tab="us"><span class="ppim-hh-flag" style="background:#1A2CA3;width:14px;height:14px">US</span><b class="ppim-hh-segn">Heritage</b></span><span class="ppim-hh-segb" data-tab="eu"><span class="ppim-hh-flag" style="background:#534AB7;width:14px;height:14px">EU</span><b class="ppim-hh-segn">Sommet</b></span><span class="ppim-hh-segb" data-tab="b2b"><span class="ppim-hh-flag" style="background:#4A4A47;width:14px;height:14px">US</span><b class="ppim-hh-segn">Heritage B2B</b></span></div>
          <div class="ppim-hh-tr"><i class="ppim-hh-spin"></i><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg><span class="ppim-hh-tr-t">Fill from Heritage</span></div>
        </div>
        <div class="ppim-hh-fwrap">
          <div class="ppim-hh-fields">
            <div class="ppim-hh-row" data-row="title">
              <div class="ppim-hh-label">Title</div>
              <div class="ppim-hh-input"><span class="ppim-hh-v"></span><span class="ppim-hh-ph">Empty</span><span class="ppim-hh-caret"></span><span class="ppim-hh-gen"><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg><b>Generating</b></span></div>
              <div class="ppim-hh-st"><span class="ppim-hh-st-flag"><svg width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="5" fill="#C98A1E"/><rect x="4.4" y="2.2" width="1.2" height="3.6" rx=".6" fill="#fff"/><circle cx="5" cy="7.4" r=".7" fill="#fff"/></svg><em></em></span><span class="ppim-hh-st-ok"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Complete</span><span class="ppim-hh-st-ai"><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg><em></em></span></div>
            </div>
            <div class="ppim-hh-row" data-row="media">
              <div class="ppim-hh-label">Media</div>
              <div class="ppim-hh-input ppim-hh-mono"><span class="ppim-hh-mthumb"></span><span class="ppim-hh-v"></span><span class="ppim-hh-ph">Empty</span><span class="ppim-hh-caret"></span><span class="ppim-hh-gen"><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg><b>Generating</b></span><span class="ppim-hh-aibtn"><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg></span></div>
              <div class="ppim-hh-st"><span class="ppim-hh-st-flag"><svg width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="5" fill="#C98A1E"/><rect x="4.4" y="2.2" width="1.2" height="3.6" rx=".6" fill="#fff"/><circle cx="5" cy="7.4" r=".7" fill="#fff"/></svg><em></em></span><span class="ppim-hh-st-ok"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Complete</span><span class="ppim-hh-st-ai"><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg><em></em></span></div>
            </div>
            <div class="ppim-hh-row" data-row="lens">
              <div class="ppim-hh-label">Lens<span class="ppim-hh-chip">metafield</span></div>
              <div class="ppim-hh-input"><span class="ppim-hh-v"></span><span class="ppim-hh-ph">Empty</span><span class="ppim-hh-caret"></span><span class="ppim-hh-gen"><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg><b>Generating</b></span></div>
              <div class="ppim-hh-st"><span class="ppim-hh-st-flag"><svg width="10" height="10" viewBox="0 0 10 10"><circle cx="5" cy="5" r="5" fill="#C98A1E"/><rect x="4.4" y="2.2" width="1.2" height="3.6" rx=".6" fill="#fff"/><circle cx="5" cy="7.4" r=".7" fill="#fff"/></svg><em></em></span><span class="ppim-hh-st-ok"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Complete</span><span class="ppim-hh-st-ai"><svg width="11" height="11" viewBox="0 0 12 12"><path d="M6 .6 7.4 4.6 11.4 6 7.4 7.4 6 11.4 4.6 7.4 .6 6 4.6 4.6Z" fill="currentColor"/></svg><em></em></span></div>
            </div>
          </div>
          <div class="ppim-hh-empty">
            <div class="ppim-hh-empty-t"><span class="ppim-hh-flag" style="background:#534AB7;width:16px;height:16px">EU</span>This product isn't in Sommet yet</div>
            <div class="ppim-hh-create"><svg width="10" height="10" viewBox="0 0 10 10"><path d="M5 1v8M1 5h8" stroke="currentColor" stroke-width="1.6" stroke-linecap="round"/></svg>Create product for this store</div>
          </div>
        </div>
        <div class="ppim-hh-foot">
          <div class="ppim-hh-fstores"><i style="background:#2845D6"></i><i style="background:#534AB7"></i><i style="background:#4A4A47"></i><span>3 Shopify stores</span></div>
          <div class="ppim-hh-btn is-disabled"><i class="ppim-hh-spin ppim-hh-spin-w"></i><span class="ppim-hh-btn-t">Publish to 3 stores</span></div>
        </div>
      </div>
    </div>

    <!-- SCENE 3: Shopify stores update -->
    <div class="ppim-hh-scene" data-scene="3">
      <svg class="ppim-hh-lines" aria-hidden="true"><path class="ppim-hh-path"/><path class="ppim-hh-path"/><path class="ppim-hh-path"/><g class="ppim-hh-dots"></g></svg>
      <div class="ppim-hh-node"><svg viewBox="511 481 556 425" width="15" height="15" style="flex-shrink:0"><path fill-rule="nonzero" fill="#F2F3F5" d="M 713.535156 751.597656 L 860.074219 634.671875 L 826.027344 721.976562 L 1066.578125 905.730469 L 789.171875 481.910156 L 511.765625 905.730469 L 713.535156 751.597656 Z"/></svg><span class="ppim-hh-node-b">Peak PIM</span><span class="ppim-hh-node-s"><span class="ppim-hh-node-busy"><i class="ppim-hh-spin ppim-hh-spin-w"></i>Publishing to 3 stores</span><span class="ppim-hh-node-done"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>Published to 3 stores</span></span></div>
      <div class="ppim-hh-stores">
        <div class="ppim-hh-store" data-store="us">
          <div class="ppim-hh-shead" style="background:linear-gradient(135deg,#1A2CA3 0%,#2845D6 100%)"><svg width="12" height="12" viewBox="0 0 32 32" fill="none" style="color:rgba(255,255,255,0.95);flex-shrink:0"><path d="M20.919 4.546c-0.025 0-0.075 0.026-0.097 0.026s-0.361 0.094-0.892 0.262c-0.529-1.541-1.47-2.962-3.134-2.962h-0.144c-0.356-0.5-0.921-0.832-1.564-0.868l-0.005-0c-3.881 0-5.736 4.845-6.317 7.305-1.492 0.456-2.578 0.795-2.699 0.842-0.844 0.266-0.867 0.29-0.965 1.087-0.094 0.577-2.287 17.574-2.287 17.574l16.946 3.183zM17.18 2.935c0.867 0.092 1.426 1.083 1.786 2.193-0.436 0.142-0.919 0.289-1.447 0.457v-0.315c0.001-0.049 0.002-0.107 0.002-0.165 0-0.777-0.125-1.524-0.355-2.224l0.014 0.050zM16.506 5.727v0.169c-0.942 0.29-1.978 0.605-2.992 0.92 0.264-1.607 1.237-2.944 2.58-3.699l0.026-0.013c0.248 0.705 0.391 1.518 0.391 2.365 0 0.091-0.002 0.182-0.005 0.273l0-0.013zM14.963 2.042c0 0 0.001 0 0.001 0 0.19 0 0.366 0.063 0.507 0.17l-0.002-0.002c-1.749 1.048-2.947 2.861-3.132 4.964l-0.002 0.024c-0.82 0.266-1.616 0.506-2.361 0.722 0.648-2.231 2.216-5.867 4.988-5.867zM15.638 15.132c-0.648-0.32-1.408-0.514-2.211-0.530l-0.005-0c-1.808 0-1.879 1.132-1.879 1.426 0 1.54 4.049 2.143 4.049 5.785 0.014 0.128 0.021 0.277 0.021 0.427 0 2.359-1.912 4.271-4.271 4.271-0.002 0-0.005 0-0.007 0h0c-0.050 0.002-0.108 0.002-0.166 0.002-1.676 0-3.187-0.703-4.255-1.830l-0.003-0.003 0.807-2.607c0.774 0.68 1.745 1.154 2.817 1.328l0.033 0.004c0.012 0 0.025 0.001 0.039 0.001 0.646 0 1.171-0.520 1.180-1.165v-0.001c0-2.023-3.317-2.117-3.317-5.447-0-0.020-0-0.044-0-0.068 0-3.026 2.453-5.478 5.478-5.478 0.195 0 0.388 0.010 0.578 0.030l-0.024-0.002c0.077-0.004 0.167-0.007 0.258-0.007 0.756 0 1.474 0.169 2.116 0.471l-0.030-0.013-1.181 3.393zM20.170 30.970l9.017-1.951s-3.254-22.010-3.280-22.156c-0.018-0.133-0.128-0.235-0.263-0.240h-0c-0.121 0-2.411-0.170-2.411-0.170s-1.593-1.592-1.798-1.763c-0.043-0.039-0.093-0.070-0.148-0.091l-0.003-0.001-1.142 26.372z" fill="currentColor"/></svg><div class="ppim-hh-sname">Heritage<span>heritage.com</span></div></div>
          <div class="ppim-hh-sphoto"><div class="ppim-hh-simgfill"></div><div class="ppim-hh-newlbl">Not on this store yet</div></div>
          <div class="ppim-hh-sbody">
            <div class="ppim-hh-bskel"><i style="width:78%"></i><i style="width:52%"></i><i style="width:34%;margin-top:14px"></i></div>
            <div class="ppim-hh-stitle"><span class="ppim-hh-stitle-t">PEAKPRO FREERIDE X RED</span></div>
            <div class="ppim-hh-sdesc"><span class="ppim-hh-skel"></span><span class="ppim-hh-sdesc-t">Mirrored red, VLT 18%</span></div>
            <div class="ppim-hh-sfoot"><div class="ppim-hh-price">$189.00</div>
              <div class="ppim-hh-sst"><span class="ppim-hh-sst-busy"><i class="ppim-hh-spin"></i>syncing</span><span class="ppim-hh-sst-done"><svg width="10" height="10" viewBox="0 0 9 9"><circle cx="4.5" cy="4.5" r="4.5" fill="#1D9E75"/><path d="M2.5 4.5 L4 6 L6.5 3" stroke="white" stroke-width="1.2" fill="none" stroke-linecap="round"/></svg>updated</span></div>
            </div>
          </div>
