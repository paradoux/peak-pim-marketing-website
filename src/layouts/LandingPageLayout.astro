---
import CrispChat from "../components/CrispChat.astro";
import GlobalWebflowStyles from "../components/GlobalWebflowStyles.astro";
import LeadCaptureModal from "../components/LeadCaptureModal.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { assets } from "../data/assets";
import { canonicalUrl as getCanonicalUrl } from "../lib/site-url";
import "../styles/global.css";

type Props = {
  title: string;
  description: string;
  canonicalPath: string;
  noindex?: boolean;
  schemaType?: "WebPage" | "SoftwareApplication" | "Article";
  schema?: Record<string, unknown>;
  additionalSchemas?: Record<string, unknown>[];
  ogTitle?: string;
  ogDescription?: string;
  ogImage?: string;
};

const {
  title,
  description,
  canonicalPath,
  noindex = false,
  schemaType = "WebPage",
  schema = {},
  additionalSchemas = [],
  ogTitle = title,
  ogDescription = description,
  ogImage,
} = Astro.props;
const canonicalUrl = getCanonicalUrl(canonicalPath);
const organizationId = "https://peak-pim.com/#organization";
const websiteId = "https://peak-pim.com/#website";
const softwareId = "https://peak-pim.com/#software";
const normalizedCanonicalPath = canonicalPath === "/" ? "/" : `/${canonicalPath.replace(/^\/+|\/+$/g, "")}`;
const registeredFeatureOg = assets.marketing.featureOg[normalizedCanonicalPath as keyof typeof assets.marketing.featureOg];
const resolvedOgImage = ogImage ?? (schemaType === "SoftwareApplication" ? registeredFeatureOg : undefined);
const organization = {
  "@context": "https://schema.org",
  "@type": "Organization",
  "@id": organizationId,
  name: "Peak PIM",
  url: "https://peak-pim.com/",
  logo: {
    "@type": "ImageObject",
    url: "https://peak-pim.com/assets/logo/peak-logo-large.png",
  },
};
const website = {
  "@context": "https://schema.org",
  "@type": "WebSite",
  "@id": websiteId,
  name: "Peak PIM",
  url: "https://peak-pim.com/",
  publisher: { "@id": organizationId },
};
const jsonLd = {
  "@context": "https://schema.org",
  "@type": schemaType === "SoftwareApplication" ? "WebPage" : schemaType,
  "@id": `${canonicalUrl}#webpage`,
  name: title,
  description,
  url: canonicalUrl,
  isPartOf: { "@id": websiteId },
  publisher: { "@id": organizationId },
  ...(schemaType === "SoftwareApplication" ? { about: { "@id": softwareId } } : {}),
  ...schema,
};
const softwareApplication = {
  "@context": "https://schema.org",
  "@type": "SoftwareApplication",
  "@id": softwareId,
  name: "Peak PIM",
  description: "A Shopify-native product information management platform for managing, enriching, and publishing product catalogs across connected stores.",
  url: "https://peak-pim.com/",
  applicationCategory: "BusinessApplication",
  applicationSubCategory: "Product Information Management",
  operatingSystem: "Web",
  publisher: { "@id": organizationId },
  offers: [
    {
      "@type": "Offer",
      name: "Core",
      price: "99",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: "https://peak-pim.com/pricing/",
    },
    {
      "@type": "Offer",
      name: "Elite",
      price: "249",
      priceCurrency: "USD",
      availability: "https://schema.org/InStock",
      url: "https://peak-pim.com/pricing/",
    },
  ],
};
const structuredData = [
  organization,
  website,
  jsonLd,
  ...(schemaType === "SoftwareApplication" ? [softwareApplication] : []),
  ...additionalSchemas,
];
const ogImageUrl = resolvedOgImage ? new URL(resolvedOgImage, "https://peak-pim.com").toString() : undefined;
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonicalUrl} />
    <meta property="og:type" content={schemaType === "Article" ? "article" : "website"} />
    <meta property="og:site_name" content="Peak PIM" />
    <meta property="og:locale" content="en_US" />
    <meta property="og:title" content={ogTitle} />
    <meta property="og:description" content={ogDescription} />
    <meta property="og:url" content={canonicalUrl} />
    {ogImageUrl && <meta property="og:image" content={ogImageUrl} />}
    {ogImageUrl && <meta property="og:image:width" content="1200" />}
    {ogImageUrl && <meta property="og:image:height" content="630" />}
    {ogImageUrl && <meta property="og:image:alt" content={`${ogTitle} | Peak PIM`} />}
    <meta name="twitter:card" content={ogImageUrl ? "summary_large_image" : "summary"} />
    <meta name="twitter:title" content={ogTitle} />
    <meta name="twitter:description" content={ogDescription} />
    {ogImageUrl && <meta name="twitter:image" content={ogImageUrl} />}
    {ogImageUrl && <meta name="twitter:image:alt" content={`${ogTitle} | Peak PIM`} />}
    {noindex && <meta name="robots" content="noindex,nofollow" />}
    <link rel="icon" href="/assets/logo/favicon-peak-pim.png" />
    <link rel="apple-touch-icon" href="/assets/logo/peak-webclip.png" />
    <link rel="preload" href="/mirror/fonts/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw-4ecc7e89b7.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/mirror/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7-6ab57b19c6.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/mirror/local-fonts.css" rel="stylesheet" />
    <link href="/mirror/peak-pim-landing.webflow.shared.c3ebbebc2-825ab19cb5.css" rel="stylesheet" />
    {structuredData.map((entry) => <script type="application/ld+json" set:html={JSON.stringify(entry)} />)}
  </head>
  <body>
    <div class="page-wrapper site-page">
      <GlobalWebflowStyles />
      <SiteHeader />
      <main class="main-wrapper"><slot /></main>
      <SiteFooter />
      <LeadCaptureModal />
      <CrispChat />
    </div>
    <script is:inline>
      function setupFaqAccordions() {
        const questions = Array.from(document.querySelectorAll(".faq1_question"));

        questions.forEach((question) => {
          if (question.dataset.faqReady === "true") return;
          const item = question.closest(".faq1_accordion");
          const answer = item && item.querySelector(".faq1_answer");
          const icon = question.querySelector(".faq1_icon-wrapper");
          if (!answer) return;

          question.dataset.faqReady = "true";
          answer.style.overflow = "hidden";
          answer.style.height = "0px";

          function setOpen(open) {
            question.setAttribute("aria-expanded", String(open));
            answer.style.height = open ? `${answer.scrollHeight}px` : "0px";
            if (icon) icon.style.transform = open ? "rotate(180deg)" : "";
          }

          function toggle() {
            setOpen(question.getAttribute("aria-expanded") !== "true");
          }

          question.addEventListener("click", toggle);
          question.addEventListener("keydown", (event) => {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              toggle();
            }
          });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", setupFaqAccordions);
      } else {
        setupFaqAccordions();
      }
    </script>
  </body>
</html>
