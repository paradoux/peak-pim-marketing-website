---
import CrispChat from "../components/CrispChat.astro";
import CustomerStoryHero from "../components/sections/CustomerStoryHero.astro";
import SocialProofStats from "../components/sections/SocialProofStats.astro";
import GlobalWebflowStyles from "../components/GlobalWebflowStyles.astro";
import LeadCaptureModal from "../components/LeadCaptureModal.astro";
import SiteFooter from "../components/SiteFooter.astro";
import SiteHeader from "../components/SiteHeader.astro";
import { assets } from "../data/assets";
import { ctaExceptions } from "../data/cta-copy";
import type { PageDefinition } from "../data/pages";
import { defaultLocale, getLocaleAlternates, getRoutePath, localeMetadata } from "../i18n/config";
import { accountSocialProofLogos, accountSocialProofStats, accountSocialProofTitle } from "../data/social-proof";
import { canonicalUrl as getCanonicalUrl } from "../lib/site-url";
import "../styles/global.css";

type Props = {
  page: PageDefinition;
  headHtml: string;
  mainHtml: string;
  htmlClass?: string;
  wfPage?: string;
  wfSite?: string;
};

const { page, headHtml, mainHtml, htmlClass, wfPage, wfSite } = Astro.props;
const locale = Astro.locals.locale ?? defaultLocale;
const sourcePath = page.slug ? `/${page.slug}` : "/";
const canonicalPath = getRoutePath(sourcePath, locale) ?? sourcePath;
const canonicalUrl = getCanonicalUrl(canonicalPath);
const localeAlternates = getLocaleAlternates(canonicalPath);
const defaultAlternate = localeAlternates.find((alternate) => alternate.locale === defaultLocale);
const homepagePricingMarker = '<section class="section_pricing2 color-scheme-1">';
const homepagePricingIndex = page.slug === "" ? mainHtml.indexOf(homepagePricingMarker) : -1;
const homepageCtaMarker = '<section class="section_cta51 color-scheme-1">';
const homepageCtaIndex = page.slug === "" ? mainHtml.indexOf(homepageCtaMarker) : -1;
const pricingFaqMarker = '<section class="section_faq1 color-scheme-1">';
const pricingFaqIndex = page.slug === "pricing" ? mainHtml.indexOf(pricingFaqMarker) : -1;
const supportingProofMarkers: Record<string, string> = {
  "shopify-multi-store-pim": '<section class="section_pricing29 color-scheme-1">',
  "industry/fashion": '<section class="section_layout121 section_layout121-2 color-scheme-1">',
};
const supportingProofMarker = supportingProofMarkers[page.slug];
const supportingProofIndex = supportingProofMarker ? mainHtml.indexOf(supportingProofMarker) : -1;

if (page.slug === "" && (homepagePricingIndex === -1 || homepageCtaIndex === -1 || homepagePricingIndex >= homepageCtaIndex)) {
  throw new Error("The homepage proof sections could not be placed around pricing.");
}

if (page.slug === "pricing" && pricingFaqIndex === -1) {
  throw new Error("The pricing social proof could not be placed before the FAQ.");
}

if (supportingProofMarker && supportingProofIndex === -1) {
  throw new Error(`The ${page.slug} social proof could not be placed at its approved conversion point.`);
}

const homepageMainBeforeProof = homepagePricingIndex >= 0 ? mainHtml.slice(0, homepagePricingIndex) : mainHtml;
const homepageMainBetweenProofAndStory = homepagePricingIndex >= 0 && homepageCtaIndex >= 0 ? mainHtml.slice(homepagePricingIndex, homepageCtaIndex) : "";
const homepageMainAfterStory = homepageCtaIndex >= 0 ? mainHtml.slice(homepageCtaIndex) : "";
const pricingMainBeforeProof = pricingFaqIndex >= 0 ? mainHtml.slice(0, pricingFaqIndex) : mainHtml;
const pricingMainAfterProof = pricingFaqIndex >= 0 ? mainHtml.slice(pricingFaqIndex) : "";
const supportingMainBeforeProof = supportingProofIndex >= 0 ? mainHtml.slice(0, supportingProofIndex) : mainHtml;
const supportingMainAfterProof = supportingProofIndex >= 0 ? mainHtml.slice(supportingProofIndex) : "";
const hasMetaDescription = /<meta\b(?=[^>]*\bname=["']description["'])/i.test(headHtml);
const hasJsonLd = /<script\b(?=[^>]*\btype=["']application\/ld\+json["'])/i.test(headHtml);
const fallbackJsonLd = {
  "@context": "https://schema.org",
  "@type": "WebPage",
  name: page.title,
  description: page.description,
  url: canonicalUrl,
  inLanguage: locale,
  isPartOf: {
    "@type": "WebSite",
    name: "Peak PIM",
    url: "https://peak-pim.com/",
  },
  publisher: {
    "@type": "Organization",
    name: "Peak PIM",
    url: "https://peak-pim.com/",
    logo: "https://peak-pim.com/assets/logo/peak-logo-large.png",
  },
};
---

<!doctype html>
<html
  lang={localeMetadata[locale].hreflang}
  data-wf-domain="peak-pim.com"
  data-wf-page={wfPage}
  data-wf-site={wfSite}
  class={htmlClass}
>
  <head>
    <Fragment set:html={headHtml} />
    {!hasMetaDescription && page.description && <meta name="description" content={page.description} />}
    <link rel="canonical" href={canonicalUrl} />
    {localeAlternates.map((alternate) => <link rel="alternate" hreflang={alternate.hreflang} href={alternate.url} />)}
    {defaultAlternate && <link rel="alternate" hreflang="x-default" href={defaultAlternate.url} />}
    <meta property="og:locale" content={localeMetadata[locale].ogLocale} />
    {!hasJsonLd && <script type="application/ld+json" set:html={JSON.stringify(fallbackJsonLd)} />}
    <link rel="preload" href="/mirror/fonts/V8mDoQDjQSkFtoMM3T6r8E7mPbF4Cw-4ecc7e89b7.woff2" as="font" type="font/woff2" crossorigin />
    <link rel="preload" href="/mirror/fonts/UcC73FwrK3iLTeHuS_nVMrMxCp50SjIa1ZL7-6ab57b19c6.woff2" as="font" type="font/woff2" crossorigin />
    <link href="/mirror/local-fonts.css" rel="stylesheet" type="text/css" />
    <meta name="peak-page-slug" content={page.slug || "home"} />
  </head>
  <body>
    <div class="page-wrapper site-page">
      <GlobalWebflowStyles />
      <SiteHeader locale={locale} />
      <div class="site-main">
        {page.slug === "" ? (
          <>
            <Fragment set:html={homepageMainBeforeProof} />
            <SocialProofStats
              title={accountSocialProofTitle}
              stats={accountSocialProofStats}
              logos={accountSocialProofLogos}
            />
            <Fragment set:html={homepageMainBetweenProofAndStory} />
            <CustomerStoryHero
              eyebrow="Customer story"
              title="How Maéli Paris gets hours back every week"
              description="Maéli Paris schedules weekly fabric Drops ahead of time and maintains one multilingual catalog, opening new markets without adding more weekend work."
              image={assets.testimonials.amelieSamsonMaeliParis}
              imageAlt="Amélie Samson, founder of Maéli Paris, holding her book about creative sewing and textile upcycling"
              imageCaption="Amélie Samson, founder of Maéli Paris"
              companyLogo={assets.customerLogos.light.maeli}
              companyName="Maéli Paris"
              primaryCta={{ label: ctaExceptions.seeUseCase, href: "/customers/maeli-paris/" }}
              headingLevel="h2"
            />
            <Fragment set:html={homepageMainAfterStory} />
          </>
        ) : page.slug === "pricing" ? (
          <>
            <Fragment set:html={pricingMainBeforeProof} />
            <SocialProofStats
              title={accountSocialProofTitle}
              stats={accountSocialProofStats}
              logos={accountSocialProofLogos}
            />
            <Fragment set:html={pricingMainAfterProof} />
          </>
        ) : supportingProofIndex >= 0 ? (
          <>
            <Fragment set:html={supportingMainBeforeProof} />
            <SocialProofStats
              title={accountSocialProofTitle}
              stats={accountSocialProofStats}
              logos={accountSocialProofLogos}
            />
            <Fragment set:html={supportingMainAfterProof} />
          </>
        ) : (
          <Fragment set:html={mainHtml} />
        )}
      </div>
      <SiteFooter locale={locale} currentPath={canonicalPath} />
      {locale === defaultLocale && <LeadCaptureModal />}
      <CrispChat />
    </div>
    <script is:inline>
      function setupFaqAccordions() {
        const questions = Array.from(document.querySelectorAll(".faq1_question"));

        questions.forEach((question) => {
          if (question.dataset.faqReady === "true") {
            return;
          }

          const item = question.closest(".faq1_accordion");
          const answer = item && item.querySelector(".faq1_answer");
          const icon = question.querySelector(".faq1_icon-wrapper");

          if (!answer) {
            return;
          }

          question.dataset.faqReady = "true";
          question.setAttribute("role", "button");
          question.setAttribute("tabindex", question.getAttribute("tabindex") || "0");
          question.setAttribute("aria-expanded", "false");
          answer.style.overflow = "hidden";
          answer.style.height = "0px";

          function setOpen(open) {
            question.setAttribute("aria-expanded", String(open));
            answer.style.height = open ? `${answer.scrollHeight}px` : "0px";

            if (icon) {
              icon.style.transform = open ? "rotate(180deg)" : "";
            }
          }

          function toggle() {
            setOpen(question.getAttribute("aria-expanded") !== "true");
          }

          question.addEventListener("click", toggle);
          question.addEventListener("keydown", function(event) {
            if (event.key === "Enter" || event.key === " ") {
              event.preventDefault();
              toggle();
            }
          });
        });

        window.addEventListener("resize", function() {
          questions.forEach((question) => {
            if (question.getAttribute("aria-expanded") !== "true") {
              return;
            }

            const item = question.closest(".faq1_accordion");
            const answer = item && item.querySelector(".faq1_answer");

            if (answer) {
              answer.style.height = `${answer.scrollHeight}px`;
            }
          });
        });
      }

      function setupTimelineProgress() {
        const timelines = Array.from(document.querySelectorAll(".layout121_timeline-wrapper"));

        if (!timelines.length) {
          return;
        }

        let ticking = false;

        function clamp(value) {
          return Math.max(0, Math.min(1, value));
        }

        function update() {
          const viewportHeight = window.innerHeight || document.documentElement.clientHeight;

          timelines.forEach((timeline) => {
            const bar = timeline.querySelector(".layout121_progress-bar");
            const track = timeline.querySelector(".layout121_progress-bar-wrapper");

            if (!bar || !track) {
              return;
            }

            const rect = track.getBoundingClientRect();
            const start = viewportHeight * 0.72;
            const end = viewportHeight * 0.34;
            const distance = rect.height + start - end;
            const progress = distance > 0 ? clamp((start - rect.top) / distance) : 0;

            bar.style.height = `${progress * 100}%`;
          });

          ticking = false;
        }

        function requestUpdate() {
          if (ticking) {
            return;
          }

          ticking = true;
          window.requestAnimationFrame(update);
        }

        update();
        window.addEventListener("scroll", requestUpdate, { passive: true });
        window.addEventListener("resize", requestUpdate);
      }

      function setupPricingBilling() {
        const billingButtons = Array.from(document.querySelectorAll("[data-billing-toggle]"));

        if (!billingButtons.length) {
          return;
        }

        function setBilling(mode) {
          billingButtons.forEach((button) => {
            const isActive = button.getAttribute("data-billing-toggle") === mode;
            button.classList.toggle("is-active", isActive);
            button.setAttribute("aria-pressed", isActive ? "true" : "false");
          });

          Array.from(document.querySelectorAll("[data-pricing-price], [data-pricing-unit], [data-pricing-billing]")).forEach(
            (element) => {
              const nextValue = element.getAttribute(`data-${mode}`);

              if (nextValue) {
                element.textContent = nextValue;
              }
            },
          );
        }

        billingButtons.forEach((button) => {
          if (button.dataset.billingReady === "true") {
            return;
          }

          button.dataset.billingReady = "true";
          button.addEventListener("click", () => {
            setBilling(button.getAttribute("data-billing-toggle") || "monthly");
          });
        });

        setBilling("monthly");
      }

      function setupPricingFeatureInfo() {
        const disclosures = Array.from(document.querySelectorAll(".pricing-feature-info"));

        disclosures.forEach((disclosure) => {
          if (disclosure.dataset.pricingInfoReady === "true") {
            return;
          }

          const summary = disclosure.querySelector("summary");
          let closeTimer;

          disclosure.dataset.pricingInfoReady = "true";

          function closeOthers() {
            disclosures.forEach((other) => {
              if (other !== disclosure) {
                other.removeAttribute("open");
              }
            });
          }

          function openFromHover() {
            window.clearTimeout(closeTimer);
            closeOthers();
            disclosure.setAttribute("open", "");
          }

          function closeAfterHover() {
            closeTimer = window.setTimeout(() => {
              if (!disclosure.matches(":focus-within")) {
                disclosure.removeAttribute("open");
              }
            }, 120);
          }

          disclosure.addEventListener("mouseenter", openFromHover);
          disclosure.addEventListener("mouseleave", closeAfterHover);
          disclosure.addEventListener("focusin", () => window.clearTimeout(closeTimer));
          disclosure.addEventListener("toggle", () => {
            if (disclosure.hasAttribute("open")) {
              closeOthers();
            }
          });
          disclosure.addEventListener("keydown", (event) => {
            if (event.key === "Escape") {
              disclosure.removeAttribute("open");
              summary?.focus();
            }
          });
        });
      }

      if (document.readyState === "loading") {
        document.addEventListener("DOMContentLoaded", function() {
          setupFaqAccordions();
          setupTimelineProgress();
          setupPricingBilling();
          setupPricingFeatureInfo();
        });
      } else {
        setupFaqAccordions();
        setupTimelineProgress();
        setupPricingBilling();
        setupPricingFeatureInfo();
      }
    </script>
  </body>
</html>
